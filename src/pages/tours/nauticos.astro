---
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import Layout from "../../layouts/Layout.astro";
import DestinationModal from "../../components/destination_modal.astro";
import "../../assets/styles/destinations.css";
import { nauticosTours, modalData } from "../../components/data/tours/nauticos_data";
---

<Layout>
    <Navbar />
    <main>
        <!-- Carrusel superior -->
        <div class="nauticos-carousel">
            <div class="carousel-images">
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_2.webp"
                    alt="Tours Náuticos - Velero"
                    class="carousel-img active"
                />
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_3.webp"
                    alt="Tours Náuticos - Moto Acuática"
                    class="carousel-img"
                />
                <img
                    src="/src/assets/photos_azulia_webp/ponton/pontom_1.webp"
                    alt="Tours Náuticos - Pontón"
                    class="carousel-img"
                />
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_5.webp"
                    alt="Tours Náuticos - Snorkel"
                    class="carousel-img"
                />
            </div>
            <div class="carousel-overlay"></div>
            <div class="carousel-content">
                <br />
                <h1 class="carousel-title">Tours</h1>
                <h2 class="carousel-subtitle">Náuticos</h2>
                <p class="carousel-desc">
                    Vive la aventura en el agua con nuestros tours marítimos
                    exclusivos. Explora el Caribe en barcos tradicionales y
                    actividades acuáticas.
                </p>
            </div>
        </div>

        <!-- Cards de Tours Náuticos -->
        <section class="destinations-section">
            <div class="destinations-container">
                <h2 class="destinations-title">Tours Náuticos Disponibles</h2>
                <div class="tours-grid">
                    {
                        nauticosTours.map((tour) => (
                            <div
                                class="carousel-card"
                                data-id={tour.id}
                                role="button"
                                tabindex="0"
                            >
                                <div class="card-image">
                                    <img
                                        src={tour.image.src}
                                        alt={tour.name}
                                        loading="lazy"
                                    />
                                </div>
                                <div class="card-content">
                                    <h3 class="card-title">{tour.name}</h3>
                                    <p class="card-description">
                                        {tour.description}
                                    </p>
                                    <p class="card-price">{tour.schedule}</p>
                                    <button
                                        class="contact-btn"
                                        data-id={tour.id}
                                    >
                                        Ver más
                                    </button>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Modales de Tours -->
        {
            modalData.map((m) => (
                <DestinationModal
                    id={m.id}
                    title={m.title}
                    images={m.images}
                    text={m.text}
                    schedule={m.schedule}
                    price={m.price}
                    rating={m.rating}
                    duration={m.duration}
                    capacity={m.capacity}
                    ageRange={m.ageRange}
                    includes={m.includes}
                    nearby={m.nearby}
                />
            ))
        }
    </main>
    <Footer />
</Layout>

<style>
    * {
        font-family: Arial, Helvetica, sans-serif;
    }
    .nauticos-carousel {
        position: relative;
        width: 100%;
        height: 400px;
        overflow: hidden;
        background: #1a3a52;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .carousel-images {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
    }

    .carousel-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 0.7s;
    }

    .carousel-img.active {
        opacity: 1;
        z-index: 2;
    }

    .carousel-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            rgba(33, 123, 150, 0.55) 0%,
            rgba(26, 58, 82, 0.45) 100%
        );
        z-index: 2;
    }

    .carousel-content {
        position: relative;
        z-index: 3;
        color: #fff;
        text-align: center;
        padding: 2rem;
    }

    .carousel-title {
        font-size: 2rem;
        color: #fff;
        margin-bottom: 0.5rem;
        letter-spacing: 0.05em;
    }

    .carousel-subtitle {
        font-size: 3.5rem;
        color: #fff;
        margin-bottom: 1rem;
        letter-spacing: 0.08em;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
    }

    .carousel-desc {
        font-size: 1.1rem;
        color: #f0f0f0;
        max-width: 600px;
        margin: 0 auto;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.5);
    }

    .tours-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .carousel-card {
        cursor: pointer;
    }

    .contact-btn {
        background-color: #217b96;
        color: #fff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 0.95rem;
        border-radius: 4px;
        cursor: pointer;
        margin-top: 1rem;
        width: 100%;
        transition: background-color 0.3s ease;
    }

    .contact-btn:hover {
        background-color: #1a5f78;
    }

    /* Estilos anteriores mantenidos para referencia */

    @media (max-width: 768px) {
        .carousel-subtitle {
            font-size: 2.5rem;
        }

        .carousel-title {
            font-size: 1.5rem;
        }

        .nauticos-carousel {
            height: 300px;
        }

        .contact-btn {
            padding: 0.8rem 1.5rem;
            font-size: 0.9rem;
        }
    }
</style>

<script>
    const tourCards = document.querySelectorAll(".carousel-card");
    const contactButtons = document.querySelectorAll(".contact-btn");

    // Abrir modal al hacer click en la tarjeta
    tourCards.forEach((card) => {
        const tourId = card.getAttribute("data-id");

        card.addEventListener("click", () => {
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

    });

    // Abrir modal al hacer click en el botón de contacto
    contactButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const tourId = btn.getAttribute("data-id");
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });
    });

    // Cerrar modales al hacer click fuera
    document.addEventListener("click", (e) => {
        const modals = document.querySelectorAll(".dmodal-overlay");
        modals.forEach((modal) => {
            if (e.target === modal) {
                modal.classList.remove("open");
            }
        });
    });

    // Cerrar modales con botón de cerrar
    const closeButtons = document.querySelectorAll(".dmodal-close");
    closeButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const modal = btn.closest(".dmodal-overlay");
            if (modal) {
                modal.classList.remove("open");
            }
        });
    });
</script>
