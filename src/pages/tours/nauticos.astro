---
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import Layout from "../../layouts/Layout.astro";
import DestinationModal from "../../components/destination_modal.astro";
import "../../assets/styles/destinations.css";
import type { ImageMetadata } from "astro";
import velero2 from "../../assets/photos_azulia_webp/velero/velero_2.webp";
import velero3 from "../../assets/photos_azulia_webp/velero/velero_3.webp";
import pontom1 from "../../assets/photos_azulia_webp/ponton/pontom_1.webp";
import pontom2 from "../../assets/photos_azulia_webp/ponton/pontom_2.webp";
import velero4 from "../../assets/photos_azulia_webp/velero/velero_4.webp";
import velero5 from "../../assets/photos_azulia_webp/velero/velero_5.webp";

interface Tour {
    id: string;
    name: string;
    description: string;
    schedule: string;
    image: ImageMetadata;
}

const nauticosTours: Tour[] = [
    {
        id: "velero",
        name: "Velero Tradicional",
        description:
            "Navega en un velero auténtico por las aguas cristalinas del Caribe. Disfruta de vistas panorámicas y la brisa del mar.",
        schedule: "8:00 AM - 1:00 PM",
        image: velero2,
    },
    {
        id: "moto-acuatica",
        name: "Moto Acuática",
        description:
            "Vive la adrenalina con nuestros tours en moto acuática. Explora calas escondidas y playas paradisíacas a alta velocidad.",
        schedule: "10:00 AM - 2:00 PM",
        image: velero3,
    },
    {
        id: "ponton",
        name: "Pontón Familiar",
        description:
            "Paseo relajado en pontón ideal para familias. Perfecto para disfrutar en grupo con baños en agua cristalina.",
        schedule: "9:00 AM - 3:00 PM",
        image: pontom2,
    },
    {
        id: "snorkel",
        name: "Snorkel Subacuático",
        description:
            "Bucea en arrecifes de coral y observa la vida marina tropical. Incluye equipo completo y guía especializado.",
        schedule: "8:00 AM - 12:00 PM",
        image: velero5,
    },
];

const modalData = [
    {
        id: "velero",
        title: "Velero Tradicional",
        images: [velero2.src, velero4.src],
        schedule: "8:00 AM - 1:00 PM",
        price: "$500 MXN",
        text: "Vive la experiencia clásica de navegar en un velero tradicional. Nuestro velero de madera te llevará a través de las aguas más hermosas del Caribe. Incluye snacks, bebidas y toda la seguridad necesaria. Máximo 8 personas por tour.",
        rating: "4.8 de 5.0",
        duration: "5 horas",
        capacity: "8 personas",
        ageRange: "Todas las edades",
        includes: [
            "Snacks",
            "Bebidas",
            "Equipo de seguridad",
            "Chaleco salvavidas",
        ],
        nearby: [
            "Playa Bacalar - 2 km",
            "Fuerte de San Felipe - 8 km",
            "Centro de Bacalar - 3 km",
        ],
    },
    {
        id: "moto-acuatica",
        title: "Moto Acuática",
        images: [velero3.src, velero5.src],
        schedule: "10:00 AM - 2:00 PM",
        price: "$450 MXN",
        text: "Adrenalina pura con nuestros tours en moto acuática última generación. Explora calas secretas y playas paradisíacas a alta velocidad bajo supervisión de instructores certificados. Traje de baño y toalla incluidos.",
        rating: "4.7 de 5.0",
        duration: "4 horas",
        capacity: "2 personas",
        ageRange: "Mayor de 18 años",
        includes: [
            "Moto acuática última generación",
            "Traje de baño",
            "Toalla",
            "Instructor certificado",
        ],
        nearby: [
            "Laguna Bacalar - 1 km",
            "Cenotes cercanos - 15 km",
            "Playas vírgenes - 10 km",
        ],
    },
    {
        id: "ponton",
        title: "Pontón Familiar",
        images: [pontom2.src, pontom1.src],
        schedule: "9:00 AM - 3:00 PM",
        price: "$400 MXN",
        text: "La opción perfecta para familias. Disfruta de un paseo relajado en pontón con plataforma de baño. Incluye refrigerios, bebidas y zona de sombra. Ideal para niños, embarazadas y personas mayores. Capacidad 20 personas.",
        rating: "4.9 de 5.0",
        duration: "6 horas",
        capacity: "20 personas",
        ageRange: "Todas las edades",
        includes: [
            "Refrigerios",
            "Bebidas",
            "Zona de sombra",
            "Plataforma de baño",
            "Flotadores",
        ],
        nearby: [
            "Laguna Bacalar - 0.5 km",
            "Punta Laguna - 5 km",
            "Pueblo mágico Bacalar - 2 km",
        ],
    },
    {
        id: "snorkel",
        title: "Snorkel Subacuático",
        images: [velero5.src, velero2.src],
        schedule: "8:00 AM - 12:00 PM",
        price: "$550 MXN",
        text: "Descubre los arrecifes de coral y la vida marina tropical. Tour guiado por especialistas en snorkel con experiencia en seguridad acuática. Equipo completo, bebidas y snacks incluidos. Profundidad máxima 5 metros.",
        rating: "4.9 de 5.0",
        duration: "4 horas",
        capacity: "12 personas",
        ageRange: "Mayor de 8 años",
        includes: [
            "Equipo de snorkel completo",
            "Guía especializado",
            "Bebidas",
            "Snacks",
            "Chaleco salvavidas",
        ],
        nearby: [
            "Arrecife de coral - 2 km",
            "Isla de pájaros - 5 km",
            "Centro de Bacalar - 3 km",
        ],
    },
];
---

<Layout>
    <Navbar />
    <main>
        <!-- Carrusel superior -->
        <div class="nauticos-carousel">
            <div class="carousel-images">
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_2.webp"
                    alt="Tours Náuticos - Velero"
                    class="carousel-img active"
                />
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_3.webp"
                    alt="Tours Náuticos - Moto Acuática"
                    class="carousel-img"
                />
                <img
                    src="/src/assets/photos_azulia_webp/ponton/pontom_1.webp"
                    alt="Tours Náuticos - Pontón"
                    class="carousel-img"
                />
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_5.webp"
                    alt="Tours Náuticos - Snorkel"
                    class="carousel-img"
                />
            </div>
            <div class="carousel-overlay"></div>
            <div class="carousel-content">
                <br />
                <h1 class="carousel-title">Tours</h1>
                <h2 class="carousel-subtitle">Náuticos</h2>
                <p class="carousel-desc">
                    Vive la aventura en el agua con nuestros tours marítimos
                    exclusivos. Explora el Caribe en barcos tradicionales y
                    actividades acuáticas.
                </p>
            </div>
        </div>

        <!-- Cards de Tours Náuticos -->
        <section class="destinations-section">
            <div class="destinations-container">
                <h2 class="destinations-title">Tours Náuticos Disponibles</h2>
                <div class="tours-grid">
                    {
                        nauticosTours.map((tour) => (
                            <div
                                class="carousel-card"
                                data-id={tour.id}
                                role="button"
                                tabindex="0"
                            >
                                <div class="card-image">
                                    <img
                                        src={tour.image.src}
                                        alt={tour.name}
                                        loading="lazy"
                                    />
                                </div>
                                <div class="card-content">
                                    <h3 class="card-title">{tour.name}</h3>
                                    <p class="card-description">
                                        {tour.description}
                                    </p>
                                    <p class="card-price">{tour.schedule}</p>
                                    <button
                                        class="contact-btn"
                                        data-id={tour.id}
                                    >
                                        Ver más
                                    </button>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Modales de Tours -->
        {
            modalData.map((m) => (
                <DestinationModal
                    id={m.id}
                    title={m.title}
                    images={m.images}
                    text={m.text}
                    schedule={m.schedule}
                    price={m.price}
                    rating={m.rating}
                    duration={m.duration}
                    capacity={m.capacity}
                    ageRange={m.ageRange}
                    includes={m.includes}
                    nearby={m.nearby}
                />
            ))
        }
    </main>
    <Footer />
</Layout>

<style>
    * {
        font-family: Arial, Helvetica, sans-serif;
    }
    .nauticos-carousel {
        position: relative;
        width: 100%;
        height: 400px;
        overflow: hidden;
        background: #1a3a52;
        margin-bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .carousel-images {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
    }

    .carousel-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 0.7s;
    }

    .carousel-img.active {
        opacity: 1;
        z-index: 2;
    }

    .carousel-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            rgba(33, 123, 150, 0.55) 0%,
            rgba(26, 58, 82, 0.45) 100%
        );
        z-index: 2;
    }

    .carousel-content {
        position: relative;
        z-index: 3;
        color: #fff;
        text-align: center;
        padding: 2rem;
    }

    .carousel-title {
        font-size: 2rem;
        color: #fff;
        margin-bottom: 0.5rem;
        letter-spacing: 0.05em;
    }

    .carousel-subtitle {
        font-size: 3.5rem;
        color: #fff;
        margin-bottom: 1rem;
        letter-spacing: 0.08em;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.5);
    }

    .carousel-desc {
        font-size: 1.1rem;
        color: #f0f0f0;
        max-width: 600px;
        margin: 0 auto;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.5);
    }

    .tours-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .carousel-card {
        cursor: pointer;
    }

    .contact-btn {
        background-color: #217b96;
        color: #fff;
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 0.95rem;
        border-radius: 4px;
        cursor: pointer;
        margin-top: 1rem;
        width: 100%;
        transition: background-color 0.3s ease;
    }

    .contact-btn:hover {
        background-color: #1a5f78;
    }

    /* Estilos anteriores mantenidos para referencia */

    @media (max-width: 768px) {
        .carousel-subtitle {
            font-size: 2.5rem;
        }

        .carousel-title {
            font-size: 1.5rem;
        }

        .nauticos-carousel {
            height: 300px;
        }

        .contact-btn {
            padding: 0.8rem 1.5rem;
            font-size: 0.9rem;
        }
    }
</style>

<script>
    const tourCards = document.querySelectorAll(".carousel-card");
    const contactButtons = document.querySelectorAll(".contact-btn");

    // Abrir modal al hacer click en la tarjeta
    tourCards.forEach((card) => {
        const tourId = card.getAttribute("data-id");

        card.addEventListener("click", () => {
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

        // card.addEventListener("keydown", (e) => {
        //     if (e.key === "Enter" || e.key === " ") {
        //         e.preventDefault();
        //         const modal = document.getElementById(`modal-${tourId}`);
        //         if (modal) {
        //             modal.classList.add("open");
        //         }
        //     }
        // });
    });

    // Abrir modal al hacer click en el botón de contacto
    contactButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const tourId = btn.getAttribute("data-id");
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

        // btn.addEventListener("keydown", (e) => {
        //     if (e.key === "Enter" || e.key === " ") {
        //         e.preventDefault();
        //         const tourId = btn.getAttribute("data-id");
        //         const modal = document.getElementById(`modal-${tourId}`);
        //         if (modal) {
        //             modal.classList.add("open");
        //         }
        //     }
        // });
    });

    // Cerrar modales al hacer click fuera
    document.addEventListener("click", (e) => {
        const modals = document.querySelectorAll(".dmodal-overlay");
        modals.forEach((modal) => {
            if (e.target === modal) {
                modal.classList.remove("open");
            }
        });
    });

    // Cerrar modales con botón de cerrar
    const closeButtons = document.querySelectorAll(".dmodal-close");
    closeButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const modal = btn.closest(".dmodal-overlay");
            if (modal) {
                modal.classList.remove("open");
            }
        });
    });
</script>
