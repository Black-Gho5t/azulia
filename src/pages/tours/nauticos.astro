---
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import Layout from "../../layouts/Layout.astro";
import TourListingSection from "../../components/tours_section.astro"
import { nauticosTours, modalData } from "../../components/data/tours/nauticos_data";

const carouselImages = [
    { src: "/src/assets/photos_azulia_webp/velero/velero_2.webp", alt: "Tours Náuticos - Velero" },
    { src: "/src/assets/photos_azulia_webp/velero/velero_3.webp", alt: "Tours Náuticos - Moto Acuática" },
    { src: "/src/assets/photos_azulia_webp/ponton/pontom_1.webp", alt: "Tours Náuticos - Pontón" },
    { src: "/src/assets/photos_azulia_webp/velero/velero_5.webp", alt: "Tours Náuticos - Snorkel" },
];
---

<Layout>
    <Navbar />
    <main>
        <TourListingSection
            carouselImages={carouselImages}
            carouselTitle="Tours"
            carouselSubtitle="Náuticos"
            carouselDescription="Vive la aventura en el agua con nuestros tours marítimos exclusivos. Explora el Caribe en barcos tradicionales y actividades acuáticas."
            sectionTitle="Tours Náuticos Disponibles"
            tours={nauticosTours}
            modals={modalData}
        />
    </main>
    <Footer />
</Layout>