---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Mensajes - Azulia Admin">
  <div class="inbox-page">
    <header class="inbox-header">
      <div>
        <h1 class="inbox-title">Bandeja de Entrada</h1>
        <p class="inbox-subtitle">Mensajes recibidos de clientes</p>
      </div>
      <div class="inbox-filters" id="filterBar">
        <button class="inbox-filter active" data-filter="all">Todos</button>
        <button class="inbox-filter" data-filter="nuevo">Nuevos</button>
        <button class="inbox-filter" data-filter="pendiente">Pendientes</button>
        <button class="inbox-filter" data-filter="leido">Leídos</button>
      </div>
    </header>

    <div class="inbox-list" id="inboxList">
      <div class="inbox-loading">Cargando mensajes...</div>
    </div>
  </div>

  <div id="msgModal" class="modal-overlay" hidden>
    <div class="modal-card">
      <button class="modal-close" id="modalClose"><span class="material-symbols-outlined">close</span></button>
      <h2 class="modal-name" id="modalName"></h2>
      <p class="modal-interests" id="modalInterests"></p>
      <p class="modal-date" id="modalDate"></p>
      <div class="modal-body" id="modalMessage"></div>
      <button class="modal-pendiente-btn" id="modalPendiente">
        <span class="material-symbols-outlined">schedule</span>
        Marcar como pendiente
      </button>
    </div>
  </div>

  <script>
    import { collection, addDoc, query, orderBy, getDocs, doc, updateDoc, deleteDoc, getDoc, Timestamp, serverTimestamp } from 'firebase/firestore';
    import { db } from '../../lib/firebase';

    const statusMeta = {
      nuevo: { label: 'Nuevo', bg: '#eff6ff', border: '#93c5fd', hover: '#dbeafe' },
      pendiente: { label: 'Pendiente', bg: '#fffbeb', border: '#fcd34d', hover: '#fef3c7' },
      leido: { label: 'Leído', bg: '#fff', border: 'transparent', hover: '#f8fafc' },
    };

    let currentFilter = 'all';
    let messages = [];

    function escHtml(s) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    function showError(msg) {
      const list = document.getElementById('inboxList');
      list.innerHTML = `<div class="inbox-empty" style="color:#ef4444;">Error: ${msg}</div>`;
    }

    async function fetchMessages() {
      const q = query(collection(db, 'messages'), orderBy('createdAt', 'desc'));
      const snap = await getDocs(q);
      return snap.docs.map((d) => ({ id: d.id, ...d.data(), createdAt: d.data().createdAt?.toDate?.() ?? null }));
    }

    async function updateMsgStatus(id, status) {
      await updateDoc(doc(db, 'messages', id), { status });
    }

    async function trashMsg(id) {
      const ref = doc(db, 'messages', id);
      const snap = await getDoc(ref);
      if (!snap.exists()) return;
      const data = snap.data();
      const now = Date.now();
      await addDoc(collection(db, 'trash'), {
        type: 'message', originalId: id, data,
        deletedAt: serverTimestamp(),
        expiresAt: new Timestamp(Math.floor(now / 1000) + 30 * 86400, 0),
      });
      await deleteDoc(ref);
    }

    const seedMessages = [
      { name: 'María Fernández', contact: 'maria@ejemplo.com', interests: ['Tours náuticos', 'Hoteles'], message: 'Hola, me interesa conocer los paquetes de tours en velero para 4 personas. ¿Tienen disponibilidad para la próxima semana?', status: 'nuevo' },
      { name: 'Carlos López', contact: '+52 998 123 4567', interests: ['Transportación'], message: 'Buen día, requiero transporte del aeropuerto de Cancún a Bacalar para 3 personas el 15 de agosto. ¿Podrían cotizarme el servicio?', status: 'nuevo' },
      { name: 'Ana Martínez', contact: 'ana.mtz@correo.com', interests: ['Tours', 'Transportación', 'Hoteles'], message: 'Estamos planeando un viaje grupal de 10 personas a Bacalar en septiembre. Nos interesaría un paquete completo que incluya hospedaje, tours y transporte desde Cancún. ¿Manejan descuentos por grupo?', status: 'nuevo' },
      { name: 'Roberto Sánchez', contact: '+52 555 987 6543', interests: ['Tours terrestres'], message: 'Hola, quisiera información sobre el tour a las ruinas de Calakmul. ¿Cuál es la duración? ¿Incluye entrada y guía? Vamos 2 adultos y nos gustaría saber si hay salidas desde Bacalar.', status: 'nuevo' },
      { name: 'Laura Castillo', contact: 'laura.castillo@mail.com', interests: ['Hoteles'], message: 'Muchas gracias por la atención. Ya revisé las opciones de hotel y me decidí por uno. En unos días confirmo la reservación. Quedo atenta a cualquier promoción.', status: 'nuevo' },
      { name: 'Pedro Gómez', contact: '+52 998 111 2233', interests: ['Tours náuticos'], message: 'Excelente experiencia en el tour de paddle board. Todo muy bien organizado y el guía excelente. Definitivamente volveremos. Gracias por todo.', status: 'nuevo' },
    ];

    async function autoSeed() {
      for (const s of seedMessages) {
        await addDoc(collection(db, 'messages'), {
          ...s,
          createdAt: Timestamp.fromDate(new Date(Date.now() - Math.random() * 7 * 86400000)),
        });
      }
    }

    let selectedId = null;

    function closeModal() {
      document.getElementById('msgModal').hidden = true;
      document.body.style.overflow = '';
      selectedId = null;
    }

    function formatDate(d) {
      if (!d) return '—';
      const now = new Date();
      const diff = now - d;
      const sameDay = diff < 86400000 && d.getDate() === now.getDate();
      if (sameDay) return d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      const thisYear = d.getFullYear() === now.getFullYear();
      return d.toLocaleDateString('es-MX', { day: 'numeric', month: thisYear ? 'short' : 'numeric' });
    }

    async function openModal(m) {
      selectedId = m.id;
      document.getElementById('modalName').textContent = m.name;

      const interestsEl = document.getElementById('modalInterests');
      if (m.interests?.length) {
        interestsEl.textContent = m.interests.join(' · ');
        interestsEl.hidden = false;
      } else {
        interestsEl.hidden = true;
      }

      const date = m.createdAt
        ? new Date(m.createdAt).toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })
        : '—';
      document.getElementById('modalDate').textContent = date;
      document.getElementById('modalMessage').textContent = m.message;

      const pendBtn = document.getElementById('modalPendiente');
      pendBtn.hidden = m.status === 'pendiente';
      pendBtn.onclick = async () => {
        await updateMsgStatus(m.id, 'pendiente');
        const msg = messages.find(x => x.id === m.id);
        if (msg) msg.status = 'pendiente';
        pendBtn.hidden = true;
        render();
      };

      document.getElementById('msgModal').hidden = false;
      document.body.style.overflow = 'hidden';

      if (m.status === 'nuevo') {
        await updateMsgStatus(m.id, 'leido');
        m.status = 'leido';
        render();
      }
    }

    function render() {
      const list = document.getElementById('inboxList');
      if (!list) return;
      const filtered = currentFilter === 'all' ? messages : messages.filter(m => m.status === currentFilter);
      if (filtered.length === 0) {
        list.innerHTML = '<div class="inbox-empty">No hay mensajes que mostrar.</div>';
        return;
      }
      list.innerHTML = filtered.map((m) => {
        const meta = statusMeta[m.status] || statusMeta.nuevo;
        const dateStr = formatDate(m.createdAt);
        const preview = m.message.length > 100 ? m.message.slice(0, 100) + '…' : m.message;
        const isLeido = m.status === 'leido';
        return `<div class="inbox-row ${isLeido ? 'inbox-row--leido' : ''}" data-id="${m.id}" style="--row-bg:${meta.bg};--row-border:${meta.border};--row-hover:${meta.hover}">
          <div class="inbox-row-left">
            <div class="inbox-row-name">${escHtml(m.name)}</div>
            <div class="inbox-row-preview">${escHtml(preview)}</div>
          </div>
          <div class="inbox-row-right">
            <div class="inbox-row-contact">${escHtml(m.contact)}</div>
            <div class="inbox-row-date">${escHtml(dateStr)}</div>
          </div>
        </div>`;
      }).join('');
      list.querySelectorAll('.inbox-row').forEach((row) => {
        row.addEventListener('click', () => {
          const msg = messages.find(m => m.id === row.dataset.id);
          if (msg) openModal(msg);
        });
      });
    }

    document.querySelectorAll('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = btn.dataset.filter;
        render();
      });
    });

    document.getElementById('modalClose').addEventListener('click', closeModal);
    document.getElementById('msgModal').addEventListener('click', (e) => {
      if (e.target === e.currentTarget) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });

    (async () => {
      try {
        messages = await fetchMessages();
        if (messages.length === 0) {
          await autoSeed();
          messages = await fetchMessages();
        }
        render();
      } catch (err) {
        showError(err.message || 'Error al cargar mensajes. Verifica la consola (F12).');
        console.error('[Mensajes]', err);
      }
    })();
  </script>

  <style is:global>
    .inbox-page { width: 100%; max-width: 880px; animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    .inbox-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .inbox-title { font-size: 1.5rem; font-weight: 700; color: #fff; margin: 0; }
    .inbox-subtitle { font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0.25rem 0 0; }

    .inbox-filters { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .inbox-filter { padding: 0.45rem 1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.15); background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.7); font-size: 0.82rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; }
    .inbox-filter:hover { background: rgba(255,255,255,0.12); color: #fff; }
    .inbox-filter.active { background: rgba(168,230,247,0.15); border-color: #a8e6f7; color: #a8e6f7; }

    .inbox-list {
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(24px);
      border-radius: 16px;
      border: 1px solid rgba(255,255,255,0.25);
      overflow: hidden;
      box-shadow: 0 4px 24px rgba(0,0,0,0.10), 0 1px 3px rgba(0,0,0,0.06);
    }

    .inbox-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.5rem 1rem 1.75rem;
      cursor: pointer;
      user-select: none;
      background: var(--row-bg);
      border-bottom: 1px solid #e8ecf1;
      transition: background 0.18s ease, box-shadow 0.18s ease;
      position: relative;
    }
    .inbox-row::before {
      content: '';
      position: absolute;
      left: 0; top: 0; bottom: 0;
      width: 5px;
      background: var(--row-border);
    }
    .inbox-row:hover {
      background: var(--row-hover);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.04);
    }
    .inbox-row:last-child { border-bottom: none; }
    .inbox-row:active { transform: scale(0.998); }

    .inbox-row--leido { background: #fff; opacity: 0.7; }
    .inbox-row--leido::before { background: transparent; }
    .inbox-row--leido .inbox-row-name { font-weight: 500; color: #64748b; }
    .inbox-row--leido .inbox-row-preview { color: #a1a1aa; }
    .inbox-row--leido:hover { opacity: 0.85; background: #fafbfc; }

    .inbox-row-left { flex: 1; min-width: 0; }
    .inbox-row-name {
      font-size: 0.95rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.25rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      letter-spacing: -0.01em;
    }
    .inbox-row-preview {
      font-size: 0.84rem;
      color: #64748b;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.45;
    }

    .inbox-row-right {
      flex-shrink: 0;
      text-align: right;
      min-width: 100px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.2rem;
    }
    .inbox-row-contact {
      font-size: 0.78rem;
      color: #64748b;
      white-space: nowrap;
      max-width: 170px;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .inbox-row-date {
      font-size: 0.76rem;
      color: #94a3b8;
      font-weight: 500;
      white-space: nowrap;
    }

    .inbox-loading, .inbox-empty {
      text-align: center;
      padding: 3.5rem 1rem;
      color: #94a3b8;
      font-style: italic;
      font-size: 0.9rem;
    }

    .modal-overlay {
      position: fixed; inset: 0; z-index: 1000;
      background: rgba(10, 26, 47, 0.55); backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center;
      padding: 1.5rem;
    }
    .modal-overlay[hidden] { display: none !important; }

    .modal-card {
      background: #fff; border-radius: 20px;
      max-width: 560px; width: 100%; max-height: 85vh; overflow-y: auto;
      box-shadow: 0 25px 60px rgba(0,0,0,0.3);
      padding: 2rem 2rem 1.5rem;
      position: relative;
    }
    .modal-card::-webkit-scrollbar { width: 6px; }
    .modal-card::-webkit-scrollbar-track { background: transparent; }
    .modal-card::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }

    .modal-close {
      position: absolute; top: 1rem; right: 1rem;
      width: 36px; height: 36px; border-radius: 50%;
      border: none; background: #f1f5f9;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer; color: #64748b; transition: all 0.2s;
    }
    .modal-close:hover { background: #e2e8f0; color: #0a1a2f; }
    .modal-close .material-symbols-outlined { font-size: 1.25rem; }

    .modal-name { font-size: 1.25rem; font-weight: 700; color: #0a1a2f; margin: 0 2rem 0.2rem 0; }
    .modal-interests { font-size: 0.85rem; color: #64748b; margin: 0 0 0.15rem; }
    .modal-date { font-size: 0.8rem; color: #94a3b8; margin: 0 0 1rem; }

    .modal-body {
      background: #f8fafc; border-radius: 12px; padding: 1.25rem;
      font-size: 0.95rem; line-height: 1.7; color: #1e293b;
      margin-bottom: 1.25rem; white-space: pre-wrap; word-break: break-word;
    }

    .modal-pendiente-btn {
      display: inline-flex; align-items: center; gap: 0.4rem;
      padding: 0.6rem 1.25rem; border-radius: 10px;
      border: 1px solid #fde68a; background: #fffbeb;
      font-size: 0.88rem; font-weight: 600; font-family: inherit;
      color: #92400e; cursor: pointer; transition: all 0.15s;
    }
    .modal-pendiente-btn:hover { background: #fef3c7; border-color: #fcd34d; }
    .modal-pendiente-btn .material-symbols-outlined { font-size: 1.15rem; }

    @media (max-width: 768px) {
      .inbox-row { padding: 0.75rem 1rem; gap: 0.75rem; }
      .inbox-row-right { min-width: 60px; }
      .inbox-row-contact { display: none; }
      .modal-card { padding: 1.5rem; margin: 0.5rem; border-radius: 16px; }
    }
  </style>
</AdminLayout>
