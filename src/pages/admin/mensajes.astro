---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Mensajes - Azulia Admin">
  <div class="msg-page">
    <header class="msg-header">
      <div>
        <h1 class="msg-title">Mensajes</h1>
        <p class="msg-subtitle">Bandeja de entrada de clientes</p>
      </div>
      <div class="msg-filters" id="filterBar">
        <button class="msg-filter active" data-filter="all">
          Todos <span class="filter-count" id="countAll">0</span>
        </button>
        <button class="msg-filter" data-filter="nuevo">
          Nuevos <span class="filter-count" id="countNuevo">0</span>
        </button>
        <button class="msg-filter" data-filter="pendiente">
          Pendientes <span class="filter-count" id="countPendiente">0</span>
        </button>
        <button class="msg-filter" data-filter="leido">
          Leídos <span class="filter-count" id="countLeido">0</span>
        </button>
      </div>
    </header>

    <div class="msg-container">
      <!-- Lista de mensajes -->
      <div class="msg-list-panel">
        <div class="msg-list" id="msgList">
          <div class="msg-loading">
            <span class="material-symbols-outlined spinning notranslate" translate="no">sync</span>
            <span>Cargando mensajes...</span>
          </div>
        </div>
      </div>

      <!-- Panel de detalle -->
      <div class="msg-detail-panel" id="detailPanel">
        <div class="msg-detail-empty" id="detailEmpty">
          <span class="material-symbols-outlined notranslate" translate="no" style="font-size: 3rem; color: #cbd5e1;">mail</span>
          <p>Selecciona un mensaje para ver su contenido</p>
        </div>
        <div class="msg-detail-content" id="detailContent" hidden>
          <div class="detail-header">
            <div class="detail-avatar" id="detailAvatar">M</div>
            <div class="detail-header-info">
              <h2 class="detail-name" id="detailName"></h2>
              <span class="detail-status-badge" id="detailBadge"></span>
            </div>
          </div>

          <div class="detail-meta-grid">
            <div class="detail-meta-item" id="metaContact">
              <span class="material-symbols-outlined notranslate" translate="no">contact_mail</span>
              <span id="detailContactText"></span>
            </div>
            <div class="detail-meta-item" id="metaDate">
              <span class="material-symbols-outlined notranslate" translate="no">calendar_today</span>
              <span id="detailDateText"></span>
            </div>
            <div class="detail-meta-item" id="metaReservation" hidden>
              <span class="material-symbols-outlined notranslate" translate="no">event_available</span>
              <span id="detailReservationText"></span>
            </div>
            <div class="detail-meta-item" id="metaInterests" hidden>
              <span class="material-symbols-outlined notranslate" translate="no">interests</span>
              <span id="detailInterestsText"></span>
            </div>
          </div>

          <div class="detail-message-box">
            <p class="detail-message-label">Mensaje</p>
            <div class="detail-message-body" id="detailMessage"></div>
          </div>

          <div class="detail-actions">
            <button class="action-btn action-pending" id="btnPendiente">
              <span class="material-symbols-outlined notranslate" translate="no">schedule</span>
              Marcar pendiente
            </button>
            <button class="action-btn action-read" id="btnLeido">
              <span class="material-symbols-outlined notranslate" translate="no">done_all</span>
              Marcar leído
            </button>
            <button class="action-btn action-trash" id="btnTrash">
              <span class="material-symbols-outlined notranslate" translate="no">delete</span>
              Papelera
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Confirmación modal -->
  <div id="confirmModal" class="confirm-overlay" hidden>
    <div class="confirm-card">
      <span class="material-symbols-outlined notranslate confirm-icon" translate="no">help</span>
      <p class="confirm-msg" id="confirmMsg"></p>
      <div class="confirm-btns">
        <button class="confirm-btn confirm-cancel" id="confirmCancel">Cancelar</button>
        <button class="confirm-btn confirm-ok" id="confirmOk">Aceptar</button>
      </div>
    </div>
  </div>

  <script>
    import { collection, addDoc, query, orderBy, getDocs, doc, updateDoc, deleteDoc, getDoc, Timestamp, serverTimestamp } from 'firebase/firestore';
    import { db } from '../../lib/firebase';

    const statusMeta: Record<string, { label: string; color: string; bg: string }> = {
      nuevo:     { label: 'Nuevo',     color: '#1d4ed8', bg: '#dbeafe' },
      pendiente: { label: 'Pendiente', color: '#92400e', bg: '#fef3c7' },
      leido:     { label: 'Leído',     color: '#64748b', bg: '#f1f5f9' },
    };

    let currentFilter = 'all';
    let messages: any[] = [];
    let selectedId: string | null = null;

    function escHtml(s: string) {
      const d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    async function fetchMessages() {
      const q = query(collection(db, 'messages'), orderBy('createdAt', 'desc'));
      const snap = await getDocs(q);
      return snap.docs.map((d) => {
        const data = d.data();
        let createdAt: Date | null = null;
        if (data.createdAt?.toDate) {
          createdAt = data.createdAt.toDate();
        } else if (typeof data.createdAt === 'string') {
          createdAt = new Date(data.createdAt);
        }
        return { id: d.id, ...data, createdAt };
      });
    }

    async function updateMsgStatus(id: string, status: string) {
      await updateDoc(doc(db, 'messages', id), { status });
    }

    async function trashMsg(id: string) {
      const ref = doc(db, 'messages', id);
      const snap = await getDoc(ref);
      if (!snap.exists()) return;
      const data = snap.data();
      const now = Date.now();
      await addDoc(collection(db, 'trash'), {
        type: 'message', originalId: id, data,
        deletedAt: serverTimestamp(),
        expiresAt: new Timestamp(Math.floor(now / 1000) + 30 * 86400, 0),
      });
      await deleteDoc(ref);
    }

    // --- Confirm dialog ---
    let confirmResolve: ((val: boolean) => void) | null = null;
    function showConfirm(msg: string): Promise<boolean> {
      return new Promise((resolve) => {
        confirmResolve = resolve;
        document.getElementById('confirmMsg')!.textContent = msg;
        document.getElementById('confirmModal')!.hidden = false;
      });
    }
    document.getElementById('confirmOk')!.addEventListener('click', () => {
      document.getElementById('confirmModal')!.hidden = true;
      if (confirmResolve) confirmResolve(true);
    });
    document.getElementById('confirmCancel')!.addEventListener('click', () => {
      document.getElementById('confirmModal')!.hidden = true;
      if (confirmResolve) confirmResolve(false);
    });

    // --- Formatting ---
    function formatDate(d: Date | null): string {
      if (!d) return '—';
      const now = new Date();
      const diff = now.getTime() - d.getTime();
      const sameDay = diff < 86400000 && d.getDate() === now.getDate();
      if (sameDay) return 'Hoy, ' + d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      const yesterday = diff < 172800000 && new Date(now.getTime() - 86400000).getDate() === d.getDate();
      if (yesterday) return 'Ayer, ' + d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
      return d.toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: d.getFullYear() !== now.getFullYear() ? 'numeric' : undefined });
    }

    function formatDateLong(d: Date | null): string {
      if (!d) return '—';
      return d.toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function getInitials(name: string): string {
      return name.split(' ').map(w => w[0]).slice(0, 2).join('').toUpperCase();
    }

    // --- Update counters ---
    function updateCounts() {
      const all = messages.length;
      const nuevo = messages.filter(m => m.status === 'nuevo').length;
      const pendiente = messages.filter(m => m.status === 'pendiente').length;
      const leido = messages.filter(m => m.status === 'leido').length;
      document.getElementById('countAll')!.textContent = String(all);
      document.getElementById('countNuevo')!.textContent = String(nuevo);
      document.getElementById('countPendiente')!.textContent = String(pendiente);
      document.getElementById('countLeido')!.textContent = String(leido);
    }

    // --- Render list ---
    function render() {
      const list = document.getElementById('msgList')!;
      const filtered = currentFilter === 'all' ? messages : messages.filter(m => m.status === currentFilter);
      updateCounts();

      if (filtered.length === 0) {
        list.innerHTML = '<div class="msg-empty"><span class="material-symbols-outlined notranslate" translate="no" style="font-size: 2rem; color: #cbd5e1;">inbox</span><p>No hay mensajes en esta categoría</p></div>';
        return;
      }

      list.innerHTML = filtered.map((m) => {
        const meta = statusMeta[m.status] || statusMeta.nuevo;
        const dateStr = formatDate(m.createdAt);
        const preview = m.message && m.message.length > 80 ? m.message.slice(0, 80) + '…' : (m.message || '');
        const isActive = m.id === selectedId;
        const isUnread = m.status === 'nuevo';
        return `<div class="msg-item ${isActive ? 'msg-item--active' : ''} ${isUnread ? 'msg-item--unread' : ''}" data-id="${m.id}">
          <div class="msg-item-avatar">${getInitials(m.name)}</div>
          <div class="msg-item-body">
            <div class="msg-item-top">
              <span class="msg-item-name">${escHtml(m.name)}</span>
              <span class="msg-item-date">${escHtml(dateStr)}</span>
            </div>
            <div class="msg-item-preview">${escHtml(preview)}</div>
            ${isUnread ? '<span class="msg-item-dot"></span>' : ''}
          </div>
        </div>`;
      }).join('');

      list.querySelectorAll('.msg-item').forEach((row) => {
        (row as HTMLElement).addEventListener('click', () => {
          const msg = messages.find(m => m.id === (row as HTMLElement).dataset.id);
          if (msg) openDetail(msg);
        });
      });
    }

    // --- Open detail panel ---
    async function openDetail(m: any) {
      selectedId = m.id;

      document.getElementById('detailEmpty')!.hidden = true;
      document.getElementById('detailContent')!.hidden = false;

      document.getElementById('detailAvatar')!.textContent = getInitials(m.name);
      document.getElementById('detailName')!.textContent = m.name;

      const badge = document.getElementById('detailBadge')!;
      const meta = statusMeta[m.status] || statusMeta.nuevo;
      badge.textContent = meta.label;
      badge.style.color = meta.color;
      badge.style.background = meta.bg;

      // Contact
      const contactEl = document.getElementById('metaContact')!;
      const contactText = document.getElementById('detailContactText')!;
      if (m.contactInfo) {
        const typeLabel = m.contactType === 'email' ? 'Correo' : 'Teléfono';
        contactText.textContent = `${typeLabel}: ${m.contactInfo}`;
        contactEl.hidden = false;
      } else {
        contactEl.hidden = true;
      }

      // Date
      document.getElementById('detailDateText')!.textContent = formatDateLong(m.createdAt);

      // Reservation
      const resEl = document.getElementById('metaReservation')!;
      const resText = document.getElementById('detailReservationText')!;
      if (m.date) {
        const resDate = new Date(m.date + 'T00:00:00').toLocaleDateString('es-MX', { day: '2-digit', month: 'long', year: 'numeric' });
        resText.textContent = `Fecha solicitada: ${resDate}`;
        resEl.hidden = false;
      } else {
        resEl.hidden = true;
      }

      // Interests
      const intEl = document.getElementById('metaInterests')!;
      const intText = document.getElementById('detailInterestsText')!;
      const items = m.services || m.interests || [];
      if (items.length) {
        intText.textContent = items.join(' · ');
        intEl.hidden = false;
      } else {
        intEl.hidden = true;
      }

      // Message body
      document.getElementById('detailMessage')!.textContent = m.message;

      // Action buttons visibility
      const btnPend = document.getElementById('btnPendiente')!;
      const btnLeido = document.getElementById('btnLeido')!;
      btnPend.hidden = m.status === 'pendiente';
      btnLeido.hidden = m.status === 'leido';

      // Mark as read if new
      if (m.status === 'nuevo') {
        await updateMsgStatus(m.id, 'leido');
        m.status = 'leido';
        badge.textContent = statusMeta.leido.label;
        badge.style.color = statusMeta.leido.color;
        badge.style.background = statusMeta.leido.bg;
        btnLeido.hidden = true;
        render();
      } else {
        render(); // re-render to highlight active
      }
    }

    // --- Action buttons ---
    document.getElementById('btnPendiente')!.addEventListener('click', async () => {
      if (!selectedId) return;
      await updateMsgStatus(selectedId, 'pendiente');
      const msg = messages.find(m => m.id === selectedId);
      if (msg) {
        msg.status = 'pendiente';
        openDetail(msg);
      }
    });

    document.getElementById('btnLeido')!.addEventListener('click', async () => {
      if (!selectedId) return;
      await updateMsgStatus(selectedId, 'leido');
      const msg = messages.find(m => m.id === selectedId);
      if (msg) {
        msg.status = 'leido';
        openDetail(msg);
      }
    });

    document.getElementById('btnTrash')!.addEventListener('click', async () => {
      if (!selectedId) return;
      if (!await showConfirm('¿Mover este mensaje a la papelera?')) return;
      await trashMsg(selectedId);
      messages = messages.filter(m => m.id !== selectedId);
      selectedId = null;
      document.getElementById('detailContent')!.hidden = true;
      document.getElementById('detailEmpty')!.hidden = false;
      render();
    });

    // --- Filters ---
    document.querySelectorAll('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-filter]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentFilter = (btn as HTMLElement).dataset.filter || 'all';
        render();
      });
    });

    // --- Init ---
    (async () => {
      try {
        messages = await fetchMessages();
        render();
      } catch (err: any) {
        const list = document.getElementById('msgList')!;
        list.innerHTML = `<div class="msg-empty" style="color:#ef4444;">Error al cargar mensajes</div>`;
        console.error('[Mensajes]', err);
      }
    })();
  </script>

  <style is:global>
    .msg-page {
      width: 100%;
      max-width: 1200px;
      animation: msgFadeIn 0.35s ease;
    }

    @keyframes msgFadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Header */
    .msg-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
    }

    .msg-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: #fff;
      margin: 0;
    }

    .msg-subtitle {
      font-size: 0.875rem;
      color: rgba(255,255,255,0.55);
      margin: 0.2rem 0 0;
    }

    .msg-filters {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
    }

    .msg-filter {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.9rem;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.05);
      color: rgba(255,255,255,0.65);
      font-size: 0.8rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
    }

    .msg-filter:hover {
      background: rgba(255,255,255,0.1);
      color: #fff;
    }

    .msg-filter.active {
      background: rgba(168,230,247,0.12);
      border-color: rgba(168,230,247,0.5);
      color: #a8e6f7;
    }

    .filter-count {
      font-size: 0.7rem;
      font-weight: 800;
      background: rgba(255,255,255,0.1);
      color: rgba(255,255,255,0.5);
      padding: 0.1rem 0.4rem;
      border-radius: 6px;
      min-width: 18px;
      text-align: center;
    }

    .msg-filter.active .filter-count {
      background: rgba(168,230,247,0.2);
      color: #a8e6f7;
    }

    /* Container: split panel */
    .msg-container {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 0;
      background: rgba(255,255,255,0.97);
      backdrop-filter: blur(24px);
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.2);
      overflow: hidden;
      box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 1px 3px rgba(0,0,0,0.06);
      min-height: 520px;
    }

    /* List panel */
    .msg-list-panel {
      border-right: 1px solid #e8ecf1;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .msg-list {
      flex: 1;
      overflow-y: auto;
    }

    .msg-list::-webkit-scrollbar { width: 4px; }
    .msg-list::-webkit-scrollbar-track { background: transparent; }
    .msg-list::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }

    .msg-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.9rem 1.1rem;
      cursor: pointer;
      border-bottom: 1px solid #f1f5f9;
      transition: background 0.15s ease;
      position: relative;
    }

    .msg-item:hover {
      background: #f8fafc;
    }

    .msg-item--active {
      background: #eff6ff !important;
      border-left: 3px solid #3b82f6;
    }

    .msg-item--unread .msg-item-name {
      font-weight: 800;
      color: #0f172a;
    }

    .msg-item--unread .msg-item-preview {
      color: #475569;
      font-weight: 500;
    }

    .msg-item-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .msg-item-body {
      flex: 1;
      min-width: 0;
    }

    .msg-item-top {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.5rem;
      margin-bottom: 0.2rem;
    }

    .msg-item-name {
      font-size: 0.875rem;
      font-weight: 600;
      color: #334155;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .msg-item-date {
      font-size: 0.72rem;
      color: #94a3b8;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .msg-item-preview {
      font-size: 0.8rem;
      color: #94a3b8;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      line-height: 1.4;
    }

    .msg-item-dot {
      position: absolute;
      top: 50%;
      right: 12px;
      transform: translateY(-50%);
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #3b82f6;
    }

    /* Detail panel */
    .msg-detail-panel {
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }

    .msg-detail-panel::-webkit-scrollbar { width: 4px; }
    .msg-detail-panel::-webkit-scrollbar-track { background: transparent; }
    .msg-detail-panel::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 2px; }

    .msg-detail-empty {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .msg-detail-empty[hidden],
    .msg-detail-content[hidden] {
      display: none !important;
    }

    .msg-detail-empty p {
      margin: 0;
    }

    .msg-detail-content {
      padding: 1.75rem 2rem;
      flex: 1;
      animation: detailSlide 0.2s ease;
    }

    @keyframes detailSlide {
      from { opacity: 0; transform: translateX(8px); }
      to { opacity: 1; transform: translateX(0); }
    }

    /* Detail header */
    .detail-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid #f1f5f9;
    }

    .detail-avatar {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0ea5e9, #6366f1);
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .detail-header-info {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .detail-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: #0f172a;
      margin: 0;
    }

    .detail-status-badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      width: fit-content;
    }

    /* Meta grid */
    .detail-meta-grid {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-bottom: 1.25rem;
    }

    .detail-meta-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.84rem;
      color: #475569;
    }

    .detail-meta-item .material-symbols-outlined {
      font-size: 1.1rem;
      color: #94a3b8;
    }

    /* Message box */
    .detail-message-box {
      margin-bottom: 1.5rem;
    }

    .detail-message-label {
      font-size: 0.75rem;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin: 0 0 0.5rem 0;
    }

    .detail-message-body {
      background: #f8fafc;
      border: 1px solid #e8ecf1;
      border-radius: 12px;
      padding: 1.25rem;
      font-size: 0.925rem;
      line-height: 1.75;
      color: #1e293b;
      white-space: pre-wrap;
      word-break: break-word;
    }

    /* Actions */
    .detail-actions {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.55rem 1rem;
      border-radius: 10px;
      border: 1px solid transparent;
      font-size: 0.82rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s;
    }

    .action-btn .material-symbols-outlined {
      font-size: 1.05rem;
    }

    .action-btn[hidden] { display: none !important; }

    .action-pending {
      background: #fffbeb;
      border-color: #fde68a;
      color: #92400e;
    }
    .action-pending:hover {
      background: #fef3c7;
      border-color: #fcd34d;
    }

    .action-read {
