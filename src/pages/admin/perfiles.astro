---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Perfiles - Azulia Admin">
  <div class="prof-page">
    <header class="prof-header">
      <div>
        <h1 class="prof-title">Perfiles de Administradores</h1>
        <p class="prof-subtitle">Gestiona los administradores del sistema</p>
      </div>
    </header>

    <div class="prof-card">
      <table class="prof-table">
        <thead>
          <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Rol</th>
            <th>Estado</th>
            <th>Registro</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody id="profBody">
          <tr><td colspan="6" class="prof-loading">Cargando administradores...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { getAdmins, toggleAdminStatus } from '../../lib/admin';
    import type { AdminProfile } from '../../lib/admin';

    let admins: AdminProfile[] = [];

    function render() {
      const tbody = document.getElementById('profBody')!;
      if (admins.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="prof-loading">No hay administradores registrados.</td></tr>';
        return;
      }
      tbody.innerHTML = admins.map((a) => {
        const date = a.createdAt
          ? new Date(a.createdAt).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' })
          : '—';
        const isActive = a.status === 'active';
        const isPending = a.status === 'pending';
        return `<tr class="${isActive ? '' : 'prof-row--disabled'}">
          <td><strong>${a.name}</strong></td>
          <td>${a.email}</td>
          <td><span class="prof-role ${a.role === 'superadmin' ? 'prof-role--super' : ''}">${a.role === 'superadmin' ? 'Superadmin' : 'Admin'}</span></td>
          <td><span class="prof-status ${isActive ? 'prof-status--active' : isPending ? 'prof-status--pending' : 'prof-status--disabled'}">${isActive ? 'Activo' : isPending ? 'Pendiente' : 'Deshabilitado'}</span></td>
          <td class="prof-date">${date}</td>
          <td>
            ${a.role !== 'superadmin' ? `<button class="prof-toggle-btn ${isActive ? 'prof-toggle--disable' : 'prof-toggle--enable'}" data-email="${a.email}" data-status="${a.status}">${isActive ? 'Deshabilitar' : 'Habilitar'}</button>` : '<span class="prof-na">—</span>'}
          </td>
        </tr>`;
      }).join('');

      tbody.querySelectorAll('.prof-toggle-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLButtonElement;
          const email = el.dataset.email!;
          const status = el.dataset.status!;
          const action = status === 'active' ? 'deshabilitar' : 'habilitar';
          if (!confirm(`¿${action} al administrador ${email}?`)) return;
          await toggleAdminStatus(email, status);
          admins = await getAdmins();
          render();
        });
      });
    }

    (async () => {
      admins = await getAdmins();
      render();
    })();
  </script>

  <style>
    .prof-page { width: 100%; max-width: 1000px; animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    .prof-header { margin-bottom: 1.5rem; }
    .prof-title { font-size: 1.5rem; font-weight: 700; color: #fff; margin: 0; }
    .prof-subtitle { font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0.25rem 0 0; }

    .prof-card { background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); border-radius: 16px; border: 1px solid rgba(255,255,255,0.2); overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.12); }

    .prof-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    .prof-table th { text-align: left; padding: 1rem 1rem; background: rgba(15,30,50,0.04); color: #475569; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid #e2e8f0; }
    .prof-table td { padding: 0.85rem 1rem; border-bottom: 1px solid #f1f5f9; color: #1e293b; vertical-align: middle; }
    .prof-row--disabled { opacity: 0.55; }

    .prof-role { display: inline-block; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; background: #e2e8f0; color: #475569; text-transform: uppercase; letter-spacing: 0.04em; }
    .prof-role--super { background: #fef3c7; color: #92400e; }

    .prof-status { display: inline-block; padding: 0.2rem 0.55rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
    .prof-status--active { background: #dcfce7; color: #166534; }
    .prof-status--pending { background: #fef9c3; color: #854d0e; }
    .prof-status--disabled { background: #f1f5f9; color: #64748b; }

    .prof-date { color: #64748b; font-size: 0.8rem; white-space: nowrap; }

    .prof-toggle-btn { padding: 0.35rem 0.85rem; border-radius: 8px; border: none; font-size: 0.78rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; }
    .prof-toggle--disable { background: #fef2f2; color: #dc2626; }
    .prof-toggle--disable:hover { background: #fee2e2; }
    .prof-toggle--enable { background: #f0fdf4; color: #16a34a; }
    .prof-toggle--enable:hover { background: #dcfce7; }
    .prof-na { color: #94a3b8; font-size: 0.82rem; }

    .prof-loading { text-align: center; padding: 3rem 1rem; color: #94a3b8; font-style: italic; }

    @media (max-width: 768px) {
      .prof-table thead { display: none; }
      .prof-table, .prof-table tbody, .prof-table tr, .prof-table td { display: block; }
      .prof-table tr { padding: 1rem; border-bottom: 1px solid #e2e8f0; }
      .prof-table td { padding: 0.35rem 0; border: none; }
    }
  </style>
</AdminLayout>
