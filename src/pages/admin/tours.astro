  const destModalDesc = document.getElementById("destModalDesc")!;
  const destDurationVal = document.getElementById("destDurationVal")!;
  const destAgeVal = document.getElementById("destAgeVal")!;
  const destCapacityVal = document.getElementById("destCapacityVal")!;
  const destScheduleVal = document.getElementById("destScheduleVal")!;
  const destIncludesWrap = document.getElementById("destIncludesWrap")!;
  const destIncludesList = document.getElementById("destIncludesList")!;
  const destNearbyWrap = document.getElementById("destNearbyWrap")!;
  const destNearbyList = document.getElementById("destNearbyList")!;
  const destPriceVal = document.getElementById("destPriceVal")!;
  const destReservePreviewBtn = document.getElementById("destReservePreviewBtn")!;

  // Confirm Modal Elements
  const confirmModal = document.getElementById("confirmModal")!;
  const confirmClose = document.getElementById("confirmClose")!;
  const confirmCancel = document.getElementById("confirmCancel")!;
  const confirmDelete = document.getElementById("confirmDelete")!;
  const confirmText = document.getElementById("confirmText")!;

  // Toast
  const toastOverlay = document.getElementById("toastOverlay")!;
  const toastCard = document.getElementById("toastCard")!;
  const toastIcon = document.getElementById("toastIcon")!;
  const toastText = document.getElementById("toastText")!;
  let toastTimer: number;

  function showToast(msg: string, isError = false) {
    clearTimeout(toastTimer);
    toastText.textContent = msg;
    toastIcon.textContent = isError ? "error" : "check_circle";
    toastCard.classList.toggle("toast-error", isError);
    toastOverlay.hidden = false;
    toastTimer = window.setTimeout(() => {
      toastOverlay.hidden = true;
    }, 3500);
  }

  // Render Visual Icon Picker
  function renderIconSelector() {
    iconSelectorGrid.innerHTML = AVAILABLE_ICONS.map(item => `
      <div class="icon-option-btn ${item.icon === activeSelectedIcon ? 'active' : ''}" data-icon="${item.icon}">
        <span class="material-symbols-outlined notranslate" translate="no">${item.icon}</span>
        <span>${item.label}</span>
      </div>
    `).join("");
  }

  iconSelectorGrid.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".icon-option-btn") as HTMLElement;
    if (!btn) return;
    const icon = btn.dataset.icon || "sailing";
    activeSelectedIcon = icon;
    tourIconHidden.value = icon;
    renderIconSelector();
    updateLiveCardPreview();
  });

  // Helper formatting functions
  function formatPriceText(val: number | string): string {
    const num = Number(val);
    if (!isNaN(num) && num > 0) {
      return `$${num.toLocaleString('es-MX')} MXN`;
    }
    return "$0 MXN";
  }

  function formatDurationText(min: number, max: number, unit: string): string {
    if (min === max || !max) {
      return `${min} ${unit}`;
    }
    return `${min} a ${max} ${unit}`;
  }

  function formatRatingText(score: number, reviews?: number): string {
    const rounded = Math.min(5, Math.max(1, score || 5)).toFixed(1);
    if (reviews && reviews > 0) {
      return `${rounded} (${reviews} opiniones)`;
    }
    return `${rounded} de 5.0`;
  }

  function formatCapacityText(cap: number): string {
    if (cap > 0) {
      return `Máx. ${cap} personas`;
    }
    return "Consultar capacidad";
  }

  function formatAgeText(age: number): string {
    if (!age || age <= 0) {
      return "Todas las edades";
    }
    return `A partir de ${age} años`;
  }

  // Parse duration text into numbers if available
  function parseDurationString(dur: any): { min: number; max: number; unit: string } {
    const raw = Array.isArray(dur) ? dur.join(" ") : String(dur || "");
    const numbers = raw.match(/\d+(\.\d+)?/g);
    let unit = "horas";
    if (raw.toLowerCase().includes("día") || raw.toLowerCase().includes("dia")) unit = "días";
    if (raw.toLowerCase().includes("minut")) unit = "minutos";

    if (numbers && numbers.length >= 2) {
      return { min: Number(numbers[0]), max: Number(numbers[1]), unit };
    } else if (numbers && numbers.length === 1) {
      return { min: Number(numbers[0]), max: Number(numbers[0]), unit };
    }
    return { min: 2, max: 3, unit: "horas" };
  }

  function parseRatingScore(rate: any): number {
    if (typeof rate === "number") return rate;
    const str = String(rate || "");
    const match = str.match(/(\d+(\.\d+)?)/);
    return match ? Number(match[1]) : 4.9;
  }

  function parseReviewsCount(rate: any): number {
    const str = String(rate || "");
    const match = str.match(/\((\d+)/);
    return match ? Number(match[1]) : 120;
  }

  function parseCapacityNumber(cap: any): number {
    const match = String(cap || "").match(/\d+/);
    return match ? Number(match[0]) : 10;
  }

  function parseAgeNumber(age: any): number {
    const match = String(age || "").match(/\d+/);
    return match ? Number(match[0]) : 0;
  }

  function parsePriceNumber(pr: any): number {
    const digits = String(pr || "").replace(/[^\d]/g, "");
    return digits ? Number(digits) : 1800;
  }

  // Subpage Label & Icon Helper
  function getSubpageMeta(subpage: string) {
    switch (subpage) {
      case "nauticos": return { label: "Náuticos", icon: "sailing" };
      case "ruinas": return { label: "Ruinas Mayas", icon: "temple_hindu" };
      case "mahahual": return { label: "Mahahual", icon: "beach_access" };
      case "belice": return { label: "Belice", icon: "flag" };
      case "guatemala": return { label: "Guatemala", icon: "landscape" };
      case "honduras": return { label: "Honduras", icon: "wb_sunny" };
      default: return { label: subpage || "General", icon: "tour" };
    }
  }

  // Update UI based on active tab
  function updateTabUI() {
    if (currentFilter === "all") {
      addTourBtn.style.display = "none";
      allTabNotice.style.display = "flex";
    } else {
      const meta = getSubpageMeta(currentFilter);
      addBtnLabel.textContent = `Agregar Tour en ${meta.label}`;
      addTourBtn.style.display = "inline-flex";
      allTabNotice.style.display = "none";
    }
  }

  // Fetch Tours from API
  async function loadTours() {
    try {
      const res = await fetch("/api/tours");
      const data = await res.json();
      if (data.tours && Array.isArray(data.tours)) {
        allTours = data.tours;
        updateCounts();
        renderToursGrid();
      } else {
        showToast("Error al obtener los tours", true);
      }
    } catch (err) {
      console.error(err);
      showToast("No se pudo conectar con el catálogo de tours", true);
    }
  }

  // Update Counters in Sub-Bar
  function updateCounts() {
    countAll.textContent = String(allTours.length);
    countNauticos.textContent = String(allTours.filter(t => t.subpage === "nauticos").length);
    countRuinas.textContent = String(allTours.filter(t => t.subpage === "ruinas").length);
    countMahahual.textContent = String(allTours.filter(t => t.subpage === "mahahual").length);
    countBelice.textContent = String(allTours.filter(t => t.subpage === "belice").length);
    countGuatemala.textContent = String(allTours.filter(t => t.subpage === "guatemala").length);
    countHonduras.textContent = String(allTours.filter(t => t.subpage === "honduras").length);
  }

  // Filter and Search Tours
  function getFilteredTours(): TourRecord[] {
    return allTours.filter(tour => {
      const matchesSubpage = currentFilter === "all" || tour.subpage === currentFilter;
      if (!matchesSubpage) return false;

      if (!searchQuery.trim()) return true;
      const q = searchQuery.toLowerCase().trim();
      const nameMatch = (tour.name || "").toLowerCase().includes(q);
      const descMatch = (tour.description || "").toLowerCase().includes(q);
      const modalMatch = (tour.modalTitle || "").toLowerCase().includes(q) || (tour.text || "").toLowerCase().includes(q);
      return nameMatch || descMatch || modalMatch;
    });
  }

  // Render Tours Grid (Defensively safely parsed)
  function renderToursGrid() {
    try {
      const list = getFilteredTours();

      if (list.length === 0) {
        toursGrid.innerHTML = `
          <div class="tours-empty-state">
            <span class="material-symbols-outlined notranslate" translate="no">travel_explore</span>
            <p>No se encontraron tours con los filtros aplicados.</p>
          </div>
        `;
        return;
      }

      toursGrid.innerHTML = list.map(tour => {
        const meta = getSubpageMeta(tour.subpage);
        const mainImg = tour.image || (tour.modalImages && tour.modalImages[0]) || "";
        const priceText = tour.price || "Tarifa no definida";

        // Defensive rating parsing
        let ratingDisplay = "5.0";
        if (typeof tour.rating === "number") {
          ratingDisplay = tour.rating.toFixed(1);
        } else if (typeof tour.rating === "string") {
          const match = tour.rating.match(/(\d+(\.\d+)?)/);
          if (match) ratingDisplay = match[1];
        }

        // Defensive duration parsing
        let durationDisplay = "Consultar";
        if (Array.isArray(tour.duration)) {
          durationDisplay = tour.duration.join(" · ");
        } else if (tour.duration) {
          durationDisplay = String(tour.duration);
        }

        const scheduleText = tour.schedule || "Horario disponible";

        return `
          <article class="tour-card-admin" data-id="${tour.id}">
            <div class="admin-card-img-wrap">
              ${mainImg ? `
                <img src="${mainImg}" alt="${tour.name}" class="admin-card-img" loading="lazy" onerror="this.onerror=null;this.src='/src/assets/photos_azulia_webp/upscale_azulia_2.webp';" />
              ` : `
                <div class="admin-card-placeholder">
                  <span class="material-symbols-outlined notranslate" translate="no">landscape</span>
                </div>
              `}
              <span class="admin-subpage-badge">
                <span class="material-symbols-outlined notranslate" translate="no">${meta.icon}</span>
                ${meta.label}
              </span>
              <span class="admin-rating-badge">
                <span class="material-symbols-outlined notranslate" translate="no">star</span>
                ${ratingDisplay}
              </span>
            </div>

            <div class="admin-card-body">
              <div class="admin-card-title-row">
                <span class="material-symbols-outlined notranslate admin-card-icon" translate="no">${tour.icon || 'tour'}</span>
                <h3 class="admin-card-name">${tour.name}</h3>
              </div>
              <p class="admin-card-desc">${tour.description || tour.text || ''}</p>

              <div class="admin-card-meta-chips">
                <span class="admin-meta-chip" title="Duración">
                  <span class="material-symbols-outlined notranslate" translate="no">schedule</span>
                  ${durationDisplay}
                </span>
                <span class="admin-meta-chip" title="Horario">
                  <span class="material-symbols-outlined notranslate" translate="no">event</span>
                  ${scheduleText}
                </span>
              </div>

              <div class="admin-card-footer">
                <span class="admin-card-price">${priceText}</span>
                <div class="admin-card-actions">
                  <button type="button" class="admin-action-btn btn-view-modal" data-action="view-modal" data-id="${tour.id}" title="Ver vista previa de la ventana completa">
                    <span class="material-symbols-outlined notranslate" translate="no">visibility</span>
                    Ver
                  </button>
                  <button type="button" class="admin-action-btn btn-edit" data-action="edit" data-id="${tour.id}" title="Editar información del tour">
                    <span class="material-symbols-outlined notranslate" translate="no">edit</span>
                    Editar
                  </button>
                  <button type="button" class="admin-action-btn btn-delete" data-action="delete" data-id="${tour.id}" title="Mover a papelera">
                    <span class="material-symbols-outlined notranslate" translate="no">delete</span>
                  </button>
                </div>
              </div>
            </div>
          </article>
        `;
      }).join("");
    } catch (err) {
      console.error("[renderToursGrid]", err);
    }
  }

  // Filter Subpage Tabs Event
  subpageNavBar.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement).closest(".subpage-pill") as HTMLElement;
    if (!target) return;
    const filter = target.dataset.filter || "all";
    currentFilter = filter;

    subpageNavBar.querySelectorAll(".subpage-pill").forEach(p => p.classList.remove("active"));
    target.classList.add("active");

    updateTabUI();
    renderToursGrid();
  });

  // Search Input Event
  toursSearchInput.addEventListener("input", () => {
    searchQuery = toursSearchInput.value;
    renderToursGrid();
  });

  // Grid Action Delegation
  toursGrid.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-action]") as HTMLElement;
    if (!btn) return;
    const action = btn.dataset.action;
    const tourId = btn.dataset.id;
    const tour = allTours.find(t => t.id === tourId);
    if (!tour) return;

    if (action === "view-modal") {
      openDestinationModalPreview(tour);
    } else if (action === "edit") {
      openEditModal(tour);
    } else if (action === "delete") {
      openDeleteConfirmModal(tour);
    }
  });

  // Open Edit Form Modal
  function openEditModal(tour?: TourRecord) {
    tourForm.reset();
    currentIncludes = [];
    currentNearby = [];
    currentModalImages = [];

    const targetSubpage = tour ? tour.subpage : (currentFilter !== "all" ? currentFilter : "nauticos");
    tourSubpageHidden.value = targetSubpage;

    const subpageMeta = getSubpageMeta(targetSubpage);
    modalCategoryBadge.textContent = subpageMeta.label;

    if (tour) {
      modalTitle.textContent = "Editar Tour: " + tour.name;
      tourIdInput.value = tour.id;
      tourNameInput.value = tour.name;
      tourDescInput.value = tour.description;
      tourImageHidden.value = tour.image || "";

      activeSelectedIcon = tour.icon || "sailing";
      tourIconHidden.value = activeSelectedIcon;

      // Numeric parsing
      priceNumInput.value = String(parsePriceNumber(tour.price));
      ratingInput.value = String(parseRatingScore(tour.rating));

      const durParsed = parseDurationString(tour.duration);
      durationMinInput.value = String(durParsed.min);
      durationMaxInput.value = String(durParsed.max);
      durationUnitSelect.value = durParsed.unit;

      capacityNumInput.value = String(parseCapacityNumber(tour.capacity));
      ageMinNumInput.value = String(parseAgeNumber(tour.ageRange));

      modalScheduleInput.value = tour.schedule || "10:00 AM - 1:00 PM";
      modalFullTextInput.value = tour.text || tour.description;

      currentIncludes = Array.isArray(tour.includes) ? [...tour.includes] : [];
      currentNearby = Array.isArray(tour.nearby) ? [...tour.nearby] : [];
      currentModalImages = Array.isArray(tour.modalImages) ? [...tour.modalImages] : (tour.image ? [tour.image] : []);
    } else {
      modalTitle.textContent = `Agregar Tour en ${subpageMeta.label}`;
      tourIdInput.value = "";
      tourNameInput.value = "";
      tourDescInput.value = "";
      tourImageHidden.value = "";

      activeSelectedIcon = "sailing";
      tourIconHidden.value = activeSelectedIcon;

      priceNumInput.value = "1800";
      ratingInput.value = "4.9";

      durationMinInput.value = "2";
      durationMaxInput.value = "3";
      durationUnitSelect.value = "horas";

      capacityNumInput.value = "10";
      ageMinNumInput.value = "0";

      modalScheduleInput.value = "10:00 AM - 1:00 PM";
      modalFullTextInput.value = "";

      currentIncludes = ["Guía bilingüe certificado", "Equipo de seguridad", "Bebidas refrescantes"];
      currentNearby = ["Laguna de Bacalar"];
      currentModalImages = [];
    }

    renderIconSelector();
    renderTagBuilders();
    updateLiveCardPreview();
    tourModal.hidden = false;
  }

  // Tag Builders Renderer
  function renderTagBuilders() {
    // Includes
    includesTags.innerHTML = currentIncludes.map((item, idx) => `
      <span class="admin-tag">
        ✓ ${item}
        <button type="button" data-idx="${idx}" class="remove-inc" title="Eliminar">&times;</button>
      </span>
    `).join("");

    // Nearby
    nearbyTags.innerHTML = currentNearby.map((item, idx) => `
      <span class="admin-tag">
        📍 ${item}
        <button type="button" data-idx="${idx}" class="remove-near" title="Eliminar">&times;</button>
      </span>
    `).join("");

    // Modal Photos Gallery
    galleryChips.innerHTML = currentModalImages.map((src, idx) => `
      <div class="gallery-thumb-tag">
        <img src="${src}" alt="Foto ${idx + 1}" onerror="this.onerror=null;this.src='/src/assets/photos_azulia_webp/upscale_azulia_2.webp';" />
        <button type="button" class="gallery-thumb-remove" data-idx="${idx}" title="Eliminar foto">&times;</button>
      </div>
    `).join("");

    // Update tags count in preview
    prevInclusionsCount.textContent = `${currentIncludes.length} ítems`;
    prevPhotosCount.textContent = `${currentModalImages.length} fotos`;
  }

  // Tag Add / Remove Listeners
  addIncludeBtn.addEventListener("click", () => {
    const val = includeInput.value.trim();
    if (val) {
      currentIncludes.push(val);
      includeInput.value = "";
      renderTagBuilders();
    }
  });
  includeInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addIncludeBtn.click();
    }
  });
  includesTags.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".remove-inc") as HTMLElement;
    if (btn) {
      const idx = Number(btn.dataset.idx);
      currentIncludes.splice(idx, 1);
      renderTagBuilders();
    }
  });

  addNearbyBtn.addEventListener("click", () => {
    const val = nearbyInput.value.trim();
    if (val) {
      currentNearby.push(val);
      nearbyInput.value = "";
      renderTagBuilders();
    }
  });
  nearbyInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") {
      e.preventDefault();
      addNearbyBtn.click();
    }
  });
  nearbyTags.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".remove-near") as HTMLElement;
    if (btn) {
      const idx = Number(btn.dataset.idx);
      currentNearby.splice(idx, 1);
      renderTagBuilders();
    }
  });

  // Gallery Remove Photo
  galleryChips.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(".gallery-thumb-remove") as HTMLElement;
    if (btn) {
      const idx = Number(btn.dataset.idx);
      currentModalImages.splice(idx, 1);
      renderTagBuilders();
      updateLiveCardPreview();
    }
  });

  // Live Card Preview Updater
  function updateLiveCardPreview() {
    const name = tourNameInput.value.trim() || "Nombre de la experiencia";
    const desc = tourDescInput.value.trim() || "La descripción del tour se actualizará en tiempo real conforme vayas escribiendo...";
    const subpage = tourSubpageHidden.value || "nauticos";
    const meta = getSubpageMeta(subpage);
    const imgUrl = tourImageHidden.value || (currentModalImages[0] || "");

    // Live card elements
    prevTitle.textContent = name;
    prevIcon.textContent = activeSelectedIcon;
    prevDesc.textContent = desc;
    prevSubpageChip.textContent = meta.label;

    if (imgUrl) {
      prevImg.src = imgUrl;
      prevImg.style.display = "block";
      prevImgPlaceholder.style.display = "none";
      mainPhotoImg.src = imgUrl;
      mainPhotoImg.style.display = "block";
      mainPhotoEmpty.style.display = "none";
    } else {
      prevImg.style.display = "none";
      prevImgPlaceholder.style.display = "flex";
      mainPhotoImg.style.display = "none";
      mainPhotoEmpty.style.display = "flex";
    }

    // Live specs tags
    const priceVal = formatPriceText(priceNumInput.value);
    const minDur = Number(durationMinInput.value) || 1;
    const maxDur = Number(durationMaxInput.value) || minDur;
    const durUnit = durationUnitSelect.value;
    const durationVal = formatDurationText(minDur, maxDur, durUnit);

    prevPriceTag.textContent = priceVal;
    prevDurationTag.textContent = durationVal;
    prevPhotosCount.textContent = `${currentModalImages.length} fotos`;
    prevInclusionsCount.textContent = `${currentIncludes.length} ítems`;
  }

  // Bind input listeners for live real-time updating
  [
    tourNameInput,
    tourDescInput,
    priceNumInput,
    ratingInput,
    durationMinInput,
    durationMaxInput,
    durationUnitSelect,
    capacityNumInput,
    ageMinNumInput
  ].forEach(input => {
    input.addEventListener("input", updateLiveCardPreview);
    input.addEventListener("change", updateLiveCardPreview);
  });

  // Main Photo Upload Handler (Local file)
  uploadMainPhotoBtn.addEventListener("click", () => mainPhotoFileInput.click());
  mainPhotoFileInput.addEventListener("change", async () => {
    const file = mainPhotoFileInput.files?.[0];
    if (!file) return;

    if (!file.type.startsWith("image/")) {
      showToast("Por favor selecciona una imagen válida (JPG, PNG, etc.)", true);
      return;
    }

    mainUploadStatus.textContent = "Procesando foto...";
    const formData = new FormData();
    formData.append("file", file);

    try {
      const user = auth.currentUser;
      const token = user ? await user.getIdToken() : "";

      const res = await fetch("/api/tours/upload", {
        method: "POST",
        headers: { "Authorization": "Bearer " + token },
        body: formData
      });
      const data = await res.json();
      if (res.ok && data.url) {
        tourImageHidden.value = data.url;
        if (!currentModalImages.includes(data.url)) {
          currentModalImages.unshift(data.url);
        }
        mainUploadStatus.textContent = "¡Foto guardada con éxito!";
        renderTagBuilders();
        updateLiveCardPreview();
        setTimeout(() => mainUploadStatus.textContent = "", 2500);
      } else {
        mainUploadStatus.textContent = "";
        showToast(data.error || "No se pudo procesar la foto", true);
      }
    } catch (err) {
      console.error(err);
      mainUploadStatus.textContent = "";
      showToast("Error de conexión al subir la foto", true);
    }
  });

  // Gallery Photos Upload Handler (Multiple local files)
  uploadGalleryPhotoBtn.addEventListener("click", () => galleryPhotoFileInput.click());
  galleryPhotoFileInput.addEventListener("change", async () => {
    const files = galleryPhotoFileInput.files;
    if (!files || files.length === 0) return;

    showToast(`Procesando ${files.length} foto(s)...`);

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!file.type.startsWith("image/")) {
        showToast(`El archivo ${file.name} no es una imagen válida`, true);
        continue;
      }

      const formData = new FormData();
      formData.append("file", file);

      try {
        const user = auth.currentUser;
        const token = user ? await user.getIdToken() : "";

        const res = await fetch("/api/tours/upload", {
          method: "POST",
          headers: { "Authorization": "Bearer " + token },
          body: formData
        });
        const data = await res.json();
        if (res.ok && data.url) {
          currentModalImages.push(data.url);
        } else {
          showToast(data.error || `Error al procesar ${file.name}`, true);
        }
      } catch (err) {
        console.error(err);
        showToast("Error de conexión al procesar fotos", true);
      }
    }

    renderTagBuilders();
    updateLiveCardPreview();
    showToast("Fotos añadidas a la galería");
  });

  // Form Submit Handler (Create or Update)
  tourForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const tourId = tourIdInput.value.trim();
    const isEdit = Boolean(tourId);
    const subpage = tourSubpageHidden.value || "nauticos";

    // Format all properties into clean representations
    const priceVal = formatPriceText(priceNumInput.value);
    const ratingScore = Number(ratingInput.value) || 5;
    const ratingVal = formatRatingText(ratingScore, 0);

    const minDur = Number(durationMinInput.value) || 1;
    const maxDur = Number(durationMaxInput.value) || minDur;
    const durUnit = durationUnitSelect.value;
    const durationVal = formatDurationText(minDur, maxDur, durUnit);

    const capacityVal = formatCapacityText(Number(capacityNumInput.value) || 10);
    const ageRangeVal = formatAgeText(Number(ageMinNumInput.value) || 0);

    const mainImg = tourImageHidden.value || (currentModalImages[0] || "");

    // Calculate display order: for new tours, automatically put at the end
    let orderNum = 10;
    if (isEdit) {
      const existing = allTours.find(t => t.id === tourId);
      orderNum = existing?.order ?? 10;
    } else {
      const toursInThisSubpage = allTours.filter(t => t.subpage === subpage);
      orderNum = (toursInThisSubpage.length + 1) * 10;
    }

    const payload: Partial<TourRecord> = {
      subpage,
      name: tourNameInput.value.trim(),
      icon: tourIconHidden.value || "sailing",
      description: tourDescInput.value.trim(),
      image: mainImg,
      order: orderNum,
      modalTitle: tourNameInput.value.trim(),
      schedule: modalScheduleInput.value.trim(),
      price: priceVal,
      rating: ratingVal,
      duration: durationVal,
      capacity: capacityVal,
      ageRange: ageRangeVal,
      text: modalFullTextInput.value.trim() || tourDescInput.value.trim(),
      modalImages: currentModalImages.length > 0 ? currentModalImages : [mainImg].filter(Boolean),
      includes: currentIncludes,
      nearby: currentNearby
    };

    if (isEdit) {
      payload.id = tourId;
    }

    try {
      showToast(isEdit ? "Guardando cambios..." : "Creando tour...");
      const method = isEdit ? "PUT" : "POST";
      
      const user = auth.currentUser;
      const token = user ? await user.getIdToken() : "";

      const res = await fetch("/api/tours", {
        method,
        headers: { 
          "Content-Type": "application/json",
          "Authorization": "Bearer " + token
        },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (res.ok && data.ok) {
        showToast(isEdit ? "¡Tour actualizado exitosamente!" : "¡Tour agregado exitosamente!");
        tourModal.hidden = true;
        await loadTours();
      } else {
        showToast(data.error || "No se pudo guardar el tour", true);
      }
    } catch (err) {
      console.error(err);
      showToast("Error de conexión al guardar", true);
    }
  });

  // Resulting Destination Modal Preview
  btnPreviewResultingModal.addEventListener("click", () => {
    const minDur = Number(durationMinInput.value) || 1;
    const maxDur = Number(durationMaxInput.value) || minDur;
    const durUnit = durationUnitSelect.value;
    const durationVal = formatDurationText(minDur, maxDur, durUnit);

    const priceVal = formatPriceText(priceNumInput.value);
    const ratingScore = Number(ratingInput.value) || 5;
    const ratingVal = formatRatingText(ratingScore, 0);
    const capacityVal = formatCapacityText(Number(capacityNumInput.value) || 10);
    const ageRangeVal = formatAgeText(Number(ageMinNumInput.value) || 0);

    const mainImg = tourImageHidden.value || (currentModalImages[0] || "");

    const currentFormData: TourRecord = {
      id: tourIdInput.value.trim() || "preview-id",
      subpage: tourSubpageHidden.value,
      name: tourNameInput.value.trim() || "Nombre del Tour",
      icon: tourIconHidden.value || "sailing",
      description: tourDescInput.value.trim(),
      image: mainImg,
      modalTitle: tourNameInput.value.trim() || "Nombre del Tour",
      schedule: modalScheduleInput.value.trim() || "Horario disponible",
      price: priceVal,
      rating: ratingVal,
      duration: durationVal,
      capacity: capacityVal,
      ageRange: ageRangeVal,
      text: modalFullTextInput.value.trim() || tourDescInput.value.trim() || "Descripción completa de la experiencia...",
      modalImages: currentModalImages.length > 0 ? currentModalImages : [mainImg].filter(Boolean),
      includes: currentIncludes,
      nearby: currentNearby,
      order: 0
    };

    openDestinationModalPreview(currentFormData);
  });

  function openDestinationModalPreview(tour: TourRecord) {
    previewCarouselList = tour.modalImages && tour.modalImages.length > 0
      ? tour.modalImages
      : (tour.image ? [tour.image] : ["/src/assets/photos_azulia_webp/upscale_azulia_2.webp"]);
    previewCarouselIndex = 0;

    // Carousel Image Renderer
    renderPreviewCarousel();

    // Headers & Text
    destModalTitle.textContent = tour.modalTitle || tour.name;
    destModalDesc.textContent = tour.text || tour.description || "";

    // Rating
    destModalRating.textContent = String(tour.rating || "5.0");

    // Price
    destPriceVal.textContent = String(tour.price || "$0 MXN");

    // Specs
    destDurationVal.textContent = Array.isArray(tour.duration) ? tour.duration.join(" · ") : String(tour.duration || "Consultar");
    destAgeVal.textContent = String(tour.ageRange || "Todas las edades");
    destCapacityVal.textContent = String(tour.capacity || "Consultar capacidad");
    destScheduleVal.textContent = String(tour.schedule || "Horario disponible");

    // Inclusions List
    const incs = tour.includes || [];
    if (incs.length > 0) {
      destIncludesWrap.style.display = "block";
      destIncludesList.innerHTML = incs.map(i => `
        <li class="include-item">
          <span class="include-icon">✓</span>
          ${i}
        </li>
      `).join("");
    } else {
      destIncludesWrap.style.display = "none";
    }

    // Nearby List
    const nears = tour.nearby || [];
    if (nears.length > 0) {
      destNearbyWrap.style.display = "block";
      destNearbyList.innerHTML = nears.map(n => `
        <div class="nearby-item">
          <span class="location-icon">📍</span>
          ${n}
        </div>
      `).join("");
    } else {
      destNearbyWrap.style.display = "none";
    }

    destinationPreviewOverlay.hidden = false;
  }

  function renderPreviewCarousel() {
    destModalImgs.innerHTML = previewCarouselList.map((src, i) => `
      <img src="${src}" alt="Foto ${i + 1}" class="dmodal-img ${i === previewCarouselIndex ? 'active' : ''}" onerror="this.onerror=null;this.src='/src/assets/photos_azulia_webp/upscale_azulia_2.webp';" />
    `).join("");

    destImgCounter.textContent = `${previewCarouselIndex + 1} / ${previewCarouselList.length}`;
  }

  destImgPrevBtn.addEventListener("click", () => {
    previewCarouselIndex = previewCarouselIndex > 0 ? previewCarouselIndex - 1 : previewCarouselList.length - 1;
    renderPreviewCarousel();
  });
  destImgNextBtn.addEventListener("click", () => {
    previewCarouselIndex = previewCarouselIndex < previewCarouselList.length - 1 ? previewCarouselIndex + 1 : 0;
    renderPreviewCarousel();
  });

  closeDestinationPreviewBtn.addEventListener("click", () => {
    destinationPreviewOverlay.hidden = true;
  });
  destinationPreviewOverlay.addEventListener("click", (e) => {
    if (e.target === destinationPreviewOverlay) {
      destinationPreviewOverlay.hidden = true;
    }
  });

  destReservePreviewBtn.addEventListener("click", () => {
    showToast("En el sitio web, este botón abre el formulario directo de reserva para el cliente.");
  });

  // Delete Confirm Modal
  function openDeleteConfirmModal(tour: TourRecord) {
    tourToDelete = tour;
    const meta = getSubpageMeta(tour.subpage);
    confirmText.textContent = `¿Seguro que deseas eliminar "${tour.name}" de la categoría "${meta.label}"? Podrás restaurarlo en cualquier momento desde la papelera.`;
    confirmModal.hidden = false;
  }

  confirmDelete.addEventListener("click", async () => {
    if (!tourToDelete) return;
    try {
      showToast("Moviendo tour a papelera...");
      const user = auth.currentUser;
      const token = user ? await user.getIdToken() : "";

      const res = await fetch(`/api/tours?id=${encodeURIComponent(tourToDelete.id)}`, {
        method: "DELETE",
        headers: { "Authorization": "Bearer " + token }
      });
      const data = await res.json();
      if (res.ok && data.ok) {
        showToast("¡Tour movido a la papelera con éxito!");
        confirmModal.hidden = true;
        tourToDelete = null;
        await loadTours();
      } else {
        showToast(data.error || "No se pudo eliminar el tour", true);
      }
    } catch (err) {
      console.error(err);
      showToast("Error de conexión al eliminar tour", true);
    }
  });

  confirmCancel.addEventListener("click", () => {
    confirmModal.hidden = true;
    tourToDelete = null;
  });
  confirmClose.addEventListener("click", () => {
    confirmModal.hidden = true;
    tourToDelete = null;
  });

  // Modal open/close listeners
  addTourBtn.addEventListener("click", () => openEditModal());
  modalClose.addEventListener("click", () => tourModal.hidden = true);
  cancelBtn.addEventListener("click", () => tourModal.hidden = true);
  tourModal.addEventListener("click", (e) => {
    if (e.target === tourModal) tourModal.hidden = true;
  });

  // Initial load
  updateTabUI();
  renderIconSelector();
  loadTours();
</script>
