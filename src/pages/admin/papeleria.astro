---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Papelera - Azulia Admin">
  <div class="trash-page">
    <header class="trash-header">
      <div>
        <h1 class="trash-title">Papelera</h1>
        <p class="trash-subtitle">Elementos eliminados recientemente · Se purgan automáticamente después de 30 días</p>
      </div>
    </header>

    <div class="trash-filters" id="trashFilters">
      <button class="trash-filter active" data-filter="all">Todos</button>
      <button class="trash-filter" data-filter="message">
        <span class="material-symbols-outlined">mail</span> Mensajes
      </button>
      <button class="trash-filter" data-filter="admin">
        <span class="material-symbols-outlined">badge</span> Perfiles
      </button>
      <button class="trash-filter" data-filter="poster">
        <span class="material-symbols-outlined">wallpaper</span> Posters
      </button>
      <button class="trash-filter" data-filter="hotel">
        <span class="material-symbols-outlined">apartment</span> Hoteles
      </button>
    </div>

    <div class="trash-card">
      <table class="trash-table">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Contenido</th>
            <th>Eliminado</th>
            <th>Expira</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="trashBody">
          <tr><td colspan="5" class="trash-loading">Cargando papelera...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="modal-overlay" id="confirmModal" hidden>
    <div class="modal-card confirm-modal-card">
      <button class="modal-close" id="confirmClose">
        <span class="material-symbols-outlined">close</span>
      </button>
      <span class="material-symbols-outlined confirm-icon" id="confirmIcon">help</span>
      <h3 class="confirm-title" id="confirmTitle">¿Restaurar?</h3>
      <p class="confirm-text" id="confirmText"></p>
      <div class="confirm-actions">
        <button class="modal-btn modal-btn-cancel" id="confirmCancel">Cancelar</button>
        <button class="modal-btn modal-btn-primary" id="confirmOk">Aceptar</button>
      </div>
    </div>
  </div>

  <script>
    import { restoreFromTrash } from '../../lib/admin';

    const typeConfig: Record<string, { label: string; icon: string; color: string; bg: string }> = {
      message: { label: 'Mensaje', icon: 'mail', color: '#1c5fa8', bg: '#eff6ff' },
      admin: { label: 'Perfil', icon: 'badge', color: '#7c3aed', bg: '#f5f3ff' },
      poster: { label: 'Poster', icon: 'wallpaper', color: '#059669', bg: '#ecfdf5' },
      hotel: { label: 'Hotel', icon: 'apartment', color: '#d97706', bg: '#fffbeb' },
    };

    interface TrashItemClient {
      id: string;
      type: string;
      originalId: string;
      data: Record<string, unknown>;
      deletedAt: string | null;
      expiresAt: string | null;
    }

    let items: TrashItemClient[] = [];
    let activeFilter = 'all';
    let confirmResolve: ((ok: boolean) => void) | null = null;

    const trashBody = document.getElementById('trashBody')!;
    const filtersContainer = document.getElementById('trashFilters')!;
    const confirmModal = document.getElementById('confirmModal')!;
    const confirmClose = document.getElementById('confirmClose')!;
    const confirmIcon = document.getElementById('confirmIcon')!;
    const confirmTitle = document.getElementById('confirmTitle')!;
    const confirmText = document.getElementById('confirmText')!;
    const confirmCancel = document.getElementById('confirmCancel')!;
    const confirmOk = document.getElementById('confirmOk')!;

    function showConfirm(icon: string, title: string, text: string, btnLabel: string, btnClass: string): Promise<boolean> {
      return new Promise((resolve) => {
        confirmIcon.textContent = icon;
        confirmIcon.style.color = btnClass === 'modal-btn-danger' ? '#dc2626' : '#1c5fa8';
        confirmTitle.textContent = title;
        confirmText.textContent = text;
        confirmOk.textContent = btnLabel;
        confirmOk.className = `modal-btn ${btnClass}`;
        confirmResolve = resolve;
        confirmModal.hidden = false;
      });
    }

    confirmOk.addEventListener('click', () => { confirmModal.hidden = true; confirmResolve?.(true); });
    confirmCancel.addEventListener('click', () => { confirmModal.hidden = true; confirmResolve?.(false); });
    confirmClose.addEventListener('click', () => { confirmModal.hidden = true; confirmResolve?.(false); });

    filtersContainer.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.trash-filter') as HTMLButtonElement | null;
      if (!btn) return;
      filtersContainer.querySelectorAll('.trash-filter').forEach(f => f.classList.remove('active'));
      btn.classList.add('active');
      activeFilter = btn.dataset.filter!;
      render();
    });

    function daysRemaining(expiresAt: string | null): string {
      if (!expiresAt) return '—';
      const diff = new Date(expiresAt).getTime() - Date.now();
      const days = Math.ceil(diff / (1000 * 60 * 60 * 24));
      if (days <= 0) return 'Hoy expira';
      if (days === 1) return '1 día';
      return `${days} días`;
    }

    function formatDeleted(dateStr: string | null): string {
      if (!dateStr) return '—';
      return new Date(dateStr).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
    }

    async function fetchTrash(): Promise<TrashItemClient[]> {
      try {
        const resp = await fetch('/api/trash');
        const result = await resp.json();
        if (!result.ok) { console.error('[trash]', result.error); return []; }
        return result.items || [];
      } catch (err) {
        console.error('[trash] fetch error:', err);
        return [];
      }
    }

    async function permanentDelete(trashId: string): Promise<void> {
      const resp = await fetch(`/api/trash/${trashId}`, { method: 'DELETE' });
      if (!resp.ok) {
        const result = await resp.json();
        throw new Error(result.error || 'Error al eliminar');
      }
    }

    function render() {
      const filtered = activeFilter === 'all' ? items : items.filter(i => i.type === activeFilter);

      if (filtered.length === 0) {
        trashBody.innerHTML = '<tr><td colspan="5" class="trash-loading">La papelera está vacía.</td></tr>';
        return;
      }
      trashBody.innerHTML = filtered.map((item) => {
        const cfg = typeConfig[item.type] || { label: item.type, icon: 'help', color: '#64748b', bg: '#f8fafc' };
        let summary = '—';
        if (item.type === 'message') summary = (item.data as any)?.name || (item.data as any)?.contact || 'Mensaje';
        else if (item.type === 'admin') summary = (item.data as any)?.email || item.originalId;
        else if (item.type === 'poster') summary = (item.data as any)?.name || 'Poster';
        else if (item.type === 'hotel') summary = (item.data as any)?.name || 'Hotel';

        const isUrgent = daysRemaining(item.expiresAt).includes('Hoy');

        return `<tr>
          <td>
            <span class="trash-type-badge" style="background: ${cfg.bg}; color: ${cfg.color};">
              <span class="material-symbols-outlined trash-type-icon">${cfg.icon}</span>
              ${cfg.label}
            </span>
          </td>
          <td class="trash-summary">${summary}</td>
          <td class="trash-date">${formatDeleted(item.deletedAt)}</td>
          <td><span class="trash-expire ${isUrgent ? 'trash-expire--urgent' : ''}">${daysRemaining(item.expiresAt)}</span></td>
          <td class="trash-actions">
            <button class="trash-btn trash-btn-restore" data-action="restore" data-id="${item.id}" data-type="${item.type}" data-original="${item.originalId}" data-json='${JSON.stringify(item.data).replace(/'/g, "&#39;")}'>
              <span class="material-symbols-outlined">restore</span> Restaurar
            </button>
            <button class="trash-btn trash-btn-delete" data-action="delete" data-id="${item.id}" data-type="${item.type}">
              <span class="material-symbols-outlined">delete_forever</span> Eliminar
            </button>
          </td>
        </tr>`;
      }).join('');

      trashBody.querySelectorAll('.trash-btn').forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          const el = e.currentTarget as HTMLButtonElement;
          const action = el.dataset.action!;
          const id = el.dataset.id!;
          const type = el.dataset.type!;

          if (action === 'restore') {
            const originalId = el.dataset.original!;
            let data: Record<string, unknown>;
            try { data = JSON.parse(el.dataset.json!.replace(/&#39;/g, "'")); } catch { data = {}; }

            const cfg = typeConfig[type] || { label: type };
            const ok = await showConfirm(
              'help',
              `¿Restaurar ${cfg.label}?`,
              type === 'poster' ? 'El poster volverá a la galería si hay espacio disponible.' :
              type === 'hotel' ? 'El hotel volverá a la lista de hoteles.' :
              'El elemento volverá a su ubicación original.',
              'Restaurar',
              'modal-btn-primary'
            );
            if (!ok) return;

            if (type === 'poster') {
              try {
                const resp = await fetch(`/api/posters/restore/${id}`, { method: 'POST' });
                if (!resp.ok) {
                  const result = await resp.json();
                  alert(result.error || 'No se pudo restaurar');
                }
              } catch (err) {
                alert('Error al restaurar poster');
              }
            } else if (type === 'hotel') {
              try {
                const resp = await fetch(`/api/hotels/restore/${id}`, { method: 'POST' });
                if (!resp.ok) {
                  const result = await resp.json();
                  alert(result.error || 'No se pudo restaurar');
                }
              } catch (err) {
                alert('Error al restaurar hotel');
              }
            } else {
              await restoreFromTrash(id, type, originalId, data);
            }
            items = await fetchTrash();
            render();

          } else if (action === 'delete') {
            const ok = await showConfirm(
              'warning',
              '¿Eliminar permanentemente?',
              'Esta acción no se puede deshacer. El archivo se eliminará del servidor.',
              'Eliminar',
              'modal-btn-danger'
            );
            if (!ok) return;

            try {
              await permanentDelete(id);
            } catch (err: any) {
              alert(err.message);
            }
            items = await fetchTrash();
            render();
          }
        });
      });
    }

    (async () => {
      items = await fetchTrash();
      render();
    })();
  </script>

  <style>
    .trash-page { width: 100%; max-width: 1000px; margin: 0 auto; padding: 0 1rem; animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    .trash-header { margin-bottom: 1rem; padding-left: 0.5rem; }
    .trash-title { font-size: 1.5rem; font-weight: 700; color: #fff; margin: 0; }
    .trash-subtitle { font-size: 0.85rem; color: rgba(255,255,255,0.55); margin: 0.25rem 0 0; }

    .trash-filters { display: flex; gap: 0.5rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
    .trash-filter { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.45rem 0.9rem; border-radius: 10px; border: 1px solid rgba(255,255,255,0.18); background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.65); font-size: 0.8rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; backdrop-filter: blur(8px); }
    .trash-filter:hover { background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.9); }
    .trash-filter.active { background: rgba(255,255,255,0.22); color: #fff; border-color: rgba(255,255,255,0.35); }
    .trash-filter .material-symbols-outlined { font-size: 1rem; }

    .trash-card { background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); border-radius: 16px; border: 1px solid rgba(255,255,255,0.2); overflow: hidden; box-shadow: 0 4px 24px rgba(0,0,0,0.12); }

    :global(.trash-table) { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    :global(.trash-table th) { text-align: left; padding: 1rem 1.5rem; background: rgba(15,30,50,0.04); color: #475569; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid #e2e8f0; }
    :global(.trash-table td) { padding: 0.85rem 1.5rem; border-bottom: 1px solid #f1f5f9; color: #1e293b; vertical-align: middle; }

    :global(.trash-type-badge) { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border-radius: 8px; font-size: 0.78rem; font-weight: 700; white-space: nowrap; }
    :global(.trash-type-badge .trash-type-icon) { font-size: 1rem; }

    :global(.trash-summary) { font-weight: 600; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    :global(.trash-date) { color: #64748b; font-size: 0.8rem; white-space: nowrap; }
    :global(.trash-expire) { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.72rem; font-weight: 700; background: #f1f5f9; color: #475569; }
    :global(.trash-expire--urgent) { background: #fef2f2; color: #dc2626; }

    :global(.trash-actions) { display: flex; gap: 0.5rem; }
    :global(.trash-btn) { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.9rem; border-radius: 8px; border: none; font-size: 0.78rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
    :global(.trash-btn .material-symbols-outlined) { font-size: 1rem; }
    :global(.trash-btn-restore) { background: #dbeafe; color: #1d4ed8; }
    :global(.trash-btn-restore:hover) { background: #bfdbfe; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(29,78,216,0.2); }
    :global(.trash-btn-delete) { background: #fee2e2; color: #dc2626; }
    :global(.trash-btn-delete:hover) { background: #fecaca; transform: translateY(-1px); box-shadow: 0 2px 8px rgba(220,38,38,0.2); }

    :global(.trash-loading) { text-align: center; padding: 3rem 1rem; color: #94a3b8; font-style: italic; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1.5rem; }
    .modal-overlay[hidden] { display: none !important; }
    .modal-card { background: rgba(255,255,255,0.98); backdrop-filter: blur(20px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 25px 50px rgba(0,0,0,0.25); padding: 2rem; max-width: 100%; position: relative; animation: modalIn 0.2s ease; }
    @keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    .modal-close { position: absolute; top: 1rem; right: 1rem; width: 32px; height: 32px; border: none; border-radius: 8px; background: rgba(0,0,0,0.06); color: #64748b; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
    .modal-close:hover { background: rgba(0,0,0,0.1); color: #1e293b; }

    .confirm-modal-card { width: 380px; text-align: center; }
    .confirm-icon { font-size: 3rem; color: #1c5fa8; }
    .confirm-title { font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0.5rem 0 0.25rem; }
    .confirm-text { font-size: 0.9rem; color: #64748b; margin: 0 0 1.25rem; }
    .confirm-actions { display: flex; gap: 0.5rem; justify-content: center; }

    .modal-btn { padding: 0.6rem 1.4rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; font-family: inherit; cursor: pointer; border: none; transition: all 0.2s; }
    .modal-btn-primary { background: linear-gradient(135deg, #1c5fa8, #155088); color: #fff; }
    .modal-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(28,95,168,0.3); }
    .modal-btn-danger { background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; }
    .modal-btn-danger:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(220,38,38,0.3); }
    .modal-btn-cancel { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .modal-btn-cancel:hover { background: #e2e8f0; }

    @media (max-width: 768px) {
      .trash-page { padding: 0 0.5rem; }
      :global(.trash-table thead) { display: none; }
      :global(.trash-table), :global(.trash-table tbody), :global(.trash-table tr), :global(.trash-table td) { display: block; }
      :global(.trash-table tr) { padding: 1rem 1.5rem; border-bottom: 1px solid #e2e8f0; }
      :global(.trash-table td) { padding: 0.35rem 0; border: none; }
      :global(.trash-summary) { max-width: 100%; }
      :global(.trash-actions) { margin-top: 0.5rem; }
    }
  </style>
</AdminLayout>
