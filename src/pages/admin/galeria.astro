---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Galería - Azulia Admin">
  <div class="gal-page">
    <header class="gal-header">
      <div>
        <h1 class="gal-title">Galería de Posters</h1>
        <p class="gal-subtitle">Sube y administra imágenes promocionales</p>
      </div>
      <div class="gal-counter" id="counterBadge">
        <span id="counterText">0</span> / 10 posters
      </div>
    </header>

    <div class="gal-upload-card" id="uploadZone">
      <div class="gal-dropzone" id="dropZone">
        <span class="material-symbols-outlined gal-drop-icon">cloud_upload</span>
        <p class="gal-drop-text">Arrastra una imagen aquí o haz clic para seleccionar</p>
        <p class="gal-drop-hint">Todos los formatos de imagen · Máx 20 MB</p>
        <input type="file" id="fileInput" accept="image/*" hidden />
        <button class="gal-select-btn" id="selectBtn">Seleccionar archivo</button>
      </div>
      <div class="gal-preview" id="previewArea" hidden>
        <img id="previewImg" alt="Vista previa" />
        <div class="gal-preview-info">
          <input class="gal-name-input" id="nameInput" placeholder="Nombre del poster..." maxlength="60" />
          <div class="gal-progress-wrap" id="progressWrap" hidden>
            <div class="gal-progress-bar"><div class="gal-progress-fill" id="progressFill"></div></div>
            <span class="gal-progress-text" id="progressText">0%</span>
          </div>
          <div class="gal-preview-actions">
            <button class="gal-upload-btn" id="uploadBtn">Subir a galería</button>
            <button class="gal-cancel-btn" id="cancelBtn">Cancelar</button>
          </div>
        </div>
      </div>
      <div class="gal-error" id="uploadError" hidden></div>
    </div>

    <div class="gal-grid" id="galleryGrid">
      <p class="gal-loading">Cargando posters...</p>
    </div>
  </div>

  <div class="modal-overlay" id="posterModal" hidden>
    <div class="modal-card poster-modal-card">
      <button class="modal-close" id="modalClose">
        <span class="material-symbols-outlined">close</span>
      </button>
      <div class="poster-modal-body">
        <img id="modalImg" alt="Poster" class="poster-modal-img" />
        <div class="poster-modal-info">
          <label class="poster-modal-label">Nombre</label>
          <input class="poster-modal-input" id="modalNameInput" maxlength="60" />
          <p class="poster-modal-file" id="modalFilename"></p>
          <p class="poster-modal-date" id="modalDate"></p>
          <div class="poster-modal-actions">
            <button class="modal-btn modal-btn-primary" id="modalSave">Guardar</button>
            <button class="modal-btn modal-btn-danger" id="modalDelete">Eliminar</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="confirmModal" hidden>
    <div class="modal-card confirm-modal-card">
      <button class="modal-close" id="confirmClose">
        <span class="material-symbols-outlined">close</span>
      </button>
      <span class="material-symbols-outlined confirm-icon">warning</span>
      <h3 class="confirm-title" id="confirmTitle">¿Eliminar poster?</h3>
      <p class="confirm-text" id="confirmText">Se moverá a la papelera por 30 días.</p>
      <div class="confirm-actions">
        <button class="modal-btn modal-btn-cancel" id="confirmCancel">Cancelar</button>
        <button class="modal-btn modal-btn-danger" id="confirmOk">Eliminar</button>
      </div>
    </div>
  </div>

  <script>
    import { uploadPoster, deletePoster, renamePoster, getPostersFromDisk } from '../../lib/galeria';
    import type { UploadProgress } from '../../lib/galeria';

    let selectedFile: File | null = null;
    let uploadTask: { cancel: () => void } | null = null;
    let posterList: { id: string; name: string; filename: string; url: string; createdAt: Date | null }[] = [];
    let confirmResolve: ((ok: boolean) => void) | null = null;
    let currentEditId: string | null = null;

    const MAX_POSTERS = 10;

    const dropZone = document.getElementById('dropZone')!;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const selectBtn = document.getElementById('selectBtn')!;
    const previewArea = document.getElementById('previewArea')!;
    const previewImg = document.getElementById('previewImg') as HTMLImageElement;
    const nameInput = document.getElementById('nameInput') as HTMLInputElement;
    const uploadBtn = document.getElementById('uploadBtn')!;
    const cancelBtn = document.getElementById('cancelBtn')!;
    const progressWrap = document.getElementById('progressWrap')!;
    const progressFill = document.getElementById('progressFill')!;
    const progressText = document.getElementById('progressText')!;
    const uploadError = document.getElementById('uploadError')!;
    const galleryGrid = document.getElementById('galleryGrid')!;
    const counterText = document.getElementById('counterText')!;

    const posterModal = document.getElementById('posterModal')!;
    const modalClose = document.getElementById('modalClose')!;
    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalNameInput = document.getElementById('modalNameInput') as HTMLInputElement;
    const modalFilename = document.getElementById('modalFilename')!;
    const modalDate = document.getElementById('modalDate')!;
    const modalSave = document.getElementById('modalSave')!;
    const modalDelete = document.getElementById('modalDelete')!;

    const confirmModal = document.getElementById('confirmModal')!;
    const confirmClose = document.getElementById('confirmClose')!;
    const confirmTitle = document.getElementById('confirmTitle')!;
    const confirmText = document.getElementById('confirmText')!;
    const confirmCancel = document.getElementById('confirmCancel')!;
    const confirmOk = document.getElementById('confirmOk')!;

    function showError(msg: string) {
      uploadError.textContent = msg;
      uploadError.hidden = false;
    }

    function hideError() { uploadError.hidden = true; }

    function resetUpload() {
      selectedFile = null;
      uploadTask = null;
      previewArea.hidden = true;
      dropZone.hidden = false;
      progressWrap.hidden = true;
      uploadBtn.disabled = false;
      nameInput.value = '';
      fileInput.value = '';
      previewImg.src = '';
      hideError();
    }

    function handleFile(file: File) {
      hideError();
      if (!file.type.startsWith('image/')) { showError('Formato no soportado. Se aceptan todos los formatos de imagen.'); return; }
      if (file.size > 20 * 1024 * 1024) { showError('La imagen supera los 20 MB.'); return; }
      selectedFile = file;
      const reader = new FileReader();
      reader.onload = (e) => { previewImg.src = e.target!.result as string; };
      reader.readAsDataURL(file);
      dropZone.hidden = true;
      previewArea.hidden = false;
      const base = file.name.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ').replace(/\b\w/g, c => c.toUpperCase()).slice(0, 60);
      nameInput.value = base;
    }

    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('gal-dropzone--over'); });
    dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('gal-dropzone--over'); });
    dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('gal-dropzone--over'); if (e.dataTransfer?.files[0]) handleFile(e.dataTransfer.files[0]); });
    selectBtn.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) handleFile(fileInput.files[0]); });
    cancelBtn.addEventListener('click', resetUpload);

    uploadBtn.addEventListener('click', async () => {
      if (!selectedFile) return;
      const name = nameInput.value.trim() || selectedFile.name;
      hideError();
      progressWrap.hidden = false;
      progressFill.style.width = '0%';
      progressText.textContent = '0%';
      uploadBtn.disabled = true;

      uploadTask = uploadPoster(selectedFile, name, (state: UploadProgress) => {
        if (state.error) {
          showError(state.error);
          uploadBtn.disabled = false;
          progressWrap.hidden = true;
          return;
        }
        progressFill.style.width = state.progress + '%';
        progressText.textContent = state.progress + '%';
        if (state.id) {
          setTimeout(() => { resetUpload(); loadPosters(); }, 600);
        }
      });
    });

    function showConfirm(title: string, text: string): Promise<boolean> {
      return new Promise((resolve) => {
        confirmTitle.textContent = title;
        confirmText.textContent = text;
        confirmResolve = resolve;
        confirmModal.hidden = false;
      });
    }

    confirmOk.addEventListener('click', () => { confirmModal.hidden = true; confirmResolve?.(true); });
    confirmCancel.addEventListener('click', () => { confirmModal.hidden = true; confirmResolve?.(false); });
    confirmClose.addEventListener('click', () => { confirmModal.hidden = true; confirmResolve?.(false); });

    modalClose.addEventListener('click', () => { posterModal.hidden = true; });
    posterModal.addEventListener('click', (e) => { if (e.target === posterModal) posterModal.hidden = true; });

    modalSave.addEventListener('click', async () => {
      if (!currentEditId) return;
      const name = modalNameInput.value.trim();
      if (!name) return;
      await renamePoster(currentEditId, name);
      posterModal.hidden = true;
      loadPosters();
    });

    modalDelete.addEventListener('click', async () => {
      if (!currentEditId) return;
      const ok = await showConfirm('¿Eliminar este poster?', 'Se moverá a la papelera por 30 días.');
      if (ok) {
        await deletePoster(currentEditId);
        posterModal.hidden = true;
        loadPosters();
      }
    });

    async function loadPosters() {
      galleryGrid.innerHTML = '<p class="gal-loading">Cargando posters...</p>';
      posterList = await getPostersFromDisk();
      counterText.textContent = String(posterList.length);

      if (posterList.length === 0) {
        galleryGrid.innerHTML = '<p class="gal-empty">Aún no hay posters. Sube el primero.</p>';
        return;
      }

      galleryGrid.innerHTML = posterList.map((p) => `
        <div class="gal-item" data-id="${p.id}">
          <img src="${p.url || '/api/posters/image/' + p.filename}" alt="${p.name}" loading="lazy" />
          <div class="gal-item-overlay">
            <span class="gal-item-name">${p.name}</span>
          </div>
        </div>
      `).join('');

      galleryGrid.querySelectorAll('.gal-item').forEach((item) => {
        item.addEventListener('click', () => {
          const id = (item as HTMLElement).dataset.id!;
          const poster = posterList.find(p => p.id === id);
          if (!poster) return;
          currentEditId = id;
          modalImg.src = poster.url || '/api/posters/image/' + poster.filename;
          modalNameInput.value = poster.name;
          modalFilename.textContent = poster.filename;
          modalDate.textContent = poster.createdAt ? `Subido: ${poster.createdAt.toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' })}` : '';
          posterModal.hidden = false;
        });
      });
    }

    loadPosters();
  </script>

  <style>
    .gal-page { width: 100%; max-width: 1100px; animation: fadeIn 0.4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }

    .gal-header { margin-bottom: 1.5rem; display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
    .gal-title { font-size: 1.5rem; font-weight: 700; color: #fff; margin: 0; }
    .gal-subtitle { font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0.25rem 0 0; }
    .gal-counter { background: rgba(255,255,255,0.12); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.2); padding: 0.5rem 1rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; color: rgba(255,255,255,0.9); white-space: nowrap; }

    .gal-upload-card { background: rgba(255,255,255,0.95); backdrop-filter: blur(20px); border-radius: 16px; border: 1px solid rgba(255,255,255,0.2); padding: 2rem; margin-bottom: 2rem; box-shadow: 0 4px 24px rgba(0,0,0,0.12); }

    .gal-dropzone { border: 2px dashed #cbd5e1; border-radius: 12px; padding: 2.5rem 1.5rem; text-align: center; cursor: pointer; transition: all 0.2s; }
    .gal-dropzone:hover, .gal-dropzone--over { border-color: #1c5fa8; background: rgba(28,95,168,0.04); }
    .gal-drop-icon { font-size: 2.5rem; color: #94a3b8; }
    .gal-drop-text { font-size: 1rem; color: #475569; margin: 0.5rem 0 0.25rem; }
    .gal-drop-hint { font-size: 0.8rem; color: #94a3b8; margin: 0 0 1rem; }
    .gal-select-btn { padding: 0.6rem 1.5rem; border: none; border-radius: 10px; background: #1c5fa8; color: #fff; font-size: 0.9rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: background 0.2s; }
    .gal-select-btn:hover { background: #155088; }

    .gal-preview { display: flex; gap: 1.5rem; align-items: flex-start; }
    .gal-preview img { width: 180px; height: 120px; object-fit: cover; border-radius: 10px; border: 1px solid #e2e8f0; flex-shrink: 0; }
    .gal-preview-info { flex: 1; display: flex; flex-direction: column; gap: 0.75rem; }
    .gal-name-input { width: 100%; padding: 0.6rem 0.9rem; border: 2px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; font-family: inherit; color: #1e293b; transition: border-color 0.2s; box-sizing: border-box; }
    .gal-name-input:focus { outline: none; border-color: #1c5fa8; box-shadow: 0 0 0 3px rgba(28,95,168,0.1); }
    .gal-progress-wrap { display: flex; align-items: center; gap: 0.75rem; }
    .gal-progress-bar { flex: 1; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden; }
    .gal-progress-fill { height: 100%; width: 0%; background: linear-gradient(90deg, #1c5fa8, #217b96); border-radius: 3px; transition: width 0.3s ease; }
    .gal-progress-text { font-size: 0.8rem; font-weight: 600; color: #1c5fa8; min-width: 2.5rem; }
    .gal-preview-actions { display: flex; gap: 0.5rem; }
    .gal-upload-btn { padding: 0.55rem 1.2rem; border: none; border-radius: 10px; background: linear-gradient(135deg, #1c5fa8, #155088); color: #fff; font-size: 0.85rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; }
    .gal-upload-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(28,95,168,0.3); }
    .gal-upload-btn:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
    .gal-cancel-btn { padding: 0.55rem 1.2rem; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; color: #64748b; font-size: 0.85rem; font-weight: 600; font-family: inherit; cursor: pointer; transition: all 0.2s; }
    .gal-cancel-btn:hover { background: #f8fafc; border-color: #cbd5e1; }

    .gal-error { margin-top: 1rem; padding: 0.75rem 1rem; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; color: #dc2626; font-size: 0.85rem; font-weight: 500; }

    :global(.gal-grid) { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; max-width: 80vw; margin: 0 auto; }
    :global(.gal-loading), :global(.gal-empty) { grid-column: 1 / -1; text-align: center; padding: 3rem 1rem; color: rgba(255,255,255,0.6); font-style: italic; background: rgba(255,255,255,0.06); border-radius: 16px; }

    :global(.gal-item) { position: relative; border-radius: 12px; overflow: hidden; background: #0f172a; box-shadow: 0 2px 12px rgba(0,0,0,0.25); cursor: pointer; transition: all 0.25s ease; border: 2px solid rgba(255,255,255,0.06); width: 100%; }
    :global(.gal-item:hover) { transform: translateY(-3px); box-shadow: 0 6px 24px rgba(0,0,0,0.4); border-color: rgba(28,95,168,0.5); }
    :global(.gal-item img) { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 3 / 4; transition: transform 0.35s ease; }
    :global(.gal-item:hover img) { transform: scale(1.05); }
    :global(.gal-item-overlay) { position: absolute; bottom: 0; left: 0; right: 0; padding: 2rem 0.75rem 0.75rem; background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%); opacity: 0; transition: opacity 0.25s ease; pointer-events: none; }
    :global(.gal-item:hover .gal-item-overlay) { opacity: 1; }
    :global(.gal-item-name) { color: #fff; font-size: 0.8rem; font-weight: 600; text-shadow: 0 1px 4px rgba(0,0,0,0.5); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 1.5rem; }
    .modal-overlay[hidden] { display: none !important; }
    .modal-card { background: rgba(255,255,255,0.98); backdrop-filter: blur(20px); border-radius: 20px; border: 1px solid rgba(255,255,255,0.2); box-shadow: 0 25px 50px rgba(0,0,0,0.25); padding: 2rem; max-width: 100%; position: relative; animation: modalIn 0.2s ease; }
    @keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }
    .modal-close { position: absolute; top: 1rem; right: 1rem; width: 32px; height: 32px; border: none; border-radius: 8px; background: rgba(0,0,0,0.06); color: #64748b; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
    .modal-close:hover { background: rgba(0,0,0,0.1); color: #1e293b; }

    .poster-modal-card { width: 520px; max-width: 95vw; }
    .poster-modal-body { display: flex; flex-direction: column; gap: 1.25rem; padding-right: 2rem; }
    .poster-modal-img { width: 100%; max-height: 300px; object-fit: contain; border-radius: 12px; border: 1px solid #e2e8f0; background: #f8fafc; }
    .poster-modal-label { font-size: 0.8rem; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 0.35rem; display: block; }
    .poster-modal-input { width: 100%; padding: 0.65rem 0.9rem; border: 2px solid #e2e8f0; border-radius: 10px; font-size: 0.9rem; font-family: inherit; color: #1e293b; box-sizing: border-box; transition: border-color 0.2s; }
    .poster-modal-input:focus { outline: none; border-color: #1c5fa8; box-shadow: 0 0 0 3px rgba(28,95,168,0.1); }
    .poster-modal-file { font-size: 0.8rem; color: #94a3b8; margin: 0.5rem 0 0; }
    .poster-modal-date { font-size: 0.8rem; color: #94a3b8; margin: 0.25rem 0 0; }
    .poster-modal-actions { display: flex; gap: 0.5rem; margin-top: 0.5rem; }

    .confirm-modal-card { width: 360px; text-align: center; }
    .confirm-icon { font-size: 3rem; color: #dc2626; }
    .confirm-title { font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 0.5rem 0 0.25rem; }
    .confirm-text { font-size: 0.9rem; color: #64748b; margin: 0 0 1.25rem; }
    .confirm-actions { display: flex; gap: 0.5rem; justify-content: center; }

    .modal-btn { padding: 0.55rem 1.2rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; font-family: inherit; cursor: pointer; border: none; transition: all 0.2s; }
    .modal-btn-primary { background: linear-gradient(135deg, #1c5fa8, #155088); color: #fff; }
    .modal-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(28,95,168,0.3); }
    .modal-btn-danger { background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; }
    .modal-btn-danger:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(220,38,38,0.3); }
    .modal-btn-cancel { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }
    .modal-btn-cancel:hover { background: #e2e8f0; }

    @media (max-width: 1024px) {
      :global(.gal-grid) { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 768px) {
      .gal-header { flex-direction: column; }
      .gal-preview { flex-direction: column; align-items: stretch; }
      .gal-preview img { width: 100%; height: 180px; }
      :global(.gal-grid) { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; max-width: 90vw; }
      .poster-modal-body { padding-right: 0; }
    }
    @media (max-width: 480px) {
      :global(.gal-grid) { grid-template-columns: 1fr; gap: 0.6rem; max-width: 95vw; }
    }
  </style>
</AdminLayout>
