---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import { carRentalBenefits, carRentalHeroImages } from "../../components/data/transportation/car_rental_data";
import "../../assets/styles/car_rental.css";
---

<Layout>
    <Navbar />

    <main class="car-rental-page">
        <section class="car-hero">
            <div class="car-hero-images" data-car-hero-track>
                {carRentalHeroImages.map((src, index) => (
                    <img
                        src={src}
                        alt={`Renta de autos en Bacalar ${index + 1}`}
                        class:list={["car-hero-image", { active: index === 0 }]}
                    />
                ))}
            </div>
            <div class="car-hero-overlay"></div>
            <div class="car-hero-content">
                <span class="car-hero-tag">
                    <span class="material-symbols-outlined" aria-hidden="true">car_rental</span>
                    Renta de autos Azulia
                </span>
                <h1>Conduce Bacalar con estilo, seguridad y libertad total</h1>
                <p>
                    Encuentra el auto ideal para tus rutas por la laguna, escapadas de fin de
                    semana o viajes ejecutivos. Reserva facil y soporte local para todo tu trayecto.
                </p>
                <a href="#flota-autos" class="car-hero-cta">
                    Ver flota disponible
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_downward</span>
                </a>
            </div>
        </section>

        <section class="car-benefits">
            <div class="car-benefits-grid">
                {carRentalBenefits.map((benefit) => (
                    <article class="benefit-card">
                        <span class="material-symbols-outlined" aria-hidden="true">{benefit.icon}</span>
                        <h2>{benefit.title}</h2>
                        <p>{benefit.description}</p>
                    </article>
                ))}
            </div>
        </section>

        <section class="fleet-section" id="flota-autos">
            <div class="fleet-inner">
                <header class="fleet-heading">
                    <span>Flota destacada</span>
                    <h2>Modelos listos para tu proximo viaje</h2>
                </header>

                <div class="fleet-grid" id="fleetGrid">
                    <div class="fleet-loading">Cargando flota...</div>
                </div>

                <div class="fleet-pagination" aria-label="Paginacion de flota">
                    <button type="button" class="pagination-btn" data-page-prev>
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                        Anterior
                    </button>
                    <div class="pagination-pages" data-pagination-pages></div>
                    <button type="button" class="pagination-btn" data-page-next>
                        Siguiente
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>
                </div>
                <p class="fleet-page-status" data-page-status aria-live="polite"></p>
            </div>
        </section>

        <div id="carModalsContainer"></div>
    </main>

    <Footer />
</Layout>

<script>
    const carHeroImages = document.querySelectorAll<HTMLImageElement>(".car-hero-image");
    const fleetGrid = document.getElementById("fleetGrid")!;
    const pageContainer = document.querySelector<HTMLElement>("[data-pagination-pages]");
    const prevPageBtn = document.querySelector<HTMLButtonElement>("[data-page-prev]");
    const nextPageBtn = document.querySelector<HTMLButtonElement>("[data-page-next]");
    const pageStatus = document.querySelector<HTMLElement>("[data-page-status]");
    const modalsContainer = document.getElementById("carModalsContainer")!;

    let allCars: any[] = [];
    let currentPage = 1;
    let cardsPerPage = 5;
    let totalPages = 1;
    let currentHero = 0;

    if (carHeroImages.length > 1) {
        setInterval(() => {
            carHeroImages[currentHero].classList.remove("active");
            currentHero = (currentHero + 1) % carHeroImages.length;
            carHeroImages[currentHero].classList.add("active");
        }, 6200);
    }

    function escHtml(s: string) {
        const d = document.createElement("div");
        d.textContent = s;
        return d.innerHTML;
    }

    function isValidImageUrl(url: string): boolean {
        if (!url || typeof url !== 'string') return false;
        if (url.startsWith('blob:')) return true;
        if (url.startsWith('http://') || url.startsWith('https://')) return true;
        if (url.startsWith('/api/cars/image/')) return true;
        return false;
    }

    function renderCards() {
        if (!allCars.length) {
            fleetGrid.innerHTML = '<div class="fleet-loading">No hay autos disponibles.</div>';
            return;
        }

        fleetGrid.innerHTML = allCars.map(car => {
            const stars = "★".repeat(Math.round(car.rating || 0));
            const allImages = Array.isArray(car.images) ? car.images.filter(isValidImageUrl) : [];
            const img = allImages[0] || "";
            return `<article class="car-card" data-car-id="${car.id}" role="button" tabindex="0">
                <div class="car-card-top">
                    <span class="car-chip">${escHtml(car.highlight || "")}</span>
                    ${img ? `<img src="${escHtml(img)}" alt="${escHtml(car.model)} ${car.year || ""}" class="car-image" loading="lazy" referrerpolicy="no-referrer" />` : `<div class="car-image car-image-placeholder"><span class="material-symbols-outlined">directions_car</span></div>`}
                </div>
                <div class="car-card-body">
                    <h3>${escHtml(car.model)}</h3>
                    <p class="car-model-year">Modelo ${car.year} · ${escHtml(car.type)}</p>
                    <div class="car-rating">
                        <span class="stars">${stars}</span>
                        <span class="score">${(car.rating || 0).toFixed(1)} / 5</span>
                    </div>
                    <div class="car-spec-row">
                        <span>${car.seats || 5} pasajeros</span>
                        <span>${car.doors || 4} puertas</span>
                        <span>${escHtml(car.transmission || "Automatica")}</span>
                    </div>
                    <div class="car-card-footer">
                        <p class="car-price">$${(car.pricePerDay || 0).toLocaleString("es-MX")} <small>/ dia</small></p>
                        <button class="car-card-btn" type="button" data-open-car-modal="${car.id}">Ver detalle</button>
                    </div>
                </div>
            </article>`;
        }).join("");

        attachCardListeners();
    }

    function renderModals() {
        modalsContainer.innerHTML = allCars.map(car => {
            const stars = "★".repeat(Math.round(car.rating || 0));
            const features = (car.features || []).map((f: string) => `<span>${escHtml(f)}</span>`).join("");
            const validImages = Array.isArray(car.images) ? car.images.filter(isValidImageUrl) : [];
            const images = validImages.map((img: string, i: number) =>
                `<img src="${escHtml(img)}" alt="${escHtml(car.model)} ${i + 1}" class="car-modal-img${i === 0 ? ' active' : ''}" loading="lazy" referrerpolicy="no-referrer" />`
            ).join("");
            const hasNav = validImages.length > 1;
            return `<div id="car-modal-${car.id}" class="car-modal-overlay" role="dialog" aria-modal="true">
                <div class="car-modal-content">
                    <button class="car-modal-close" type="button" aria-label="Cerrar modal">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                    <div class="car-modal-gallery">
                        ${images}
                        ${hasNav ? `<div class="car-modal-nav">
                            <button class="car-modal-prev" type="button"><span class="material-symbols-outlined">chevron_left</span></button>
                            <span class="car-modal-counter">1 / ${validImages.length}</span>
                            <button class="car-modal-next" type="button"><span class="material-symbols-outlined">chevron_right</span></button>
                        </div>` : ''}
                    </div>
                    <div class="car-modal-details">
                        <p class="car-modal-eyebrow">${escHtml(car.type)} ${car.year}</p>
                        <h3>${escHtml(car.model)}</h3>
                        <div class="car-modal-rating"><span class="stars">${stars}</span><span>${(car.rating || 0).toFixed(1)} / 5</span></div>
                        <p class="car-modal-description">${escHtml(car.shortDescription || "")}</p>
                        <div class="car-modal-spec-grid">
                            <div class="spec-item"><span>Motor</span><strong>${escHtml(car.engine || "")}</strong></div>
                            <div class="spec-item"><span>Pasajeros</span><strong>${car.seats || 5}</strong></div>
                            <div class="spec-item"><span>Consumo</span><strong>${escHtml(car.consumption || "")}</strong></div>
                            <div class="spec-item"><span>Puertas</span><strong>${car.doors || 4}</strong></div>
                            <div class="spec-item"><span>Tipo</span><strong>${escHtml(car.type)}</strong></div>
                            <div class="spec-item"><span>Transmision</span><strong>${escHtml(car.transmission || "")}</strong></div>
                            <div class="spec-item"><span>Traccion</span><strong>${escHtml(car.drivetrain || "")}</strong></div>
                            <div class="spec-item"><span>Combustible</span><strong>${escHtml(car.fuel || "")}</strong></div>
                            <div class="spec-item"><span>Equipaje</span><strong>${escHtml(car.luggage || "")}</strong></div>
                            <div class="spec-item"><span>Velocidad maxima</strong><strong>${escHtml(car.topSpeed || "")}</strong></div>
                        </div>
                        <div class="car-modal-feature-list">${features}</div>
                        <div class="car-modal-footer">
                            <p>Desde <strong>$${(car.pricePerDay || 0).toLocaleString("es-MX")} MXN</strong> / dia</p>
                            <button type="button" class="car-modal-cta" data-car-contact>Reservar este auto</button>
                        </div>
                    </div>
                </div>
            </div>`;
        }).join("");

        attachModalListeners();
    }

    const calculateCardsPerPage = () => {
        if (!fleetGrid) return 5;
        const minCardWidth = 250;
        const columns = Math.max(1, Math.floor(fleetGrid.clientWidth / minCardWidth));
        const rows = window.innerWidth < 640 ? 3 : 2;
        return Math.max(1, columns * rows);
    };

    const recalculatePagination = () => {
        cardsPerPage = calculateCardsPerPage();
        totalPages = Math.max(1, Math.ceil(allCars.length / cardsPerPage));
        if (currentPage > totalPages) currentPage = totalPages;
    };

    const renderPagination = () => {
        if (!pageContainer) return;
        pageContainer.innerHTML = "";
        for (let page = 1; page <= totalPages; page++) {
            const button = document.createElement("button");
            button.type = "button";
            button.textContent = String(page);
            button.className = "pagination-number";
            button.dataset.page = String(page);
            button.classList.toggle("active", page === currentPage);
            button.addEventListener("click", () => { currentPage = page; updateVisibleCards(); });
            pageContainer.appendChild(button);
        }
    };

    const updateVisibleCards = () => {
        recalculatePagination();
        const cards = Array.from(fleetGrid.querySelectorAll<HTMLElement>(".car-card"));
        const start = (currentPage - 1) * cardsPerPage;
        const end = start + cardsPerPage;
        cards.forEach((card, index) => {
            card.style.display = index >= start && index < end ? "block" : "none";
        });
        prevPageBtn?.toggleAttribute("disabled", currentPage === 1);
        nextPageBtn?.toggleAttribute("disabled", currentPage === totalPages);
        if (pageStatus) {
            pageStatus.textContent = `Pagina ${currentPage} de ${totalPages} · ${cardsPerPage} autos por vista · ${allCars.length} modelos disponibles`;
        }
        renderPagination();
    };

    prevPageBtn?.addEventListener("click", () => { if (currentPage > 1) { currentPage--; updateVisibleCards(); } });
    nextPageBtn?.addEventListener("click", () => { if (currentPage < totalPages) { currentPage++; updateVisibleCards(); } });
    window.addEventListener("resize", () => updateVisibleCards());

    function openCarModal(id: string) {
        const modal = document.getElementById(`car-modal-${id}`);
        if (!modal) return;
        modal.classList.add("open");
        document.body.style.overflow = "hidden";
    }

    function closeCarModal(modal: HTMLElement) {
        modal.classList.remove("open");
        document.body.style.overflow = "";
    }

    function attachCardListeners() {
        fleetGrid.querySelectorAll<HTMLElement>(".car-card").forEach(card => {
            const id = card.dataset.carId;
            if (!id) return;
            card.addEventListener("click", () => openCarModal(id));
            card.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openCarModal(id); } });
        });
        fleetGrid.querySelectorAll<HTMLElement>("[data-open-car-modal]").forEach(btn => {
            btn.addEventListener("click", e => { e.stopPropagation(); openCarModal(btn.dataset.openCarModal!); });
        });
    }

    function attachModalListeners() {
        modalsContainer.querySelectorAll<HTMLElement>(".car-modal-overlay").forEach(modal => {
            const closeBtn = modal.querySelector<HTMLButtonElement>(".car-modal-close");
            const images = modal.querySelectorAll<HTMLImageElement>(".car-modal-img");
            const prevBtn = modal.querySelector<HTMLButtonElement>(".car-modal-prev");
            const nextBtn = modal.querySelector<HTMLButtonElement>(".car-modal-next");
            const counter = modal.querySelector<HTMLElement>(".car-modal-counter");
            let current = 0;
            const showImage = (index: number) => {
                images.forEach((img, i) => img.classList.toggle("active", i === index));
                if (counter) counter.textContent = `${index + 1} / ${images.length}`;
            };
            prevBtn?.addEventListener("click", () => { current = current > 0 ? current - 1 : images.length - 1; showImage(current); });
            nextBtn?.addEventListener("click", () => { current = current < images.length - 1 ? current + 1 : 0; showImage(current); });
            closeBtn?.addEventListener("click", () => { current = 0; showImage(0); closeCarModal(modal); });
            modal.addEventListener("click", e => { if (e.target === modal) { current = 0; showImage(0); closeCarModal(modal); } });
        });
        modalsContainer.querySelectorAll('[data-car-contact]').forEach(btn => {
            btn.addEventListener('click', () => (window as any).openContactModal('Renta de auto'));
        });
    }

    document.addEventListener("keydown", e => {
        if (e.key !== "Escape") return;
        const opened = document.querySelector<HTMLElement>(".car-modal-overlay.open");
        if (opened) closeCarModal(opened);
    });

    async function loadFleet() {
        try {
            const res = await fetch("/api/cars");
            const data = await res.json();
            if (data.ok && data.cars?.length) {
                allCars = data.cars;
            } else {
                const { carRentalFleet } = await import("../../components/data/transportation/car_rental_data");
                allCars = carRentalFleet;
            }
        } catch {
            const { carRentalFleet } = await import("../../components/data/transportation/car_rental_data");
            allCars = carRentalFleet;
        }
        renderCards();
        renderModals();
        updateVisibleCards();
    }

    loadFleet();
</script>
