---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import TransportDestinationModal from "../../components/transport_destination_modal.astro";
import {
    internationalDestinations,
    internationalHeroImages,
} from "../../components/data/transportation/international_data";
import {
    internationalDeparturePoints,
    internationalTransportTypes,
} from "../../components/data/transportation/form_data";
---

<Layout>
    <Navbar />

    <main class="transport-international-page">
        <section class="international-hero">
            <div class="hero-images">
                {internationalHeroImages.map((src, i) => (
                    <img
                        src={src}
                        alt={`Transporte internacional ${i + 1}`}
                        class:list={["hero-img", { active: i === 0 }]}
                    />
                ))}
            </div>
            <div class="hero-overlay" />
            <div class="hero-content">
                <span class="hero-tag">Belice · Guatemala · Honduras</span>
                <h1>Transporte Internacional</h1>
                <p>
                    Traslados desde Quintana Roo hacia ciudades principales de Centroamérica,
                    con logística de frontera y rutas planificadas.
                </p>
                <a href="#destinos-internacionales" class="hero-cta">
                    Ver destinos
                    <span class="material-symbols-outlined">arrow_downward</span>
                </a>
            </div>
        </section>

        <section class="destinations-section" id="destinos-internacionales">
            <div class="container">
                <header class="section-header">
                    <span class="section-eyebrow">Cruces internacionales</span>
                    <h2>Ciudades principales de Belice, Guatemala y Honduras</h2>
                    <p>
                        Selecciona un destino para revisar transporte internacional, tiempos,
                        costos aproximados y recomendaciones de documentación.
                    </p>
                </header>

                <div class="destinations-grid">
                    {internationalDestinations.map((destination) => (
                        <article class="destination-card" data-id={destination.id} role="button" tabindex="0">
                            <div class="card-image-wrap">
                                <img src={destination.image} alt={destination.name} loading="lazy" />
                                <span class="card-region">{destination.region}</span>
                            </div>
                            <div class="card-body">
                                <div class="card-title-row">
                                    <span class="material-symbols-outlined">{destination.icon}</span>
                                    <h3>{destination.name}</h3>
                                </div>
                                <p>{destination.shortDescription}</p>
                                <div class="card-highlight">{destination.highlight}</div>
                                <button class="card-btn" type="button" data-id={destination.id}>
                                    Ver transporte
                                    <span class="material-symbols-outlined">arrow_forward</span>
                                </button>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        </section>

        {internationalDestinations.map((destination) => (
            <TransportDestinationModal
                destination={destination}
                transportTypes={internationalTransportTypes}
                departurePoints={internationalDeparturePoints}
                contactHref="/wha-options"
            />
        ))}
    </main>

    <Footer />
</Layout>

<style>
    @import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200");

    * {
        font-family: Arial, Helvetica, sans-serif;
    }

    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: normal;
        font-style: normal;
        line-height: 1;
        display: inline-block;
        letter-spacing: normal;
        text-transform: none;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-smoothing: antialiased;
    }

    .transport-international-page {
        background: linear-gradient(180deg, #f4fbff 0%, #edf7ff 100%);
    }

    .international-hero {
        position: relative;
        height: clamp(460px, 76vh, 680px);
        overflow: hidden;
    }

    .hero-images {
        position: absolute;
        inset: 0;
    }

    .hero-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.85s ease;
    }

    .hero-img.active {
        opacity: 1;
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            130deg,
            rgba(15, 53, 84, 0.92) 0%,
            rgba(34, 112, 154, 0.77) 46%,
            rgba(34, 112, 154, 0.2) 78%,
            rgba(34, 112, 154, 0) 100%
        );
    }

    .hero-content {
        position: relative;
        z-index: 2;
        height: 100%;
        max-width: min(900px, 92%);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        justify-content: center;
        color: #fff;
    }

    .hero-tag {
        width: fit-content;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.34);
        border-radius: 999px;
        padding: 0.45rem 0.95rem;
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin-bottom: 0.95rem;
    }

    .hero-content h1 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1.05;
    }

    .hero-content p {
        margin: 1rem 0 0;
        max-width: 700px;
        font-size: clamp(0.98rem, 1.95vw, 1.16rem);
        line-height: 1.66;
        color: rgba(255, 255, 255, 0.93);
    }

    .hero-cta {
        margin-top: 1.35rem;
        width: fit-content;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #ffffff;
        color: #1b5e94;
        font-weight: 700;
        border-radius: 999px;
        padding: 0.74rem 1.15rem;
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
    }

    .hero-cta .material-symbols-outlined {
        font-size: 1.1rem;
    }

    .destinations-section {
        padding: 4.2rem 1.2rem 4.5rem;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 2.3rem;
    }

    .section-eyebrow {
        display: inline-block;
        color: #217b96;
        font-size: 0.79rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        margin-bottom: 0.55rem;
    }

    .section-header h2 {
        margin: 0;
        color: #173754;
        font-size: clamp(1.65rem, 3.2vw, 2.35rem);
    }

    .section-header p {
        margin: 0.8rem auto 0;
        color: #4e667c;
        max-width: 750px;
        line-height: 1.65;
    }

    .destinations-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
        gap: 1rem;
    }

    .destination-card {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #cbe2f0;
        background: #fff;
        box-shadow: 0 14px 28px rgba(17, 69, 112, 0.1);
        transition: transform 0.24s ease, box-shadow 0.24s ease;
        cursor: pointer;
    }

    .destination-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 36px rgba(17, 69, 112, 0.16);
    }

    .card-image-wrap {
        position: relative;
        height: 178px;
    }

    .card-image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card-region {
        position: absolute;
        right: 0.55rem;
        top: 0.55rem;
        border-radius: 999px;
        background: rgba(19, 66, 103, 0.82);
        color: #fff;
        font-size: 0.72rem;
        padding: 0.35rem 0.58rem;
        border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .card-body {
        padding: 0.85rem 0.9rem 1rem;
    }

    .card-title-row {
        display: flex;
        align-items: center;
        gap: 0.35rem;
    }

    .card-title-row .material-symbols-outlined {
        color: #1b6f8e;
        font-size: 1.2rem;
    }

    .card-title-row h3 {
        margin: 0;
        color: #19496f;
        font-size: 1.16rem;
    }

    .card-body p {
        margin: 0.55rem 0;
        color: #4f677d;
        line-height: 1.58;
        font-size: 0.9rem;
    }

    .card-highlight {
        display: inline-block;
        color: #1f6f8f;
        background: #e9f7fb;
        border: 1px solid #c2e6f2;
        border-radius: 999px;
        font-size: 0.74rem;
        padding: 0.34rem 0.58rem;
        margin-bottom: 0.75rem;
    }

    .card-btn {
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 0.27rem;
        border-radius: 999px;
        background: linear-gradient(135deg, #2675a5 0%, #217b96 100%);
        color: #fff;
        padding: 0.52rem 0.92rem;
        font-size: 0.84rem;
        font-weight: 700;
        cursor: pointer;
    }

    .card-btn .material-symbols-outlined {
        font-size: 1rem;
    }

    @media (max-width: 768px) {
        .hero-content {
            text-align: center;
            align-items: center;
        }

        .hero-content p {
            max-width: 94%;
        }
    }
</style>

<script>
    const heroImages = document.querySelectorAll<HTMLImageElement>(".hero-img");
    let heroCurrent = 0;

    if (heroImages.length > 1) {
        setInterval(() => {
            heroImages[heroCurrent].classList.remove("active");
            heroCurrent = (heroCurrent + 1) % heroImages.length;
            heroImages[heroCurrent].classList.add("active");
        }, 7000);
    }

    function openTransportModal(id: string) {
        const modal = document.getElementById(`transport-modal-${id}`);
        if (!modal) return;
        resetTransportForm(modal);
        modal.classList.add("open");
        document.body.style.overflow = "hidden";
    }

    function resetTransportForm(modal: HTMLElement) {
        const typeSelect = modal.querySelector<HTMLSelectElement>("[data-transport-type]");
        const originGroup = modal.querySelector<HTMLElement>("[data-origin-group]");
        const originSelect = modal.querySelector<HTMLSelectElement>("[data-origin]");
        const passengersInput = modal.querySelector<HTMLInputElement>("[data-passengers]");
        const capacityAlert = modal.querySelector<HTMLElement>("[data-capacity-alert]");
        const formContact = modal.querySelector<HTMLElement>("[data-form-contact]");

        if (typeSelect) typeSelect.value = "";
        if (originSelect) {
            originSelect.disabled = false;
            originSelect.value = "";
        }
        originGroup?.classList.remove("is-hidden");

        if (passengersInput) passengersInput.value = "1";
        capacityAlert?.classList.remove("show");
        formContact?.classList.remove("show");
    }

    function syncTransportFormState(modal: HTMLElement) {
        const typeSelect = modal.querySelector<HTMLSelectElement>("[data-transport-type]");
        const originGroup = modal.querySelector<HTMLElement>("[data-origin-group]");
        const originSelect = modal.querySelector<HTMLSelectElement>("[data-origin]");
        const passengersInput = modal.querySelector<HTMLInputElement>("[data-passengers]");
        const capacityAlert = modal.querySelector<HTMLElement>("[data-capacity-alert]");
        const formContact = modal.querySelector<HTMLElement>("[data-form-contact]");

        if (typeSelect && originGroup) {
            const isUber = typeSelect.value === "uber";
            originGroup.classList.toggle("is-hidden", isUber);
            if (originSelect) {
                originSelect.disabled = isUber;
                if (isUber) originSelect.value = "";
            }
        }

        if (passengersInput) {
            let amount = Number(passengersInput.value || "1");
            if (!Number.isFinite(amount) || amount < 1) amount = 1;
            if (amount > 12) amount = 12;
            passengersInput.value = String(amount);
            capacityAlert?.classList.toggle("show", amount >= 12);

            const typeOk = Boolean(typeSelect?.value);
            const originOk = typeSelect?.value === "uber" ? true : Boolean(originSelect?.value);
            const passengersOk = amount >= 1 && amount <= 12;
            formContact?.classList.toggle("show", typeOk && originOk && passengersOk);
        }
    }

    function closeTransportModal(modal: HTMLElement) {
        modal.classList.remove("open");
        document.body.style.overflow = "";
    }

    document.querySelectorAll<HTMLElement>(".destination-card").forEach((card) => {
        const id = card.dataset.id;
        if (!id) return;

        card.addEventListener("click", () => openTransportModal(id));
        card.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                openTransportModal(id);
            }
        });
    });

    document.querySelectorAll<HTMLElement>(".card-btn").forEach((btn) => {
        const id = btn.dataset.id;
        if (!id) return;

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            openTransportModal(id);
        });
    });

    document.querySelectorAll<HTMLElement>(".tdm-overlay").forEach((modal) => {
        const closeBtn = modal.querySelector<HTMLElement>(".tdm-close");
        const images = modal.querySelectorAll<HTMLImageElement>(".tdm-img");
        const prevBtn = modal.querySelector<HTMLElement>(".tdm-prev");
        const nextBtn = modal.querySelector<HTMLElement>(".tdm-next");
        const counter = modal.querySelector<HTMLElement>(".tdm-counter");
        const typeSelect = modal.querySelector<HTMLSelectElement>("[data-transport-type]");
        const originSelect = modal.querySelector<HTMLSelectElement>("[data-origin]");
        const passengersInput = modal.querySelector<HTMLInputElement>("[data-passengers]");
        let current = 0;

        const show = (index: number) => {
            images.forEach((img, i) => img.classList.toggle("active", i === index));
            if (counter) counter.textContent = `${index + 1} / ${images.length}`;
        };

        prevBtn?.addEventListener("click", () => {
            current = current > 0 ? current - 1 : images.length - 1;
            show(current);
        });

        nextBtn?.addEventListener("click", () => {
            current = current < images.length - 1 ? current + 1 : 0;
            show(current);
        });

        typeSelect?.addEventListener("change", () => syncTransportFormState(modal));
        originSelect?.addEventListener("change", () => syncTransportFormState(modal));
        passengersInput?.addEventListener("input", () => syncTransportFormState(modal));
        passengersInput?.addEventListener("blur", () => syncTransportFormState(modal));

        closeBtn?.addEventListener("click", () => {
            current = 0;
            show(0);
            closeTransportModal(modal);
        });

        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                current = 0;
                show(0);
                closeTransportModal(modal);
            }
        });

        syncTransportFormState(modal);
    });

    document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const openModal = document.querySelector<HTMLElement>(".tdm-overlay.open");
        if (openModal) closeTransportModal(openModal);
    });
</script>
