---
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <Navbar />
    <main>
        <section class="transportation-hero">
            <div class="container hero-grid">
                <div class="hero-copy">
                    <br />
                    <span class="eyebrow">Movilidad sin límites</span>
                    <h1>Transportación nacional e internacional</h1>
                    <p>
                        Encuentra opciones seguras, cómodas y confiables para
                        tus viajes dentro de México, hacia Belice y el sur del
                        país. Ideal para tus aventuras.
                    </p>
                    <div class="hero-buttons">
                        <a href="#servicios" class="btn btn-primary"
                            >Ver servicios</a
                        >
                        <a href="#destinos" class="btn btn-secondary"
                            >Destinos destacados</a
                        >
                    </div>
                </div>
                <!-- !cards que no me gustaron, pueden servir para otra cosa -->
                <!-- <div class="hero-cards">
                    <div class="hero-card highlight">
                        <h3>Transporte Nacional</h3>
                        <p>
                            Rutas por toda la República con opciones de lujo y
                            económica.
                        </p>
                    </div>
                    <div class="hero-card">
                        <h3>Transporte Internacional</h3>
                        <p>
                            Vuelos directos, conexiones terrestres y traslados
                            VIP a Belice.
                        </p>
                    </div>
                    <div class="hero-card">
                        <h3>Privado y Público</h3>
                        <p>
                            Desde servicio privado en coche hasta autobuses y
                            taxis confiables.
                        </p>
                    </div> -->
            </div>
        </section>
    </main>

    <section id="servicios" class="transportation-services">
        <div class="container">
            <h2>Opciones de transporte</h2>
            <p class="section-copy">
                Selecciona el servicio que mejor se adapte a tu viaje.
                Trabajamos con las rutas y plataformas más seguras para un
                traslado cómodo y puntual.
            </p>
            <div class="service-grid">
                <!-- ! creo que no habian transportes privados -->
                <!-- <article class="service-card">
                    <div class="service-icon">🚗</div>
                    <h3>Privada</h3>
                    <p>
                        Traslados exclusivos con chofer, vehículos de lujo y
                        recogida a la puerta de tu hotel o aeropuerto.
                    </p>
                </article> -->
                <article class="service-card">
                    <div class="service-icon">🚕</div>
                    <h3>Taxi</h3>
                    <p>
                        Servicio seguro y rápido para trayectos urbanos y
                        recorridos cortos en tus destinos favoritos.
                    </p>
                </article>
                <article class="service-card">
                    <div class="service-icon">🚍</div>
                    <h3>Mayab</h3>
                    <p>
                        Rutas confiables en autobuses turísticos y de enlace
                        para conocer ciudades, ruinas y zonas arqueológicas.
                    </p>
                </article>
                <article class="service-card">
                    <div class="service-icon">🚍</div>
                    <h3>ADO</h3>
                    <p>
                        Autobuses de lujo ADO para viajes largos con mayor
                        comodidad, entretenimiento y servicio premium.
                    </p>
                </article>
                <article class="service-card">
                    <div class="service-icon">📱</div>
                    <h3>Uber / Rideshare</h3>
                    <p>
                        Viajes rápidos y seguros dentro de la ciudad con pago
                        digital y seguimiento en tiempo real.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <section class="transportation-destinations" id="destinos">
        <div class="container">
            <div class="section-header">
                <h2>Destinos básicos y turísticos</h2>
                <p>
                    Explora los principales puntos para tus itinerarios de
                    viaje: destinos cercanos, aventuras en Belice, el sur de
                    México y ruinas históricas.
                </p>
            </div>

            <div class="destinations-table-wrapper">
                <table class="destinations-table">
                    <thead>
                        <tr>
                            <th>Destino</th>
                            <th>Zona</th>
                            <th>Tipo de viaje</th>
                            <th>Recomendación</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Chetumal</td>
                            <td>Básicos</td>
                            <td>Ciudad / aeropuerto</td>
                            <td>Traslado rápido desde la frontera</td>
                        </tr>
                        <tr>
                            <td>Playa del Carmen</td>
                            <td>Básicos</td>
                            <td>Turístico</td>
                            <td>Óptimo en Uber o taxi compartido</td>
                        </tr>
                        <tr>
                            <td>Caye Caulker</td>
                            <td>Belice</td>
                            <td>Isla / ferry</td>
                            <td>Combinación terrestre y marítima</td>
                        </tr>
                        <tr>
                            <td>Belice Ciudad</td>
                            <td>Belice</td>
                            <td>Internacional</td>
                            <td>Opciones terrestres con cruces fronterizos</td>
                        </tr>
                        <tr>
                            <td>Tulum</td>
                            <td>Sur de México</td>
                            <td>Turístico</td>
                            <td>Ideal en transporte privado o ADO</td>
                        </tr>
                        <tr>
                            <td>Mahahual</td>
                            <td>Sur de México</td>
                            <td>Playa / marina</td>
                            <td>Servicio de van compartida recomendado</td>
                        </tr>
                        <tr>
                            <td>Ruinas de Tulum</td>
                            <td>Ruinas</td>
                            <td>Cultural</td>
                            <td>Traslado con guía y llegada temprana</td>
                        </tr>
                        <tr>
                            <td>Chichén Itzá</td>
                            <td>Ruinas</td>
                            <td>Excursión de día</td>
                            <td>Perfecto en tour privado</td>
                        </tr>
                        <tr>
                            <td>Reserva Sian Ka'an</td>
                            <td>Lugares turísticos</td>
                            <td>Natural</td>
                            <td>Recomendado con transporte ecológico</td>
                        </tr>
                        <tr>
                            <td>Isla Holbox</td>
                            <td>Lugares turísticos</td>
                            <td>Playa / aventura</td>
                            <td>Taxi + ferry para la mejor llegada</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="destination-highlights">
                <article class="highlight-card">
                    <h3>Rutas esenciales en Belice</h3>
                    <ul>
                        <li>
                            Lorem ipsum dolor sit amet, consectetur adipisicing
                            elit. Molestias, quia ullam eum labore ab facilis
                            blanditiis quae a ratione! Dolore, consequuntur
                            excepturi distinctio animi commodi explicabo
                            voluptas voluptate voluptatem ut?
                        </li>
                        <!-- <li>Campeche ↔ Chetumal ↔ Belice Ciudad</li>
                        <li>Belice Ciudad ↔ San Ignacio ↔ San Pedro</li>
                        <li>Traslados combinados con ferry a Caye Caulker</li> -->
                    </ul>
                </article>
                <article class="highlight-card">
                    <h3>Sur de México en grande</h3>
                    <ul>
                        <li>
                            Lorem ipsum dolor sit amet consectetur adipisicing
                            elit. Quia debitis vitae unde quae minima alias,
                            repellat totam ducimus ratione dolorem facere porro
                            accusantium eveniet dicta, maiores ab. Quibusdam,
                            veritatis tempora!
                        </li>
                        <!-- <li>Cancún ↔ Tulum ↔ Bacalar</li>
                        <li>Mahahual ↔ Playa del Carmen ↔ Chetumal</li>
                        <li>
                            Vuelos y autobuses premium ADO para adultos y
                            familias
                        </li> -->
                    </ul>
                </article>
                <article class="highlight-card">
                    <h3>Ruinas y atracciones</h3>
                    <ul>
                        <li>
                            Lorem ipsum dolor sit, amet consectetur adipisicing
                            elit. Quod quia velit sequi beatae ducimus
                            asperiores voluptatum labore voluptatibus, fuga
