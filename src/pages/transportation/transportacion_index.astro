                            pariatur accusamus! Rem!
                        </li>
                        <!-- <li>Tulum, Chichén Itzá, Cobá y Ek Balam</li>
                        <li>Excursiones seguras con transporte climatizado</li>
                        <li>Guías locales y paradas en lugares fotográficos</li> -->
                    </ul>
                </article>
            </div>
        </div>
    </section>
</Layout>
<Footer />

<style>
    * {
        font-family: Arial, Helvetica, sans-serif;
    }

    :global(body) {
        background: linear-gradient(180deg, #eef7ff 0%, #ffffff 100%);
    }

    .transportation-hero {
        padding: 4rem 2rem 2rem;
        background: linear-gradient(135deg, #1d4f91, #4a90e2);
        color: white;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 2rem;
        align-items: center;
    }

    .hero-copy .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: rgba(255, 255, 255, 0.85);
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 0.9rem;
    }

    .hero-copy h1 {
        font-size: clamp(2.6rem, 4vw, 4rem);
        line-height: 1.05;
        margin-bottom: 1.25rem;
    }

    .hero-copy p {
        max-width: 680px;
        margin-bottom: 2rem;
        color: rgba(255, 255, 255, 0.92);
        line-height: 1.7;
    }

    .hero-buttons {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn {
        padding: 0.95rem 1.6rem;
        border-radius: 999px;
        font-weight: 700;
        text-decoration: none;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn-primary {
        background: #ffb400;
        color: #1c2733;
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.18);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.35);
    }

    .hero-cards {
        display: grid;
        gap: 1.2rem;
    }

    .hero-card {
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 24px;
        padding: 2rem;
        min-height: 170px;
        box-shadow: 0 18px 50px rgba(14, 44, 77, 0.12);
    }

    .hero-card.highlight {
        background: rgba(255, 255, 255, 0.2);
        border-color: rgba(255, 255, 255, 0.28);
    }

    .hero-card h3 {
        margin-bottom: 0.8rem;
        font-size: 1.35rem;
    }

    .hero-card p {
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.9);
    }

    .transportation-services,
    .transportation-destinations {
        padding: 3.5rem 2rem;
    }

    .transportation-services {
        background: #f7fbff;
    }

    .transportation-services h2,
    .transportation-destinations h2 {
        font-size: 2.3rem;
        margin-bottom: 0.75rem;
        color: #142d47;
    }

    .section-copy {
        max-width: 760px;
        color: #52667f;
        margin-bottom: 2rem;
        line-height: 1.8;
    }

    .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1.5rem;
    }

    .service-card {
        background: white;
        border-radius: 22px;
        padding: 1.8rem;
        box-shadow: 0 12px 28px rgba(33, 64, 99, 0.08);
        border: 1px solid #e0ecf6;
    }

    .service-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
    }

    .service-card h3 {
        margin-bottom: 0.8rem;
        color: #173d5e;
    }

    .service-card p {
        color: #5f7186;
        line-height: 1.75;
    }

    .destinations-table-wrapper {
        overflow-x: auto;
        margin-top: 2rem;
    }

    .destinations-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 680px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 14px 40px rgba(31, 69, 103, 0.08);
    }

    .destinations-table th,
    .destinations-table td {
        padding: 1rem 1.2rem;
        text-align: left;
    }

    .destinations-table thead {
        background: #1d4f91;
        color: white;
    }

    .destinations-table tbody tr {
        border-bottom: 1px solid #eff3f8;
    }

    .destinations-table tbody tr:nth-child(even) {
        background: #f8fbff;
    }

    .destinations-table td {
        color: #334862;
    }

    .section-header {
        max-width: 820px;
    }

    .destination-highlights {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        margin-top: 2.5rem;
    }

    .highlight-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 1.8rem;
        box-shadow: 0 18px 38px rgba(34, 82, 123, 0.08);
        border: 1px solid #dde8f3;
    }

    .highlight-card h3 {
        font-size: 1.3rem;
        margin-bottom: 1rem;
        color: #173d5e;
    }

    .highlight-card ul {
        list-style: inside disc;
        color: #4b5f75;
        line-height: 1.8;
    }

    @media (max-width: 900px) {
        .hero-grid {
            grid-template-columns: 1fr;
        }

        .hero-copy {
            text-align: center;
        }

        .hero-buttons {
            justify-content: center;
        }
    }

    @media (max-width: 640px) {
        .hero-card,
        .service-card,
        .highlight-card {
            padding: 1.5rem;
        }

        .destinations-table th,
        .destinations-table td {
            padding: 0.9rem 0.9rem;
        }
    }
</style>
