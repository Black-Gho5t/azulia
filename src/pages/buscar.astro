---
import Footer from "../components/footer.astro";
import Navbar from "../components/navigation.astro";
import {
    searchableCards,
    searchablePhotos,
} from "../components/data/search/search_index_data";
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Buscador de Experiencias | Azulia Tours, Hoteles y Autos en Bacalar"
    description="Encuentra fácilmente cualquier tour, hotel, auto en renta o traslado privado en Bacalar y el Caribe mexicano con el buscador de Azulia."
>
    <Navbar />

    <div
        id="buscar-root"
        data-cards={JSON.stringify(searchableCards)}
        data-photos={JSON.stringify(searchablePhotos)}
    >
        <!-- ══════════ HERO SEARCH ══════════ -->
        <section class="bsr-hero">
            <div class="bsr-hero-content">
                <p class="bsr-eyebrow">
                    <span class="material-symbols-outlined" aria-hidden="true">search</span>
                    Buscador
                </p>
                <h1 class="bsr-title">¿Qué estás buscando?</h1>
                <p class="bsr-subtitle">Tours, hoteles, transportación y renta de autos — todo en un lugar.</p>

                <div class="bsr-input-row">
                    <span class="material-symbols-outlined bsr-input-icon" aria-hidden="true">search</span>
                    <input
                        id="bsr-input"
                        type="search"
                        class="bsr-input"
                        placeholder="Escribe un destino, tour o servicio…"
                        autocomplete="off"
                        spellcheck="false"
                    />
                    <button id="bsr-clear" class="bsr-clear-btn" type="button" aria-label="Limpiar" hidden>
                        <span class="material-symbols-outlined" aria-hidden="true">close</span>
                    </button>
                </div>

                <div class="bsr-chips">
                    <button class="bsr-chip" type="button" data-term="nauticos">
                        <span class="material-symbols-outlined" aria-hidden="true">anchor</span>Náuticos
                    </button>
                    <button class="bsr-chip" type="button" data-term="hotel">
                        <span class="material-symbols-outlined" aria-hidden="true">hotel</span>Hoteles
                    </button>
                    <button class="bsr-chip" type="button" data-term="ruinas">
                        <span class="material-symbols-outlined" aria-hidden="true">account_balance</span>Ruinas
                    </button>
                    <button class="bsr-chip" type="button" data-term="renta">
                        <span class="material-symbols-outlined" aria-hidden="true">car_rental</span>Renta de autos
                    </button>
                    <button class="bsr-chip" type="button" data-term="cancun">
                        <span class="material-symbols-outlined" aria-hidden="true">flight_takeoff</span>Cancún
                    </button>
                    <button class="bsr-chip" type="button" data-term="belice">
                        <span class="material-symbols-outlined" aria-hidden="true">water</span>Belice
                    </button>
                </div>
            </div>
        </section>

        <!-- ══════════ RESULTS AREA ══════════ -->
        <div class="bsr-body">

            <!-- Empty / no-query state -->
            <div id="bsr-empty" class="bsr-empty">
                <span class="material-symbols-outlined bsr-empty-icon" aria-hidden="true">travel_explore</span>
                <p class="bsr-empty-text">Usa el buscador o elige una categoría de arriba para comenzar.</p>
            </div>

            <!-- No results state (hidden by default) -->
            <div id="bsr-noresults" class="bsr-empty" hidden>
                <span class="material-symbols-outlined bsr-empty-icon bsr-empty-icon--warn" aria-hidden="true">search_off</span>
                <p class="bsr-empty-text">Sin resultados para <strong id="bsr-nr-query"></strong>.</p>
                <p class="bsr-empty-hint">Prueba con términos más generales o revisa la ortografía.</p>
            </div>

            <!-- Results: cards -->
            <section id="bsr-cards-section" class="bsr-section" hidden>
                <header class="bsr-section-header">
                    <h2 class="bsr-section-title">
                        <span class="material-symbols-outlined" aria-hidden="true">grid_view</span>
                        Tours y servicios
                    </h2>
                    <span id="bsr-cards-badge" class="bsr-badge">0</span>
                </header>
                <div id="bsr-cards-body"></div>
            </section>

            <!-- Results: photos -->
            <section id="bsr-photos-section" class="bsr-section" hidden>
                <header class="bsr-section-header">
                    <h2 class="bsr-section-title">
                        <span class="material-symbols-outlined" aria-hidden="true">photo_library</span>
                        Galería de fotos
                    </h2>
                    <span id="bsr-photos-badge" class="bsr-badge">0</span>
                </header>
                <div id="bsr-photos-body"></div>
            </section>

        </div>
    </div>

    <Footer />
</Layout>

<!-- ══════════════════════════════════════════════════════════
     SCRIPT — live search logic
══════════════════════════════════════════════════════════ -->
<script>
    (() => {
        /* ── Data ── */
        const root       = document.getElementById("buscar-root")!;
        const cardsData  = JSON.parse(root.dataset.cards  || "[]");
        const photosData = JSON.parse(root.dataset.photos || "[]");
        const cardsMap   = new Map(cardsData.map((c: any) => [c.id, c]));

        /* ── DOM refs ── */
        const inputEl          = document.getElementById("bsr-input")          as HTMLInputElement;
        const clearBtn         = document.getElementById("bsr-clear")          as HTMLButtonElement;
        const emptyEl          = document.getElementById("bsr-empty")          as HTMLElement;
        const noResultsEl      = document.getElementById("bsr-noresults")      as HTMLElement;
        const nrQueryEl        = document.getElementById("bsr-nr-query")       as HTMLElement;
        const cardsSectionEl   = document.getElementById("bsr-cards-section")  as HTMLElement;
        const photosSectionEl  = document.getElementById("bsr-photos-section") as HTMLElement;
        const cardsBodyEl      = document.getElementById("bsr-cards-body")     as HTMLElement;
        const photosBodyEl     = document.getElementById("bsr-photos-body")    as HTMLElement;
        const cardsBadgeEl     = document.getElementById("bsr-cards-badge")    as HTMLElement;
        const photosBadgeEl    = document.getElementById("bsr-photos-badge")   as HTMLElement;

        /* ── Helpers ── */
        const esc = (s: string) =>
            String(s ?? "").replace(/[&<>"']/g, (c) =>
                ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] ?? c)
            );

        const norm = (s: string) =>
            String(s ?? "")
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/[^a-z0-9\s]/g, " ")
                .replace(/\s+/g, " ")
                .trim();

        const groupBy = (items: any[], key: string) => {
            const map = new Map<string, any[]>();
            for (const item of items) {
                const k = item[key] || "General";
                if (!map.has(k)) map.set(k, []);
                map.get(k)!.push(item);
            }
            return [...map.entries()]
                .sort((a, b) => a[0].localeCompare(b[0]))
                .map(([area, values]) => ({ area, values }));
        };

        const collageClass = (i: number, total: number) => {
            if (total === 1) return "normal";
            if (i === 0) return "wide";
            if (i === total - 1 && total > 3) return "wide";
            if (i % 4 === 1 || i % 4 === 3) return "tall";
            return "normal";
        };

        /* ── Render helpers ── */
        function renderCardGroup(group: { area: string; values: any[] }) {
            return `
            <div class="bsr-group">
                <h3 class="bsr-group-label">${esc(group.area)}</h3>
                <div class="bsr-card-grid">
                    ${group.values.map((item) => `
                        <button class="bsr-card" type="button" data-card-id="${esc(item.id)}">
                            <div class="bsr-card-img">
                                <img src="${esc(item.image)}" alt="${esc(item.title)}" loading="lazy" referrerpolicy="no-referrer" />
                            </div>
                            <div class="bsr-card-body">
                                <span class="bsr-card-area">${esc(item.area)}</span>
                                <strong class="bsr-card-title">${esc(item.title)}</strong>
                                <p class="bsr-card-desc">${esc(item.description)}</p>
                            </div>
                            <div class="bsr-card-foot">
                                <span>Ver detalle</span>
                                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                            </div>
                        </button>
                    `).join("")}
                </div>
            </div>`;
        }

        function renderPhotoGroup(group: { area: string; values: any[] }) {
            const total = group.values.length;
            return `
            <div class="bsr-group">
                <h3 class="bsr-group-label">${esc(group.area)}</h3>
                <div class="bsr-collage">
                    ${group.values.map((item, i) => `
                        <a href="${esc(item.href)}" class="bsr-collage-cell bsr-collage-cell--${collageClass(i, total)}">
                            <img src="${esc(item.image)}" alt="${esc(item.title)}" loading="lazy" referrerpolicy="no-referrer" />
                            <div class="bsr-collage-caption">${esc(item.title)}</div>
                        </a>
                    `).join("")}
                </div>
            </div>`;
        }

        /* ── Search ── */
        function runSearch(rawQuery: string) {
            const terms = norm(rawQuery).split(" ").filter(Boolean);

            /* update URL silently */
            const url = new URL(location.href);
            terms.length ? url.searchParams.set("q", rawQuery) : url.searchParams.delete("q");
            history.replaceState(null, "", url);

            /* show/hide clear button */
            clearBtn.hidden = !rawQuery;

            if (!terms.length) {
                emptyEl.hidden       = false;
                noResultsEl.hidden   = true;
                cardsSectionEl.hidden  = true;
                photosSectionEl.hidden = true;
                return;
            }

            const cardHits = cardsData.filter((item: any) => {
                const hay = norm([item.title, item.description, item.area, ...(item.keywords ?? [])].join(" "));
                return terms.every((t: string) => hay.includes(t));
            });

            const photoHits = photosData.filter((item: any) => {
                const hay = norm([item.title, item.description, item.area].join(" "));
                return terms.every((t: string) => hay.includes(t));
            });

            const total = cardHits.length + photoHits.length;

            emptyEl.hidden = true;

            if (total === 0) {
                noResultsEl.hidden     = false;
                nrQueryEl.textContent  = `"${rawQuery}"`;
                cardsSectionEl.hidden  = true;
                photosSectionEl.hidden = true;
                return;
            }

            noResultsEl.hidden = true;

            /* Cards */
            if (cardHits.length) {
                cardsBadgeEl.textContent = String(cardHits.length);
                cardsBodyEl.innerHTML = groupBy(cardHits, "area").map(renderCardGroup).join("");
                cardsSectionEl.hidden = false;
            } else {
                cardsSectionEl.hidden = true;
            }

            /* Photos */
            if (photoHits.length) {
                photosBadgeEl.textContent = String(photoHits.length);
                photosBodyEl.innerHTML = groupBy(photoHits, "area").map(renderPhotoGroup).join("");
                photosSectionEl.hidden = false;
            } else {
                photosSectionEl.hidden = true;
            }
        }

        /* ── Card click ── */
        cardsBodyEl.addEventListener("click", (e) => {
            const btn = (e.target as Element).closest<HTMLElement>(".bsr-card[data-card-id]");
            if (!btn) return;
            const item = cardsMap.get(btn.dataset.cardId!);
            if (item?.href) location.href = item.href;
        });

        /* ── Input events ── */
        inputEl.addEventListener("input", () => runSearch(inputEl.value));
        clearBtn.addEventListener("click", () => {
            inputEl.value = "";
            runSearch("");
            inputEl.focus();
        });

        /* ── Chips ── */
        document.querySelectorAll<HTMLButtonElement>(".bsr-chip[data-term]").forEach((chip) => {
            chip.addEventListener("click", () => {
                inputEl.value = chip.dataset.term!;
                runSearch(chip.dataset.term!);
                inputEl.focus();
            });
        });

        /* ── Init from URL ── */
        const initQ = new URLSearchParams(location.search).get("q") ?? "";
        if (initQ) {
            inputEl.value = initQ;
            runSearch(initQ);
        }
    })();
</script>

<!-- ══════════════════════════════════════════════════════════
     STYLES
══════════════════════════════════════════════════════════ -->
<style is:global>
/* ─── Page shell ─── */
#buscar-root {
    min-height: 100vh;
    background: #f4f8fc;
    font-family: Inter, system-ui, -apple-system, sans-serif;
}

/* ─── Hero ─── */
.bsr-hero {
    background: linear-gradient(135deg, #1a5fa0 0%, #155293 45%, #0e3e75 100%);
    padding: 7rem 1.5rem 3.5rem;
    position: relative;
    overflow: hidden;
}

/* Subtle radial glow */
.bsr-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 60% at 60% 120%, rgba(168, 230, 247, 0.14), transparent);
    pointer-events: none;
}

.bsr-hero-content {
    max-width: 740px;
    margin: 0 auto;
    position: relative;
}

.bsr-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #a8e6f7;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.9rem;
}

.bsr-eyebrow .material-symbols-outlined {
    font-size: 1.1rem !important;
}

.bsr-title {
    margin: 0 0 0.5rem;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
    line-height: 1.15;
}

.bsr-subtitle {
    margin: 0 0 2rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 1.05rem;
    line-height: 1.5;
}

/* ─── Input row ─── */
.bsr-input-row {
    position: relative;
    display: flex;
    align-items: center;
}

.bsr-input-icon {
    position: absolute;
    left: 1.1rem;
    color: #5b9dc8;
    font-size: 1.35rem !important;
    pointer-events: none;
    transition: color 0.2s;
}

.bsr-input:focus ~ .bsr-input-icon,
.bsr-input-row:focus-within .bsr-input-icon {
    color: #a8e6f7;
}

.bsr-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    border-radius: 14px;
    padding: 1rem 3.2rem 1rem 3.25rem;
    font-size: 1.05rem;
    color: #fff;
    font-family: inherit;
    outline: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    caret-color: #a8e6f7;
}

.bsr-input::placeholder { color: rgba(255,255,255,0.45); }
.bsr-input::-webkit-search-cancel-button { display: none; }

.bsr-input:focus {
    border-color: rgba(168, 230, 247, 0.7);
    background: rgba(255, 255, 255, 0.16);
    box-shadow: 0 0 0 4px rgba(168, 230, 247, 0.12);
}

.bsr-clear-btn {
    position: absolute;
    right: 0.75rem;
    background: rgba(255, 255, 255, 0.14);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.75);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    padding: 0;
}

.bsr-clear-btn:hover { background: rgba(255,255,255,0.22); color: #fff; }
.bsr-clear-btn .material-symbols-outlined { font-size: 1.15rem !important; }

/* ─── Chips ─── */
.bsr-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
}

.bsr-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.18s, border-color 0.18s, color 0.18s, transform 0.15s;
    letter-spacing: 0.01em;
}

.bsr-chip .material-symbols-outlined { font-size: 1.05rem !important; color: #a8e6f7; }

.bsr-chip:hover {
    background: rgba(168, 230, 247, 0.18);
    border-color: rgba(168, 230, 247, 0.5);
    color: #fff;
    transform: translateY(-1px);
}

/* ─── Body / results container ─── */
.bsr-body {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
}

/* ─── Empty / no-results ─── */
.bsr-empty {
    text-align: center;
    padding: 4rem 1rem;
    color: #4e6a82;
}

.bsr-empty-icon {
    font-size: 3.5rem !important;
    color: #9bb8ce;
    display: block;
    margin: 0 auto 1rem;
}

.bsr-empty-icon--warn { color: #b48a8a; }

.bsr-empty-text {
    margin: 0 0 0.4rem;
    font-size: 1.1rem;
    color: #3a5669;
    font-weight: 500;
}

.bsr-empty-text strong { color: #1a3d55; }

.bsr-empty-hint {
    margin: 0;
    font-size: 0.9rem;
    color: #7896ab;
}

/* ─── Section ─── */
.bsr-section {
    margin-bottom: 3rem;
}

.bsr-section-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 2px solid #dae8f3;
}

.bsr-section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    color: #0d3060;
    letter-spacing: -0.01em;
}

.bsr-section-title .material-symbols-outlined {
    font-size: 1.4rem !important;
    color: #1c5fa8;
}

.bsr-badge {
    margin-left: auto;
    background: #daeaf8;
    color: #1a5fa0;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 700;
    flex-shrink: 0;
}

/* ─── Group ─── */
.bsr-group {
    margin-bottom: 2rem;
}

.bsr-group-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #5b7f9a;
    margin: 0 0 1rem;
    padding-left: 2px;
}

/* ─── Card grid ─── */
.bsr-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1.25rem;
}

/* ─── Card ─── */
.bsr-card {
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 0;
    border: 1.5px solid rgba(28, 95, 168, 0.08);
    border-radius: 20px;
    overflow: hidden;
    background: linear-gradient(180deg, #fff 0%, #f7fbff 100%);
    box-shadow: 0 6px 20px rgba(18, 52, 90, 0.06);
    cursor: pointer;
    transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                border-color 0.22s;
    width: 100%;
    font-family: inherit;
    color: inherit;
}

.bsr-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 38px rgba(18, 52, 90, 0.13);
    border-color: rgba(28, 95, 168, 0.18);
}

.bsr-card:focus-visible {
    outline: 3px solid rgba(28, 95, 168, 0.3);
    outline-offset: 3px;
}

.bsr-card-img {
    height: 188px;
    overflow: hidden;
    background: #dde9f5;
    flex-shrink: 0;
}

.bsr-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.bsr-card:hover .bsr-card-img img { transform: scale(1.06); }

.bsr-card-body {
    padding: 1rem 1.1rem 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}

.bsr-card-area {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #1c5fa8;
    background: #daeaf8;
    border-radius: 6px;
    padding: 0.2rem 0.55rem;
    align-self: flex-start;
}

.bsr-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #0d2540;
    line-height: 1.35;
    letter-spacing: -0.01em;
}

.bsr-card-desc {
    margin: 0;
    font-size: 0.87rem;
    color: #566b7e;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.bsr-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    margin-top: 0.5rem;
    border-top: 1px solid rgba(28, 95, 168, 0.07);
    font-size: 0.85rem;
    font-weight: 600;
    color: #1a5fa0;
}

.bsr-card-foot .material-symbols-outlined {
    font-size: 1.1rem !important;
    transition: transform 0.2s;
}

.bsr-card:hover .bsr-card-foot .material-symbols-outlined {
    transform: translateX(4px);
}

/* ─── Photo collage ─── */
.bsr-collage {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 190px;
    gap: 10px;
    border-radius: 16px;
    overflow: hidden;
}

.bsr-collage-cell {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    text-decoration: none;
    display: block;
}

.bsr-collage-cell--normal { grid-column: span 1; grid-row: span 1; }
.bsr-collage-cell--tall   { grid-column: span 1; grid-row: span 2; }
.bsr-collage-cell--wide   { grid-column: span 2; grid-row: span 1; }

.bsr-collage-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.bsr-collage-cell:hover img { transform: scale(1.07); }

.bsr-collage-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1rem 1rem 0.75rem;
    background: linear-gradient(to top, rgba(8, 22, 42, 0.82) 0%, transparent 100%);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.3;
    opacity: 0;
