---
import Footer from "../components/footer.astro";
import Navbar from "../components/navigation.astro";
import {
    searchableCards,
    searchablePhotos,
} from "../components/data/search/search_index_data";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <Navbar />
    <main class="search-page">
        <section class="search-hero">
            <div class="search-hero-inner">
                <h1 id="searchTitle">Resultados para: <span>sin término</span></h1>
                <p id="searchSummary" class="search-summary">
                    Escribe una palabra clave para buscar en tours, hoteles, transportación y renta de autos.
                </p>
                <form action="/buscar" method="GET" class="search-form">
                    <input
                        type="search"
                        id="searchInput"
                        name="q"
                        placeholder="Ejemplo: kayak, ruinas, hotel, suv, frontera"
                        autocomplete="off"
                    />
                    <button type="submit">Buscar</button>
                </form>
            </div>
        </section>

        <section id="emptyState" class="search-empty-state">
            <h2>Comienza con una palabra clave</h2>
            <p>Prueba con: "nauticos", "calakmul", "hotel", "cancun", "camry".</p>
        </section>

        <section id="cardsBlock" class="search-results cards-block" hidden>
            <div class="result-block-heading">
                <h2>Cards encontrados</h2>
                <span id="cardsCountBadge" class="count-badge">0</span>
            </div>
            <div id="cardsGroupsContainer"></div>
        </section>

        <section id="photosBlock" class="search-results photos-block" hidden>
            <div class="result-block-heading">
                <h2>Fotos por palabra clave</h2>
                <span id="photosCountBadge" class="count-badge">0</span>
            </div>
            <div id="photosGroupsContainer"></div>
        </section>

    </main>
    <Footer />
</Layout>

<script define:vars={{ searchableCards, searchablePhotos }}>
    const cardsData = searchableCards;
    const photosData = searchablePhotos;

    const titleEl = document.getElementById("searchTitle");
    const summaryEl = document.getElementById("searchSummary");
    const inputEl = document.getElementById("searchInput");
    const emptyStateEl = document.getElementById("emptyState");
    const cardsBlockEl = document.getElementById("cardsBlock");
    const photosBlockEl = document.getElementById("photosBlock");
    const cardsGroupsEl = document.getElementById("cardsGroupsContainer");
    const photosGroupsEl = document.getElementById("photosGroupsContainer");
    const cardsCountBadgeEl = document.getElementById("cardsCountBadge");
    const photosCountBadgeEl = document.getElementById("photosCountBadge");
    const cardsMap = new Map(cardsData.map((item) => [item.id, item]));

    const normalize = (value) =>
        value
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9\s]/g, " ")
            .replace(/\s+/g, " ")
            .trim();

    const escapeHtml = (value) =>
        value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");

    const groupByArea = (items) => {
        const groups = new Map();

        items.forEach((item) => {
            const list = groups.get(item.area) ?? [];
            list.push(item);
            groups.set(item.area, list);
        });

        return Array.from(groups.entries()).map(([area, values]) => ({
            area,
            values,
            count: values.length,
        }));
    };

    const query = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
    const terms = normalize(query)
        .split(" ")
        .filter(Boolean);

    if (inputEl) inputEl.value = query;

    if (titleEl) {
        titleEl.innerHTML = `Resultados para: <span>${query ? escapeHtml(query) : "sin término"}</span>`;
    }

    if (terms.length === 0) {
        if (cardsBlockEl) cardsBlockEl.hidden = true;
        if (photosBlockEl) photosBlockEl.hidden = true;
        if (emptyStateEl) emptyStateEl.hidden = false;
    } else {
        const cardMatches = cardsData.filter((item) => {
            const haystack = normalize(
                [item.title, item.description, item.area, item.keywords.join(" ")].join(" "),
            );
            return terms.every((term) => haystack.includes(term));
        });

        const photoMatches = photosData.filter((item) => {
            const byDescription = normalize(item.description);
            const byTitle = normalize(item.title);
            return terms.every((term) => byDescription.includes(term) || byTitle.includes(term));
        });

        const cardGroups = groupByArea(cardMatches);
        const photoGroups = groupByArea(photoMatches);
        const total = cardMatches.length + photoMatches.length;

        if (summaryEl) {
            summaryEl.textContent = `${total} resultado(s) encontrados: ${cardMatches.length} cards y ${photoMatches.length} fotos.`;
        }

        if (cardsCountBadgeEl) cardsCountBadgeEl.textContent = String(cardMatches.length);
        if (photosCountBadgeEl) photosCountBadgeEl.textContent = String(photoMatches.length);

        if (cardsGroupsEl) {
            cardsGroupsEl.innerHTML = cardGroups.length
                ? cardGroups
                      .map(
                          (group) => `
                        <div class="result-group">
                            <header class="result-group-head">
                                <h3>${escapeHtml(group.area)}</h3>
                                <span class="group-count">${group.count} resultado(s)</span>
                            </header>
                            <div class="search-card-grid">
                                ${group.values
                                    .map(
                                        (item) => `
                                    <button type="button" class="search-card-item" data-card-id="${escapeHtml(item.id)}">
                                        <div class="sci-image">
                                            <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" referrerpolicy="no-referrer" />
                                        </div>
                                        <div class="sci-body">
                                            <span class="sci-kicker">${escapeHtml(item.area)}</span>
                                            <h4 class="sci-title">${escapeHtml(item.title)}</h4>
                                            <p class="sci-desc">${escapeHtml(item.description)}</p>
                                            <span class="sci-action">Ver detalle &rarr;</span>
                                        </div>
                                    </button>
                                `,
                                    )
                                    .join("")}
                            </div>
                        </div>
                    `,
                      )
                      .join("")
                : '<p class="result-empty">No hay cards que coincidan con tu búsqueda.</p>';
        }

        const getCollageSpan = (i, total) => {
            if (total === 1) return "normal";
            if (i === 0) return "wide";
            if (i === total - 1 && total > 3) return "wide";
            if (i % 4 === 1 || i % 4 === 3) return "tall";
            return "normal";
        };

        if (photosGroupsEl) {
            photosGroupsEl.innerHTML = photoGroups.length
                ? photoGroups
                      .map(
                          (group) => `
                        <div class="result-group">
                            <header class="result-group-head">
                                <h3>${escapeHtml(group.area)}</h3>
                                <span class="group-count">${group.count} foto(s)</span>
                            </header>
                            <div class="collage-grid">
                                ${group.values
                                    .map(
                                        (item, i) => `
                                    <a
                                        href="${escapeHtml(item.href)}"
                                        class="collage-cell collage-cell--${getCollageSpan(i, group.values.length)}"
                                    >
                                        <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" referrerpolicy="no-referrer" class="collage-img" />
                                        <div class="collage-overlay">
                                            <span class="collage-caption">${escapeHtml(item.title)}</span>
                                        </div>
                                    </a>
                                `,
                                    )
                                    .join("")}
                            </div>
                        </div>
                    `,
                      )
                      .join("")
                : '<p class="result-empty">No hay fotos cuya descripción coincida.</p>';
        }

        if (cardsBlockEl) cardsBlockEl.hidden = false;
        if (photosBlockEl) photosBlockEl.hidden = false;
        if (emptyStateEl) emptyStateEl.hidden = true;
    }

    cardsGroupsEl?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const cardButton = target.closest(".search-card-item[data-card-id]");
        if (!cardButton) return;

        const itemId = cardButton.getAttribute("data-card-id");
        if (!itemId) return;
        const item = cardsMap.get(itemId);
        if (!item) return;

        window.open(item.href, "_self");
    });
</script>

<style is:global>
    .search-page {
        background: radial-gradient(circle at 18% 9%, rgba(33, 123, 150, 0.22), transparent 36%),
            linear-gradient(180deg, #edf6fd 0%, #f7fbff 55%, #ffffff 100%);
        min-height: 100vh;
        padding-bottom: 3rem;
        font-family: Arial, Helvetica, sans-serif;
    }

    .search-hero {
        padding: 6.5rem 1rem 2rem;
    }

    .search-hero-inner {
        max-width: 1180px;
        margin: 0 auto;
        border-radius: 24px;
        padding: 1.4rem;
        border: 1px solid #cee3f1;
        background: linear-gradient(135deg, #1b5f88 0%, #217b96 50%, #2e6fa1 100%);
        box-shadow: 0 22px 42px rgba(16, 58, 84, 0.22);
        color: #fff;
    }

    .search-eyebrow {
        margin: 0;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #d4efff;
    }

    .search-hero h1 {
        margin: 0.5rem 0 0;
        font-size: clamp(1.7rem, 4vw, 2.7rem);
    }

    .search-hero h1 span {
        color: #b8f0ff;
    }

    .search-summary {
        margin: 0.75rem 0 0;
        color: #ecf8ff;
    }

    .search-form {
        margin-top: 1rem;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .search-form input {
        flex: 1 1 320px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        padding: 0.72rem 1rem;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }

    .search-form input::placeholder {
        color: rgba(255, 255, 255, 0.78);
    }

    .search-form button {
        border: none;
        border-radius: 999px;
        padding: 0.72rem 1.2rem;
        background: #ffffff;
        color: #17557a;
        font-weight: 700;
        cursor: pointer;
    }

    .search-empty-state,
    .search-results {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .search-empty-state {
        margin-top: 1.2rem;
        background: #fff;
        border: 1px dashed #b8d8eb;
        border-radius: 16px;
        padding: 1rem;
        color: #34566d;
    }

    .search-results {
        margin-top: 1.3rem;
    }

    .result-block-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.8rem;
    }

    .result-block-heading h2 {
        margin: 0;
        font-size: clamp(1.2rem, 2.5vw, 1.8rem);
        color: #113a57;
    }

    .count-badge {
        background: #dff2fb;
        color: #1c688b;
        border: 1px solid #b7deef;
        border-radius: 999px;
        padding: 0.25rem 0.72rem;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .result-group {
        background: #fff;
        border: 1px solid #d3e7f3;
        border-radius: 18px;
        box-shadow: 0 16px 30px rgba(18, 67, 97, 0.08);
        padding: 0.95rem;
        margin-bottom: 0.95rem;
    }

    .result-group-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .result-group-head h3 {
        margin: 0;
        color: #194d70;
    }

    .group-count {
        font-size: 0.8rem;
        color: #4d6d84;
    }

    .search-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
    }

    .search-card-item {
        display: flex;
        flex-direction: column;
        text-align: left;
        width: 100%;
        padding: 0;
        cursor: pointer;
        border: none;
        border-radius: 14px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .search-card-item:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 44px rgba(0, 0, 0, 0.14);
    }

    .sci-image {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: #f0f4f8;
    }

    .sci-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .search-card-item:hover .sci-image img {
        transform: scale(1.08);
    }

    .sci-body {
        padding: 1rem 1.1rem 1.2rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .sci-kicker {
        display: inline-block;
        font-size: 0.7rem;
        border-radius: 999px;
        background: #dff3fb;
        color: #1e688c;
        border: 1px solid #b9def0;
        padding: 0.18rem 0.55rem;
        margin-bottom: 0.5rem;
        font-weight: 700;
        align-self: flex-start;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .sci-title {
        margin: 0;
        color: #0f2d42;
        font-size: 1.05rem;
        font-weight: 700;
        line-height: 1.3;
    }

    .sci-desc {
        margin: 0.4rem 0 0;
        color: #6b7280;
        font-size: 0.85rem;
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .sci-action {
        display: inline-flex;
        align-items: center;
        margin-top: 0.7rem;
        font-size: 0.82rem;
        color: #217b96;
        font-weight: 700;
        gap: 0.25rem;
        transition: gap 0.2s;
    }

    .search-card-item:hover .sci-action {
        gap: 0.5rem;
    }

    /* ── Collage grid ── */
    .collage-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-auto-rows: 180px;
        gap: 8px;
        border-radius: 12px;
        overflow: hidden;
    }

    .collage-cell {
        position: relative;
        overflow: hidden;
        text-decoration: none;
        display: block;
    }

    .collage-cell--normal { grid-column: span 1; grid-row: span 1; }
    .collage-cell--tall   { grid-column: span 1; grid-row: span 2; }
    .collage-cell--wide   { grid-column: span 2; grid-row: span 1; }

    .collage-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
    }

    .collage-cell:hover .collage-img {
        transform: scale(1.07);
    }

    .collage-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(10, 26, 47, 0.72) 0%,
            rgba(10, 26, 47, 0.15) 55%,
            transparent 100%
        );
        opacity: 0;
        transition: opacity 0.3s ease;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: flex-end;
        padding: 14px 16px;
    }

    .collage-cell:hover .collage-overlay {
        opacity: 1;
    }

    .collage-caption {
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
        line-height: 1.3;
    }

    .result-empty {
        border-radius: 14px;
        border: 1px dashed #c8dfee;
        padding: 0.85rem;
        background: #fbfdff;
        color: #4c6d84;
    }

    @media (max-width: 1024px) {
        .collage-grid { grid-template-columns: repeat(2, 1fr); }
        .collage-cell--wide { grid-column: span 2; }
        .collage-cell--tall { grid-row: span 2; }
    }

    @media (max-width: 768px) {
        .collage-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 150px; }
        .collage-cell--tall { grid-row: span 1; }
    }

    @media (max-width: 480px) {
        .collage-grid { grid-template-columns: 1fr; }
        .collage-cell--wide { grid-column: span 1; }
    }

    @media (max-width: 700px) {
        .search-hero {
            padding-top: 5.8rem;
        }

        .search-hero-inner {
            border-radius: 16px;
        }

        .search-form {
            gap: 0.4rem;
        }

        .search-form button {
            width: 100%;
        }

        .sci-image {
            height: 170px;
        }
    }
</style>
