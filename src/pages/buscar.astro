---
import Footer from "../components/footer.astro";
import Navbar from "../components/navigation.astro";
import {
    searchableCards,
    searchablePhotos,
} from "../components/data/search/search_index_data";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <Navbar />
    <main class="search-page">
        <section class="search-hero">
            <div class="search-hero-inner">
                <p class="search-eyebrow">Buscador inteligente Azulia</p>
                <h1 id="searchTitle">Resultados para: <span>sin término</span></h1>
                <p id="searchSummary" class="search-summary">
                    Escribe una palabra clave para buscar en tours, hoteles, transportación y renta de autos.
                </p>
                <form action="/buscar" method="GET" class="search-form">
                    <input
                        type="search"
                        id="searchInput"
                        name="q"
                        placeholder="Ejemplo: kayak, ruinas, hotel, suv, frontera"
                        autocomplete="off"
                    />
                    <button type="submit">Buscar</button>
                </form>
            </div>
        </section>

        <section id="emptyState" class="search-empty-state">
            <h2>Comienza con una palabra clave</h2>
            <p>Prueba con: "nauticos", "calakmul", "hotel", "cancun", "camry".</p>
        </section>

        <section id="cardsBlock" class="search-results cards-block" hidden>
            <div class="result-block-heading">
                <h2>Cards encontrados</h2>
                <span id="cardsCountBadge">0</span>
            </div>
            <div id="cardsGroupsContainer"></div>
        </section>

        <section id="photosBlock" class="search-results photos-block" hidden>
            <div class="result-block-heading">
                <h2>Fotos por palabra clave</h2>
                <span id="photosCountBadge">0</span>
            </div>
            <div id="photosGroupsContainer"></div>
        </section>

        <div id="resultModal" class="search-result-modal" hidden>
            <div class="search-result-modal-card" role="dialog" aria-modal="true" aria-labelledby="resultModalTitle">
                <button id="resultModalClose" class="result-modal-close" type="button" aria-label="Cerrar detalle">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
                <div class="result-modal-media">
                    <img id="resultModalImage" src="" alt="" loading="lazy" referrerpolicy="no-referrer" />
                </div>
                <div class="result-modal-content">
                    <p id="resultModalArea" class="result-modal-area"></p>
                    <h3 id="resultModalTitle"></h3>
                    <p id="resultModalDescription"></p>
                    <a id="resultModalLink" class="result-modal-cta" href="#">Ver más</a>
                </div>
            </div>
        </div>
    </main>
    <Footer />
</Layout>

<script define:vars={{ searchableCards, searchablePhotos }}>
    const cardsData = searchableCards;
    const photosData = searchablePhotos;

    const titleEl = document.getElementById("searchTitle");
    const summaryEl = document.getElementById("searchSummary");
    const inputEl = document.getElementById("searchInput");
    const emptyStateEl = document.getElementById("emptyState");
    const cardsBlockEl = document.getElementById("cardsBlock");
    const photosBlockEl = document.getElementById("photosBlock");
    const cardsGroupsEl = document.getElementById("cardsGroupsContainer");
    const photosGroupsEl = document.getElementById("photosGroupsContainer");
    const cardsCountBadgeEl = document.getElementById("cardsCountBadge");
    const photosCountBadgeEl = document.getElementById("photosCountBadge");
    const resultModalEl = document.getElementById("resultModal");
    const resultModalCloseEl = document.getElementById("resultModalClose");
    const resultModalImageEl = document.getElementById("resultModalImage");
    const resultModalAreaEl = document.getElementById("resultModalArea");
    const resultModalTitleEl = document.getElementById("resultModalTitle");
    const resultModalDescriptionEl = document.getElementById("resultModalDescription");
    const resultModalLinkEl = document.getElementById("resultModalLink");

    const cardsMap = new Map(cardsData.map((item) => [item.id, item]));

    const normalize = (value) =>
        value
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9\s]/g, " ")
            .replace(/\s+/g, " ")
            .trim();

    const escapeHtml = (value) =>
        value
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/\"/g, "&quot;")
            .replace(/'/g, "&#39;");

    const groupByArea = (items) => {
        const groups = new Map();

        items.forEach((item) => {
            const list = groups.get(item.area) ?? [];
            list.push(item);
            groups.set(item.area, list);
        });

        return Array.from(groups.entries()).map(([area, values]) => ({
            area,
            values,
            count: values.length,
        }));
    };

    const query = new URLSearchParams(window.location.search).get("q")?.trim() ?? "";
    const terms = normalize(query)
        .split(" ")
        .filter(Boolean);

    if (inputEl) inputEl.value = query;

    if (titleEl) {
        titleEl.innerHTML = `Resultados para: <span>${query ? escapeHtml(query) : "sin término"}</span>`;
    }

    if (terms.length === 0) {
        if (cardsBlockEl) cardsBlockEl.hidden = true;
        if (photosBlockEl) photosBlockEl.hidden = true;
        if (emptyStateEl) emptyStateEl.hidden = false;
    } else {
        const cardMatches = cardsData.filter((item) => {
            const haystack = normalize(
                [item.title, item.description, item.area, item.keywords.join(" ")].join(" "),
            );
            return terms.every((term) => haystack.includes(term));
        });

        const photoMatches = photosData.filter((item) => {
            const byDescription = normalize(item.description);
            const byTitle = normalize(item.title);
            return terms.every((term) => byDescription.includes(term) || byTitle.includes(term));
        });

        const cardGroups = groupByArea(cardMatches);
        const photoGroups = groupByArea(photoMatches);
        const total = cardMatches.length + photoMatches.length;

        if (summaryEl) {
            summaryEl.textContent = `${total} resultado(s) encontrados: ${cardMatches.length} cards y ${photoMatches.length} fotos.`;
        }

        if (cardsCountBadgeEl) cardsCountBadgeEl.textContent = String(cardMatches.length);
        if (photosCountBadgeEl) photosCountBadgeEl.textContent = String(photoMatches.length);

        if (cardsGroupsEl) {
            cardsGroupsEl.innerHTML = cardGroups.length
                ? cardGroups
                      .map(
                          (group) => `
                        <article class="result-group">
                            <header class="result-group-head">
                                <h3>${escapeHtml(group.area)}</h3>
                                <span>${group.count} resultado(s)</span>
                            </header>
                            <div class="result-card-grid">
                                ${group.values
                                    .map(
                                        (item) => `
                                    <button type="button" class="search-card-item" data-card-id="${escapeHtml(item.id)}">
                                        <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" referrerpolicy="no-referrer" />
                                        <div class="search-card-body">
                                            <span class="search-card-kicker">${escapeHtml(item.area)}</span>
                                            <h4>${escapeHtml(item.title)}</h4>
                                            <p>${escapeHtml(item.description)}</p>
                                            <span class="search-card-action">Ver detalle</span>
                                        </div>
                                    </button>
                                `,
                                    )
                                    .join("")}
                            </div>
                        </article>
                    `,
                      )
                      .join("")
                : '<p class="result-empty">No hay cards que coincidan con tu búsqueda.</p>';
        }

        if (photosGroupsEl) {
            photosGroupsEl.innerHTML = photoGroups.length
                ? photoGroups
                      .map(
                          (group) => `
                        <article class="result-group">
                            <header class="result-group-head">
                                <h3>${escapeHtml(group.area)}</h3>
                                <span>${group.count} foto(s)</span>
                            </header>
                            <div class="result-photo-grid">
                                ${group.values
                                    .map(
                                        (item) => `
                                    <a href="${escapeHtml(item.href)}" class="photo-item">
                                        <img src="${escapeHtml(item.image)}" alt="${escapeHtml(item.title)}" loading="lazy" referrerpolicy="no-referrer" />
                                        <div class="photo-caption">
                                            <h4>${escapeHtml(item.title)}</h4>
                                            <p>${escapeHtml(item.description)}</p>
                                        </div>
                                    </a>
                                `,
                                    )
                                    .join("")}
                            </div>
                        </article>
                    `,
                      )
                      .join("")
                : '<p class="result-empty">No hay fotos cuya descripción coincida.</p>';
        }

        if (cardsBlockEl) cardsBlockEl.hidden = false;
        if (photosBlockEl) photosBlockEl.hidden = false;
        if (emptyStateEl) emptyStateEl.hidden = true;
    }

    const openResultModal = (item) => {
        if (!resultModalEl || !resultModalImageEl || !resultModalAreaEl || !resultModalTitleEl || !resultModalDescriptionEl || !resultModalLinkEl) {
            return;
        }

        resultModalImageEl.src = item.image;
        resultModalImageEl.alt = item.title;
        resultModalAreaEl.textContent = item.area;
        resultModalTitleEl.textContent = item.title;
        resultModalDescriptionEl.textContent = item.description;
        resultModalLinkEl.href = item.href;

        resultModalEl.hidden = false;
        document.body.style.overflow = "hidden";
    };

    const closeResultModal = () => {
        if (!resultModalEl) return;
        resultModalEl.hidden = true;
        document.body.style.overflow = "";
    };

    cardsGroupsEl?.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const cardButton = target.closest(".search-card-item[data-card-id]");
        if (!cardButton) return;

        const itemId = cardButton.getAttribute("data-card-id");
        if (!itemId) return;
        const item = cardsMap.get(itemId);
        if (!item) return;

        openResultModal(item);
    });

    resultModalCloseEl?.addEventListener("click", closeResultModal);
    resultModalEl?.addEventListener("click", (event) => {
        if (event.target === resultModalEl) closeResultModal();
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeResultModal();
    });
</script>

<style is:global>
    .search-page {
        background: radial-gradient(circle at 18% 9%, rgba(33, 123, 150, 0.22), transparent 36%),
            linear-gradient(180deg, #edf6fd 0%, #f7fbff 55%, #ffffff 100%);
        min-height: 100vh;
        padding-bottom: 3rem;
        font-family: Arial, Helvetica, sans-serif;
    }

    .search-hero {
        padding: 6.5rem 1rem 2rem;
    }

    .search-hero-inner {
        max-width: 1180px;
        margin: 0 auto;
        border-radius: 24px;
        padding: 1.4rem;
        border: 1px solid #cee3f1;
        background: linear-gradient(135deg, #1b5f88 0%, #217b96 50%, #2e6fa1 100%);
        box-shadow: 0 22px 42px rgba(16, 58, 84, 0.22);
        color: #fff;
    }

    .search-eyebrow {
        margin: 0;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #d4efff;
    }

    .search-hero h1 {
        margin: 0.5rem 0 0;
        font-size: clamp(1.7rem, 4vw, 2.7rem);
    }

    .search-hero h1 span {
        color: #b8f0ff;
    }

    .search-summary {
        margin: 0.75rem 0 0;
        color: #ecf8ff;
    }

    .search-form {
        margin-top: 1rem;
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .search-form input {
        flex: 1 1 320px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        padding: 0.72rem 1rem;
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }

    .search-form input::placeholder {
        color: rgba(255, 255, 255, 0.78);
    }

    .search-form button {
        border: none;
        border-radius: 999px;
        padding: 0.72rem 1.2rem;
        background: #ffffff;
        color: #17557a;
        font-weight: 700;
        cursor: pointer;
    }

    .search-empty-state,
    .search-results {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    .search-empty-state {
        margin-top: 1.2rem;
        background: #fff;
        border: 1px dashed #b8d8eb;
        border-radius: 16px;
        padding: 1rem;
        color: #34566d;
    }

    .search-results {
        margin-top: 1.3rem;
    }

    .result-block-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.8rem;
    }

    .result-block-heading h2 {
        margin: 0;
        font-size: clamp(1.2rem, 2.5vw, 1.8rem);
        color: #113a57;
    }

    .result-block-heading span {
        background: #dff2fb;
        color: #1c688b;
        border: 1px solid #b7deef;
        border-radius: 999px;
        padding: 0.25rem 0.72rem;
        font-size: 0.82rem;
        font-weight: 700;
    }

    .result-group {
        background: #fff;
        border: 1px solid #d3e7f3;
        border-radius: 18px;
        box-shadow: 0 16px 30px rgba(18, 67, 97, 0.08);
        padding: 0.95rem;
        margin-bottom: 0.95rem;
    }

    .result-group-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
    }

    .result-group-head h3 {
        margin: 0;
        color: #194d70;
    }

    .result-group-head span {
        font-size: 0.8rem;
        color: #4d6d84;
    }

    .result-card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 0.9rem;
    }

    .search-card-item {
        display: flex;
        flex-direction: column;
        text-align: left;
        width: 100%;
        padding: 0;
        cursor: pointer;
        border: 1px solid #c9dff0;
        border-radius: 14px;
        overflow: hidden;
        background: linear-gradient(180deg, #153a56 0%, #1e587d 42%, #ffffff 42%, #f8fcff 100%);
        box-shadow: 0 14px 26px rgba(21, 62, 90, 0.12);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .search-card-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 30px rgba(14, 52, 78, 0.2);
    }

    .search-card-item img {
        width: 100%;
        height: 162px;
        object-fit: contain;
        padding: 0.8rem;
        display: block;
    }

    .search-card-body {
        padding: 0.85rem;
    }

    .search-card-kicker {
        display: inline-block;
        font-size: 0.72rem;
        border-radius: 999px;
        background: #dff3fb;
        color: #1e688c;
        border: 1px solid #b9def0;
        padding: 0.2rem 0.55rem;
        margin-bottom: 0.45rem;
        font-weight: 700;
    }

    .search-card-body h4 {
        margin: 0;
        color: #153f5e;
        font-size: 1.02rem;
        line-height: 1.3;
    }

    .search-card-body p {
        margin: 0.45rem 0 0;
        color: #486479;
        font-size: 0.86rem;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 3.9em;
    }

    .search-card-action {
        display: inline-flex;
        margin-top: 0.55rem;
        font-size: 0.82rem;
        color: #1f6f8f;
        font-weight: 700;
    }

    .result-photo-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 0.75rem;
    }

    .photo-item {
        text-decoration: none;
        border-radius: 14px;
        border: 1px solid #cde3f1;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 12px 22px rgba(14, 59, 87, 0.08);
    }

    .photo-item img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        display: block;
    }

    .photo-caption {
        padding: 0.7rem;
    }

    .photo-caption h4 {
        margin: 0;
        color: #123d5c;
    }

    .photo-caption p {
        margin: 0.45rem 0 0;
        color: #4c6a80;
        font-size: 0.86rem;
        line-height: 1.45;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .search-result-modal {
        position: fixed;
        inset: 0;
        z-index: 2500;
        background: rgba(8, 24, 38, 0.7);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }

    .search-result-modal-card {
        width: min(860px, 100%);
        display: grid;
        grid-template-columns: minmax(260px, 45%) 1fr;
        background: #fff;
        border-radius: 18px;
        border: 1px solid #cde2ef;
        overflow: hidden;
        box-shadow: 0 28px 46px rgba(12, 41, 61, 0.35);
        position: relative;
    }

    .result-modal-close {
        position: absolute;
        top: 0.7rem;
        right: 0.7rem;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: none;
        background: rgba(13, 49, 74, 0.88);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 2;
    }

    .result-modal-media {
        background: radial-gradient(circle at top, #2e6f9a 0%, #143b58 70%);
    }

    .result-modal-media img {
        width: 100%;
        height: 100%;
        max-height: 420px;
        object-fit: contain;
        padding: 1rem;
        display: block;
    }

    .result-modal-content {
        padding: 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
    }

    .result-modal-area {
        margin: 0;
        width: fit-content;
        border-radius: 999px;
        border: 1px solid #c8e5f2;
        background: #e8f8ff;
        color: #1d6588;
        padding: 0.2rem 0.55rem;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }

    #resultModalTitle {
        margin: 0;
        color: #143a57;
        font-size: 1.52rem;
    }

    #resultModalDescription {
        margin: 0;
        color: #49657c;
        line-height: 1.62;
    }

    .result-modal-cta {
        width: fit-content;
        text-decoration: none;
        margin-top: auto;
        border-radius: 999px;
        padding: 0.58rem 0.96rem;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(135deg, #2675a5 0%, #217b96 100%);
    }

    .result-empty {
        border-radius: 14px;
        border: 1px dashed #c8dfee;
        padding: 0.85rem;
        background: #fbfdff;
        color: #4c6d84;
    }

    @media (max-width: 700px) {
        .search-hero {
            padding-top: 5.8rem;
        }

        .search-hero-inner {
            border-radius: 16px;
        }

        .search-form {
            gap: 0.4rem;
        }

        .search-form button {
            width: 100%;
        }

        .search-result-modal-card {
            grid-template-columns: 1fr;
        }

        .result-modal-media img {
            max-height: 250px;
        }
    }
</style>
