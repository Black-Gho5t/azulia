---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <main class="terms-page">
        <header class="terms-header">
            <h1>Términos de Servicio</h1>
            <p>Consulta el documento completo directamente en esta página.</p>
        </header>

        <section class="pdf-frame" aria-label="Visor del PDF de términos">
            <div id="pdfStatus" class="pdf-status">Cargando documento...</div>
            <div id="pdfPages" class="pdf-pages" hidden></div>
        </section>

        <p class="pdf-fallback">
            Si tu navegador bloquea la vista embebida, ábrelo aquí:
            <a href="/PNAAZULIA.pdf" target="_blank" rel="noopener noreferrer">PNAAZULIA.pdf</a>.
        </p>
    </main>
</Layout>

<style>
    .terms-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.25rem;
    }

    .terms-header {
        margin-bottom: 1rem;
    }

    .terms-header h1 {
        margin: 0;
        font-size: clamp(1.4rem, 1.7vw, 2rem);
    }

    .terms-header p {
        margin: 0.45rem 0 0;
        color: #4b5563;
    }

    .pdf-frame {
        min-height: 78vh;
        background: linear-gradient(180deg, #f8fbff 0%, #edf2f7 100%);
        border: 1px solid #d9e2ec;
        border-radius: 14px;
        box-shadow: 0 16px 36px rgba(15, 23, 42, 0.12);
        padding: 1rem;
    }

    .pdf-status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: #1f2937;
        background: #ffffff;
        border: 1px solid #dbe4ee;
        border-radius: 999px;
        padding: 0.4rem 0.9rem;
        margin-bottom: 0.75rem;
    }

    .pdf-pages {
        display: grid;
        gap: 1rem;
    }

    .pdf-page {
        background: #ffffff;
        border: 1px solid #dbe4ee;
        border-radius: 10px;
        padding: 0.8rem;
    }

    .pdf-page-label {
        margin: 0 0 0.5rem;
        font-size: 0.86rem;
        color: #475569;
        font-weight: 600;
    }

    .pdf-canvas {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 8px;
    }

    .pdf-fallback {
        margin-top: 0.85rem;
    }

    @media (max-width: 720px) {
        .terms-page {
            padding: 0.9rem;
        }

        .pdf-frame {
            padding: 0.65rem;
            min-height: 70vh;
        }
    }
</style>

<script>
    import * as pdfjsLib from "pdfjs-dist";
    import workerSrc from "pdfjs-dist/build/pdf.worker.min.mjs?url";

    pdfjsLib.GlobalWorkerOptions.workerSrc = workerSrc;

    const statusEl = document.getElementById("pdfStatus");
    const pagesEl = document.getElementById("pdfPages");
    const pdfUrl = "/PNAAZULIA.pdf";

    const showError = () => {
        if (!statusEl) return;
        statusEl.textContent = "No fue posible mostrar el PDF en esta vista.";
    };

    const renderPdf = async () => {
        if (!statusEl || !pagesEl) return;

        try {
            const task = pdfjsLib.getDocument({ url: pdfUrl });
            const pdf = await task.promise;

            statusEl.textContent = `Documento cargado: ${pdf.numPages} página(s)`;
            pagesEl.hidden = false;

            for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
                const page = await pdf.getPage(pageNumber);
                const viewport = page.getViewport({ scale: 1.35 });
                const pixelRatio = window.devicePixelRatio || 1;

                const wrapper = document.createElement("section");
                wrapper.className = "pdf-page";

                const label = document.createElement("p");
                label.className = "pdf-page-label";
                label.textContent = `Página ${pageNumber}`;

                const canvas = document.createElement("canvas");
                canvas.className = "pdf-canvas";

                canvas.width = Math.floor(viewport.width * pixelRatio);
                canvas.height = Math.floor(viewport.height * pixelRatio);
                canvas.style.width = `${viewport.width}px`;
                canvas.style.height = `${viewport.height}px`;

                const context = canvas.getContext("2d");
                if (!context) {
                    showError();
                    return;
                }

                await page.render({
                    canvasContext: context,
                    canvas,
                    viewport,
                    transform: pixelRatio === 1 ? undefined : [pixelRatio, 0, 0, pixelRatio, 0, 0],
                }).promise;

                wrapper.appendChild(label);
                wrapper.appendChild(canvas);
                pagesEl.appendChild(wrapper);
            }
        } catch (error) {
            showError();
        }
    };

    renderPdf();
</script>
