---
import Navbar from "../../components/navigation.astro";
import Footer from "../../components/footer.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <Navbar />
    <main>
        <div class="hotels-carousel">
            <div class="carousel-images">
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_2.webp"
                    alt="Hoteles en Bacalar"
                    class="carousel-img active"
                />
                <img
                    src="/src/assets/photos_azulia_webp/ponton/pontom_1.webp"
                    alt="Muelle frente a hotel"
                    class="carousel-img"
                />
                <img
                    src="/src/assets/photos_azulia_webp/upscale_azulia_2.webp"
                    alt="Atardecer en Bacalar"
                    class="carousel-img"
                />
                <img
                    src="/src/assets/photos_azulia_webp/velero/velero_4.webp"
                    alt="Estancia de lujo en Bacalar"
                    class="carousel-img"
                />
            </div>
            <div class="carousel-overlay" />
            <div class="carousel-content">
                <span class="hero-eyebrow">Hospedaje Azulia</span>
                <h1>Hoteles para cada estilo de viaje</h1>
                <p>
                    Elige entre opciones boutique, eco y premium con la paleta y
                    esencia del Caribe mexicano.
                </p>
                <div class="hero-actions">
                    <a href="#hoteles" class="btn btn-primary">Ver hoteles</a>
                    <a href="#recomendados" class="btn btn-secondary">Top puntuados</a>
                </div>
            </div>
        </div>

        <section class="hoteles-section" id="hoteles">
            <div class="container">
                <div class="section-header" id="recomendados">
                    <span class="section-eyebrow">Seleccionados para ti</span>
                    <h2 class="section-title">Hospedajes recomendados en Bacalar</h2>
                    <p class="section-subtitle">
                        Todas las opciones incluyen informacion clara de precio, amenidades
                        y ubicacion para que compares rapido.
                    </p>
                </div>

                <div class="hoteles-grid" id="hotelsGrid">
                    <div class="hotels-loading">Cargando hoteles...</div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<style>


    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: normal;
        font-style: normal;
        line-height: 1;
        display: inline-block;
        letter-spacing: normal;
        text-transform: none;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        -webkit-font-smoothing: antialiased;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .hotels-carousel {
        position: relative;
        width: 100%;
        height: 80vh;
        overflow: hidden;
    }

    .carousel-images {
        position: relative;
        width: 100%;
        height: 100%;
    }

    .carousel-img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.8s ease-in-out;
    }

    .carousel-img.active {
        opacity: 1;
        z-index: 1;
    }

    .carousel-overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(
            ellipse 95% 100% at 0% 0%,
            rgba(33, 123, 150, 0.95) 0%,
            rgba(38, 117, 165, 0.82) 28%,
            rgba(38, 117, 165, 0.52) 56%,
            rgba(38, 117, 165, 0.18) 76%,
            rgba(38, 117, 165, 0) 100%
        );
        z-index: 2;
    }

    .carousel-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 3;
        text-align: center;
        color: #fff;
        width: min(900px, 92%);
        padding: 2rem;
    }

    .hero-eyebrow {
        display: inline-block;
        margin-bottom: 0.6rem;
        padding: 0.42rem 0.9rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.3);
        font-size: 0.78rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-weight: 700;
    }

    .carousel-content h1 {
        margin: 0;
        font-size: clamp(2.2rem, 5vw, 4rem);
        text-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
    }

    .carousel-content p {
        margin: 1rem auto 0;
        max-width: 680px;
        font-size: clamp(1rem, 2.1vw, 1.25rem);
        line-height: 1.6;
        color: rgba(255, 255, 255, 0.94);
        text-shadow: 0 4px 18px rgba(0, 0, 0, 0.3);
    }

    .hero-actions {
        margin-top: 1.5rem;
        display: inline-flex;
        gap: 0.8rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    .btn {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.72rem 1.2rem;
        border-radius: 999px;
        font-weight: 700;
        font-size: 0.95rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    .btn-primary {
        background: #ffffff;
        color: #1c5fa8;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.18);
    }

    .btn-secondary {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

    .hoteles-section {
        padding: 4.5rem 1.25rem;
        background: linear-gradient(180deg, #f4fbff 0%, #eef6ff 100%);
    }

    .section-header {
        text-align: center;
        margin-bottom: 2.4rem;
    }

    .section-eyebrow {
        display: inline-block;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #217b96;
        margin-bottom: 0.55rem;
    }

    .section-title {
        margin: 0;
        color: #16324f;
        font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    }

    .section-subtitle {
        color: #4f6982;
        margin: 0.8rem auto 0;
        max-width: 720px;
        line-height: 1.65;
    }

    .hoteles-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.4rem;
    }

    :global(.hotel-card) {
        background: #fff;
        border-radius: 1.1rem;
        overflow: hidden;
        border: 1px solid rgba(38, 117, 165, 0.16);
        box-shadow: 0 14px 32px rgba(21, 71, 117, 0.1);
        transition: transform 0.24s ease, box-shadow 0.24s ease;
        display: flex;
        flex-direction: column;
    }

    :global(.hotel-card:hover) {
        transform: translateY(-6px);
        box-shadow: 0 18px 36px rgba(21, 71, 117, 0.16);
    }

    :global(.hotel-card-image) {
        position: relative;
        width: 100%;
        height: 210px;
    }

    :global(.hotel-card-image img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    :global(.hotel-rating) {
        position: absolute;
        top: 0.8rem;
        right: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.33rem 0.65rem;
        border-radius: 999px;
        background: rgba(22, 50, 79, 0.75);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        backdrop-filter: blur(3px);
    }

    :global(.hotel-rating .material-symbols-outlined) {
        font-size: 1rem;
        color: #ffd35f;
    }

    :global(.hotel-card-content) {
        padding: 1rem 1rem 1.1rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    :global(.hotel-meta-top h3) {
        margin: 0;
        color: #1c5fa8;
        font-size: 1.2rem;
        line-height: 1.3;
    }

    :global(.hotel-zone) {
        margin-top: 0.3rem;
        display: inline-flex;
        align-items: center;
        gap: 0.2rem;
        color: #217b96;
        font-size: 0.88rem;
        font-weight: 600;
    }

    :global(.hotel-zone .material-symbols-outlined) {
        font-size: 1rem;
    }

    :global(.hotel-card-content p) {
        color: #4e6278;
        line-height: 1.6;
        margin: 0.75rem 0 0.9rem;
        font-size: 0.95rem;
    }

    :global(.hotel-perks) {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    :global(.hotel-perks li) {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.36rem 0.62rem;
        border-radius: 999px;
        background: #e9f6fb;
        border: 1px solid #c6e8f3;
        color: #215b83;
        font-size: 0.78rem;
        font-weight: 600;
    }

    :global(.hotel-perks li .material-symbols-outlined) {
        font-size: 1rem;
    }

    :global(.hotel-footer) {
        margin-top: auto;
        padding-top: 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
    }

    :global(.hotel-price-block) {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }

    :global(.hotel-price-block .label) {
        color: #5f7285;
        font-size: 0.76rem;
    }

    :global(.hotel-price) {
        color: #1c5fa8;
        font-size: 1.08rem;
        font-weight: 800;
        margin: 0.16rem 0;
    }

    :global(.hotel-price-block .note) {
        color: #6e8295;
        font-size: 0.74rem;
    }

    :global(.hotel-cta) {
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.28rem;
        border-radius: 999px;
        padding: 0.52rem 0.9rem;
        background: linear-gradient(135deg, #2675a5 0%, #217b96 100%);
        color: #fff;
        font-size: 0.84rem;
        font-weight: 700;
        box-shadow: 0 10px 18px rgba(38, 117, 165, 0.25);
        transition: transform 0.2s ease;
    }

    :global(.hotel-cta:hover) {
        transform: translateY(-2px);
    }

    :global(.hotel-cta .material-symbols-outlined) {
        font-size: 1rem;
    }

    :global(.hotels-loading), :global(.hotels-empty) {
        grid-column: 1 / -1;
        text-align: center;
        padding: 3rem 1rem;
        color: #64748b;
        font-size: 0.95rem;
    }

    @media (max-width: 900px) {
        .hotels-carousel {
            height: 62vh;
        }
    }

    @media (max-width: 768px) {
        .hotels-carousel {
            height: 52vh;
        }

        .carousel-content {
            padding: 1.1rem;
        }

        .hero-actions {
            margin-top: 1.2rem;
            gap: 0.55rem;
        }

        .btn {
            font-size: 0.86rem;
            padding: 0.62rem 1rem;
        }

        .hoteles-section {
            padding: 3.2rem 1rem;
        }
    }

    @media (max-width: 480px) {
        .hotels-carousel {
            height: 46vh;
        }

        :global(.hotel-card-image) {
            height: 190px;
        }

        :global(.hotel-footer) {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>

<script>
    let currentImageIndex = 0;
    const carouselImages = document.querySelectorAll(".carousel-img");
    const totalImages = carouselImages.length;

    function showImage(index: number): void {
        carouselImages.forEach((img) => img.classList.remove("active"));
        carouselImages[index].classList.add("active");
    }

    function nextImage(): void {
        currentImageIndex = (currentImageIndex + 1) % totalImages;
        showImage(currentImageIndex);
    }

    setInterval(nextImage, 8000);

    const hotelsGrid = document.getElementById('hotelsGrid')!;

    function getCoverImage(hotel: any): string {
        if (Array.isArray(hotel.images) && hotel.images.length > 0) {
            const idx = Number(hotel.coverIndex) || 0;
            return hotel.images[idx] || hotel.images[0] || '';
        }
        return hotel.image || '';
    }

    async function loadHotels() {
        try {
            const res = await fetch('/api/hotels');
            const data = await res.json();
            if (!data.ok) throw new Error(data.error);

            if (data.hotels.length === 0) {
                hotelsGrid.innerHTML = '<p class="hotels-empty">No hay hoteles disponibles por el momento.</p>';
                return;
            }

            hotelsGrid.innerHTML = data.hotels.map((hotel: any) => {
                const coverImg = getCoverImage(hotel);
                const price = Number(hotel.price) || 0;
                const score = Number(hotel.score) || 0;
                const perks = Array.isArray(hotel.perks) ? hotel.perks : [];

                return `
                    <article class="hotel-card">
                        <div class="hotel-card-image">
                            ${coverImg
                                ? `<img src="${coverImg}" alt="${hotel.name}" loading="lazy" onerror="this.style.display='none'" />`
                                : ''}
                            <div class="hotel-rating">
                                <span class="material-symbols-outlined" aria-hidden="true">star</span>
                                ${score}
                            </div>
                        </div>
                        <div class="hotel-card-content">
                            <div class="hotel-meta-top">
                                <h3>${hotel.name}</h3>
                                <span class="hotel-zone">
                                    <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
                                    ${hotel.zone}
                                </span>
                            </div>
                            <p>${hotel.description || ''}</p>
                            <ul class="hotel-perks">
                                ${perks.map((p: any) => `
                                    <li>
                                        <span class="material-symbols-outlined" aria-hidden="true">${p.icon}</span>
                                        ${p.label}
                                    </li>
                                `).join('')}
                            </ul>
                            <div class="hotel-footer">
                                <div class="hotel-price-block">
                                    <span class="label">Desde</span>
                                    <span class="hotel-price">$${price.toLocaleString("es-MX")} MXN</span>
                                    <span class="note">por noche</span>
                                </div>
                                <button type="button" class="hotel-cta" data-contact="Hotel">
                                    Cotizar
                                    <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                                </button>
                            </div>
                        </div>
                    </article>
                `;
            }).join('');
        } catch (err) {
            hotelsGrid.innerHTML = '<p class="hotels-empty">Error al cargar hoteles.</p>';
        }
    }

    loadHotels();

    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest('[data-contact]') as HTMLElement | null;
        if (btn) {
            (window as any).openContactModal(btn.dataset.contact || '');
        }
    });
</script>
