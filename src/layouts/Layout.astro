---
import "bootstrap-icons/font/bootstrap-icons.css";
import WhatsAppButton from "../components/functions/wha/redirection_button.astro";
import ContactModal from "../components/contact_modal.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
			rel="stylesheet"
		/>
		<title>Azulia: Servicios marítimos</title>
	</head>
	<body>
		<slot />
		<WhatsAppButton />
		<ContactModal />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		scroll-behavior: smooth;
	}

	body {
		font-family: Inter, system-ui, sans-serif;
	}
	
	.material-symbols-outlined,
	.material-symbols-outlined * {
		font-family: 'Material Symbols Outlined' !important;
		font-weight: normal !important;
		font-style: normal !important;
		font-size: 24px !important;
		line-height: 1 !important;
		letter-spacing: normal !important;
		text-transform: none !important;
		display: inline-block !important;
		white-space: nowrap !important;
		word-wrap: normal !important;
		direction: ltr !important;
		-webkit-font-feature-settings: 'liga' !important;
		font-feature-settings: 'liga' !important;
		-webkit-font-smoothing: antialiased !important;
		-moz-osx-font-smoothing: grayscale !important;
		font-variation-settings: 'opsz' 24, 'wght' 400, 'FILL' 0, 'GRAD' 0 !important;
	}

	/* Google Translate protection: prevent font override on icon elements */
	font > .material-symbols-outlined,
	.material-symbols-outlined > font {
		font-family: 'Material Symbols Outlined' !important;
	}

	[lang]:not(html) .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}

	/* When Google Translate wraps content in <font> tags */
	font[style*="font-family"] .material-symbols-outlined,
	font[color] .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}

	/* Any element with inline font-family that contains an icon child */
	font[style] .material-symbols-outlined,
	span[style*="font-family"] .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}
</style>

<script>
(function () {
	const ICON_SELECTOR = ".material-symbols-outlined";
	const ICON_FONT = "'Material Symbols Outlined'";

	function restoreIcons(root: ParentNode) {
		root.querySelectorAll<HTMLElement>(ICON_SELECTOR).forEach((el) => {
			el.style.fontFamily = ICON_FONT;
		});
	}

	/* Restore on initial load */
	restoreIcons(document);

	/* Watch for Google Translate DOM mutations */
	const observer = new MutationObserver((mutations) => {
		for (const m of mutations) {
			for (const node of Array.from(m.addedNodes)) {
				if (node.nodeType === 1) {
					const el = node as HTMLElement;
					if (el.matches?.(ICON_SELECTOR)) {
						el.style.fontFamily = ICON_FONT;
					}
					restoreIcons(el);
				}
			}
			if (m.type === "attributes" && m.attributeName === "style") {
				const el = m.target as HTMLElement;
				if (el.matches?.(ICON_SELECTOR)) {
					el.style.fontFamily = ICON_FONT;
				}
			}
		}
	});

	observer.observe(document.body, {
		childList: true,
		subtree: true,
		attributes: true,
		attributeFilter: ["style", "class"],
	});
})();
</script>
