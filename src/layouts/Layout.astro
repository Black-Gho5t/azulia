---
import "bootstrap-icons/font/bootstrap-icons.css";
import WhatsAppButton from "../components/functions/wha/redirection_button.astro";
import ContactModal from "../components/contact_modal.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
				rel="stylesheet"
			/>
		</noscript>
		<title>Azulia: Servicios marítimos</title>
	</head>
	<body>
		<slot />
		<WhatsAppButton />
		<ContactModal />
	</body>
</html>

<style is:global>
	/* Force swap for bundled icon fonts to prevent render blocking */
	@font-face {
		font-family: 'bootstrap-icons';
		font-display: swap;
		src: local('bootstrap-icons');
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		scroll-behavior: smooth;
	}

	body {
		font-family: Inter, system-ui, sans-serif;
	}
	
	.material-symbols-outlined,
	.material-symbols-outlined * {
		font-family: 'Material Symbols Outlined' !important;
		font-weight: normal !important;
		font-style: normal !important;
		font-size: 24px !important;
		line-height: 1 !important;
		letter-spacing: normal !important;
		text-transform: none !important;
		display: inline-block !important;
		white-space: nowrap !important;
		word-wrap: normal !important;
		direction: ltr !important;
		-webkit-font-feature-settings: 'liga' !important;
		font-feature-settings: 'liga' !important;
		-webkit-font-smoothing: antialiased !important;
		-moz-osx-font-smoothing: grayscale !important;
		font-variation-settings: 'opsz' 24, 'wght' 400, 'FILL' 0, 'GRAD' 0 !important;
	}

	/* Browser Translation Protection (Google Translate / Edge / Safari) */
	.material-symbols-outlined,
	.notranslate {
		translate: no !important;
		-webkit-user-select: none;
		user-select: none;
	}

	font > .material-symbols-outlined,
	.material-symbols-outlined > font {
		font-family: 'Material Symbols Outlined' !important;
	}

	[lang]:not(html) .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}

	/* When Google Translate wraps content in <font> tags */
	font[style*="font-family"] .material-symbols-outlined,
	font[color] .material-symbols-outlined,
	font[style] .material-symbols-outlined,
	span[style*="font-family"] .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}
</style>

<script>
	import "../scripts/protect-icons";
	import "../scripts/analytics-tracker";
</script>
