---
import "bootstrap-icons/font/bootstrap-icons.css";
import WhatsAppButton from "../components/functions/wha/redirection_button.astro";
import ContactModal from "../components/contact_modal.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonicalUrl?: string;
	type?: string;
	keywords?: string;
	noindex?: boolean;
}

const {
	title = "Azulia | Tours en Bacalar, Hoteles y Transportación",
	description = "Descubre Bacalar con Azulia. Especialistas en turismo náutico, tours en velero y pontón por la Laguna de los Siete Colores, hoteles boutique, renta de autos y transportación privada.",
	image = "/Designer.png",
	canonicalUrl,
	type = "website",
	keywords = "Azulia, Azulia Bacalar, tours bacalar, laguna de bacalar, velero bacalar, ponton bacalar, hoteles bacalar, transportacion bacalar, renta de autos bacalar, turismo nautico",
	noindex = false,
} = Astro.props;

const siteUrl = "https://azulia.com";
const pathname = Astro.url.pathname;
const canonical = canonicalUrl || `${siteUrl}${pathname.endsWith('/') || pathname === '' ? pathname : pathname + '/'}`;
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? image : '/' + image}`;

// Estructura JSON-LD para motores de búsqueda (Google Sitelinks y ficha de marca Azulia)
const schemaOrganization = {
	"@context": "https://schema.org",
	"@type": "TravelAgency",
	"@id": `${siteUrl}/#organization`,
	"name": "Azulia",
	"alternateName": ["Azulia Bacalar", "Azulia Servicios Marítimos", "Azulia Turismo Náutico"],
	"url": siteUrl,
	"logo": `${siteUrl}/Designer.png`,
	"image": `${siteUrl}/Designer.png`,
	"description": "Servicios náuticos y turísticos sustentables en Bacalar: tours en velero y pontón, hoteles boutique, renta de autos y transportación privada nacional e internacional.",
	"telephone": "+529831779754",
	"email": "azulia.bacalar@gmail.com",
	"address": {
		"@type": "PostalAddress",
		"addressLocality": "Bacalar",
		"addressRegion": "Quintana Roo",
		"addressCountry": "MX"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": 18.6783,
		"longitude": -88.3933
	},
	"sameAs": [
		"https://www.facebook.com/share/19GQZ365Ek/",
		"https://www.instagram.com/azuliabacalar",
		"https://wa.me/529831779754"
	],
	"priceRange": "$$",
	"currenciesAccepted": "MXN, USD"
};

const schemaWebSite = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	"url": siteUrl,
	"name": "Azulia",
	"alternateName": "Azulia Bacalar",
	"description": "Plataforma oficial de Azulia para tours, hoteles, autos y traslados en Bacalar.",
	"publisher": {
		"@id": `${siteUrl}/#organization`
	},
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${siteUrl}/buscar?q={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};

const schemaSiteNavigation = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	"itemListElement": [
		{
			"@type": "SiteNavigationElement",
			"position": 1,
			"name": "Tours en Bacalar",
			"description": "Excursiones en velero, pontón, visitas a cenotes, ruinas arqueológicas y Mahahual.",
			"url": `${siteUrl}/tours/tours_index`
		},
		{
			"@type": "SiteNavigationElement",
			"position": 2,
			"name": "Hoteles en Bacalar",
			"description": "Hospedajes boutique y resorts frente a la Laguna de los Siete Colores en Bacalar.",
			"url": `${siteUrl}/hotels/hoteles_index`
		},
		{
			"@type": "SiteNavigationElement",
			"position": 3,
			"name": "Transportación Nacional y Traslados",
			"description": "Traslados seguros y cómodos desde aeropuertos de Cancún, Chetumal y Tulum.",
			"url": `${siteUrl}/transportation/nacional`
		},
		{
			"@type": "SiteNavigationElement",
			"position": 4,
			"name": "Renta de Autos",
			"description": "Flota de autos modernos con asistencia en carretera para recorrer Bacalar y la Riviera Maya.",
			"url": `${siteUrl}/transportation/renta-autos`
		},
		{
			"@type": "SiteNavigationElement",
			"position": 5,
			"name": "Transportación Internacional",
			"description": "Traslados y conexión directa hacia Belice, Guatemala y destinos de Centroamérica.",
			"url": `${siteUrl}/transportation/international`
		},
		{
			"@type": "SiteNavigationElement",
			"position": 6,
			"name": "Tours Náuticos",
			"description": "Navegación en la laguna de Bacalar con veleros y pontones privados o compartidos.",
			"url": `${siteUrl}/tours/nauticos`
		}
	]
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a1628" />

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="Azulia" />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
		<link rel="canonical" href={canonical} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content="Azulia Bacalar - Servicios Marítimos y Turísticos" />
		<meta property="og:site_name" content="Azulia" />
		<meta property="og:locale" content="es_MX" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<!-- Datos Estructurados JSON-LD (Google Sitelinks, Knowledge Graph, Navigation) -->
		<script type="application/ld+json" set:html={JSON.stringify(schemaOrganization)} />
		<script type="application/ld+json" set:html={JSON.stringify(schemaWebSite)} />
		<script type="application/ld+json" set:html={JSON.stringify(schemaSiteNavigation)} />

		<!-- Fuentes y recursos -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
			rel="stylesheet"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&display=swap"
				rel="stylesheet"
			/>
		</noscript>
	</head>
	<body>
		<slot />
		<WhatsAppButton />
		<ContactModal />
	</body>
</html>

<style is:global>
	/* Force swap for bundled icon fonts to prevent render blocking */
	@font-face {
		font-family: 'bootstrap-icons';
		font-display: swap;
		src: local('bootstrap-icons');
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		scroll-behavior: smooth;
	}

	body {
		font-family: Inter, system-ui, sans-serif;
	}
	
	.material-symbols-outlined,
	.material-symbols-outlined * {
		font-family: 'Material Symbols Outlined' !important;
		font-weight: normal !important;
		font-style: normal !important;
		font-size: 24px !important;
		line-height: 1 !important;
		letter-spacing: normal !important;
		text-transform: none !important;
		display: inline-block !important;
		white-space: nowrap !important;
		word-wrap: normal !important;
		direction: ltr !important;
		-webkit-font-feature-settings: 'liga' !important;
		font-feature-settings: 'liga' !important;
		-webkit-font-smoothing: antialiased !important;
		-moz-osx-font-smoothing: grayscale !important;
		font-variation-settings: 'opsz' 24, 'wght' 400, 'FILL' 0, 'GRAD' 0 !important;
	}

	/* Browser Translation Protection (Google Translate / Edge / Safari) */
	.material-symbols-outlined,
	.notranslate {
		translate: no !important;
		-webkit-user-select: none;
		user-select: none;
	}

	font > .material-symbols-outlined,
	.material-symbols-outlined > font {
		font-family: 'Material Symbols Outlined' !important;
	}

	[lang]:not(html) .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}

	/* When Google Translate wraps content in <font> tags */
	font[style*="font-family"] .material-symbols-outlined,
	font[color] .material-symbols-outlined,
	font[style] .material-symbols-outlined,
	span[style*="font-family"] .material-symbols-outlined {
		font-family: 'Material Symbols Outlined' !important;
	}
</style>

<script>
	import "../scripts/protect-icons";
	import "../scripts/analytics-tracker";
</script>
