---
import "bootstrap-icons/font/bootstrap-icons.css";
import "../assets/styles/admin.css";
import "../assets/styles/admin_layout.css";

const { title, hideNav } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <title>{title || 'Azulia Admin'}</title>
  </head>
  <body>
    <div class="admin-bg">
      <img src="/src/assets/photos_azulia_webp/upscale_azulia_2.webp" alt="" aria-hidden="true" />
      <div class="admin-overlay"></div>
    </div>
    <div class="admin-shell">
      {!hideNav && (
      <nav class="admin-topbar">
        <a href="/admin" class="admin-topbar-brand">
          <span class="material-symbols-outlined" aria-hidden="true">sailing</span>
          Azulia Admin
        </a>
        <a href="/admin" class="admin-nav-link" data-nav>
          <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a href="/admin/mensajes" class="admin-nav-link" data-nav>
          <span class="material-symbols-outlined" aria-hidden="true">mail</span>
          <span>Mensajes</span>
        </a>
        <a href="/admin/perfiles" class="admin-nav-link" data-nav>
          <span class="material-symbols-outlined" aria-hidden="true">badge</span>
          <span>Perfiles</span>
        </a>
        <a href="/admin/galeria" class="admin-nav-link" data-nav>
          <span class="material-symbols-outlined" aria-hidden="true">wallpaper</span>
          <span>Galería</span>
        </a>
        <a href="/admin/papeleria" class="admin-nav-link" data-nav>
          <span class="material-symbols-outlined" aria-hidden="true">delete</span>
          <span>Papelera</span>
        </a>
        <span class="admin-nav-spacer"></span>
        <button class="admin-nav-logout" data-logout>
          <span class="material-symbols-outlined" aria-hidden="true">logout</span>
          <span>Salir</span>
        </button>
      </nav>
      )}
      <main class="admin-main">
        <slot />
      </main>
    </div>

    <script>
      import { auth, db } from '../lib/firebase';
      import { onAuthStateChanged, signOut } from 'firebase/auth';
      import { doc, getDoc } from 'firebase/firestore';

      const currentPath = window.location.pathname;
      const publicPaths = ['/login', '/register', '/confirm'];

      onAuthStateChanged(auth, async (user) => {
        const isPublic = publicPaths.some(p => currentPath.includes(p));
        if (!user && !isPublic) {
          window.location.href = '/admin/login';
        }
        if (user && user.email && isPublic && !currentPath.includes('/confirm')) {
          const snap = await getDoc(doc(db, 'admins', user.email.toLowerCase()));
          if (snap.exists() && snap.data().status === 'active') {
            window.location.href = '/admin';
          }
        }
      });

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-logout]');
        if (btn) {
          e.preventDefault();
          signOut(auth);
          window.location.href = '/admin/login';
        }
      });

      document.querySelectorAll('[data-nav]').forEach((link) => {
        if (link.getAttribute('href') === currentPath) {
          link.classList.add('active');
        }
      });
    </script>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    height: 100%;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }

  .admin-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .admin-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .admin-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(10, 26, 47, 0.85) 0%,
      rgba(10, 40, 60, 0.9) 50%,
      rgba(5, 20, 35, 0.95) 100%
    );
  }

  .admin-main {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 2rem;
    position: relative;
    z-index: 1;
  }
</style>
