---
import "../assets/styles/sidebar.css";
---

<div class="sidebar">
    <ul>
        <!-- Azulia: button home -->
        <li>
            <!-- logo de azulia -->
            <a href="/#" class="logo">
                <img
                    class="logo-img"
                    src="src/assets/logoSinFondo.png"
                    alt="Azulia"
                />
            </a>
        </li>
        <!-- Transportacion -->
        <li>
            <a href="/#">
                <span class="icon"
                    ><i class="material-icons">directions_bus</i></span
                >
                <span class="text">Transportacion</span>
            </a>
        </li>
        <!-- paddle -->
        <li>
            <a href="/#">
                <span class="icon"
                    ><i class="material-icons">kitesurfing</i></span
                >
                <span class="text">Paddle</span>
            </a>
        </li>
        <!-- pontom -->
        <li>
            <a href="/#" class="logo">
                <span class="icon"><i class="material-icons">anchor</i></span>
                <span class="text">Pontom</span>
            </a>
        </li>
        <!-- cayak -->
        <li>
            <a href="/#">
                <span class="icon"><i class="material-icons">kayaking</i></span>
                <span class="text">Cayak</span>
            </a>
        </li>
        <!-- velero -->
        <li>
            <a href="/#">
                <span class="icon"><i class="material-icons">sailing</i></span>
                <span class="text">Velero</span>
            </a>
        </li>
        <!-- hospedaje -->
        <li>
            <a href="/#">
                <span class="icon"><i class="material-icons">hotel</i></span>
                <span class="text">Hospedaje</span>
            </a>
        </li>
        <!-- reservacion -->
        <li>
            <a href="/#">
                <span class="icon"
                    ><i class="material-icons">date_range</i></span
                >
                <span class="text">Reservacion</span>
            </a>
        </li>
        <!-- redes -->
        <li>
            <a href="/#">
                <span class="icon"><i class="material-icons">contacts</i></span>
                <span class="text">Redes</span>
            </a>
        </li>
        <hr />
        <!-- contacto -->
        <li>
            <a href="/#">
                <span class="icon"><i class="bi bi-whatsapp"></i></span>
                <span class="text">Contacto</span>
            </a>
        </li>
