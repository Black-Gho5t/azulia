                        </a>
                    </div>
                </div>

                <a href="/transportation/nacional" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">route</span>
                    Nacional
                </a>
                <a href="/transportation/international" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">public</span>
                    Internacional
                </a>
                <a href="/transportation/renta-autos" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">car_rental</span>
                    Renta de autos
                </a>
            </div>
        </div>

    </nav>
</div>

<!-- Overlay -->
<div id="nav-overlay" class="nav-overlay"></div>


<script>
    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ BURGER / DRAWER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    const burger  = document.getElementById("navBurger")   as HTMLButtonElement;
    const drawer  = document.getElementById("nav-drawer")  as HTMLElement;
    const overlay = document.getElementById("nav-overlay") as HTMLElement;
    const closeBtn = document.getElementById("drawerClose") as HTMLButtonElement;

    function openDrawer() {
        drawer.classList.add("open");
        overlay.classList.add("open");
        burger.setAttribute("aria-expanded", "true");
        burger.classList.add("is-open");
        drawer.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
        drawer.classList.remove("open");
        overlay.classList.remove("open");
        burger.setAttribute("aria-expanded", "false");
        burger.classList.remove("is-open");
        drawer.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    burger?.addEventListener("click",  openDrawer);
    closeBtn?.addEventListener("click", closeDrawer);
    overlay?.addEventListener("click",  closeDrawer);

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") { closeDrawer(); closeMobSearch(); }
    });

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ ACORDEON TOURS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    const toursBtn = document.getElementById("toursSectionBtn") as HTMLButtonElement;
    const toursSub = document.getElementById("toursSub")        as HTMLElement;

    toursBtn?.addEventListener("click", () => {
        const isOpen = toursSub.classList.toggle("open");
        toursBtn.setAttribute("aria-expanded", String(isOpen));
    });

    const transportBtn = document.getElementById("transportSectionBtn") as HTMLButtonElement;
    const transportSub = document.getElementById("transportSub")        as HTMLElement;
    const transportTypesBtn = document.getElementById("transportTypesBtn") as HTMLButtonElement;
    const transportTypesSub = document.getElementById("transportTypesSub") as HTMLElement;

    transportBtn?.addEventListener("click", () => {
        const isOpen = transportSub.classList.toggle("open");
        transportBtn.setAttribute("aria-expanded", String(isOpen));

        if (!isOpen) {
            transportTypesSub?.classList.remove("open");
            transportTypesBtn?.setAttribute("aria-expanded", "false");
        }
    });

    transportTypesBtn?.addEventListener("click", () => {
        const isOpen = transportTypesSub.classList.toggle("open");
        transportTypesBtn.setAttribute("aria-expanded", String(isOpen));
    });

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ NAVBAR SCROLL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    const navBar = document.querySelector(".nav-bar") as HTMLElement;
    const onScroll = () => navBar?.classList.toggle("scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    /* MOBILE SEARCH TOGGLE */
    const mobToggle = document.getElementById("mobSearchToggle") as HTMLButtonElement | null;
    const mobPanel  = document.getElementById("mobSearchPanel")  as HTMLElement | null;
    const mobInput  = document.getElementById("mobSearchInput")  as HTMLInputElement | null;
    const mobClose  = document.getElementById("mobSearchClose")  as HTMLButtonElement | null;

    function submitSearch(value: string) {
        const term = value.trim();
        if (!term) return;
        window.location.href = `/buscar?q=${encodeURIComponent(term)}`;
    }

    function openMobSearch() {
        mobPanel?.classList.add("open");
        mobPanel?.setAttribute("aria-hidden", "false");
        mobToggle?.setAttribute("aria-expanded", "true");
        mobToggle?.classList.add("active");
        setTimeout(() => mobInput?.focus(), 80);
    }
    function closeMobSearch() {
        mobPanel?.classList.remove("open");
        mobPanel?.setAttribute("aria-hidden", "true");
        mobToggle?.setAttribute("aria-expanded", "false");
        mobToggle?.classList.remove("active");
    }

    mobToggle?.addEventListener("click", () =>
        mobPanel?.classList.contains("open") ? closeMobSearch() : openMobSearch()
    );
    mobClose?.addEventListener("click", closeMobSearch);
    mobInput?.addEventListener("keydown", (e) => {
        if (e.key !== "Enter") return;
        e.preventDefault();
        submitSearch(mobInput.value);
    });
</script>


<style is:global>
    /* ── RESET DE ESTILOS ANTIGUOS ── */
    /* Neutraliza las reglas de home.css que ya no se usan */
    .header-container { display: none !important; }
    .drawer           { display: none !important; }
    .drawer-overlay   { display: none !important; }

    /* ── NAVBAR ── */
    .nav-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        z-index: 1000;
        height: 64px;
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 24px;
        background: linear-gradient(90deg, #1a5fa0 0%, #2675a5 60%, #2080b5 100%);
        box-shadow: 0 2px 16px rgba(0,0,0,0.18);
        transition: background 0.35s ease, box-shadow 0.35s ease;
    }

    .nav-bar.scrolled {
        background: linear-gradient(90deg, #144e88 0%, #1a5fa0 60%, #1d70a8 100%);
        box-shadow: 0 4px 24px rgba(0,0,0,0.28);
    }

    /* Brand */
    .nav-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        flex-shrink: 0;
        margin-right: 32px;
    }

    .nav-brand-icon {
        font-size: 28px;
        color: #a8e6f7;
        line-height: 1;
    }

    .nav-brand-text {
        font-family: 'Allura', cursive, Arial, sans-serif;
        font-size: 1.7rem;
        color: #fff;
        letter-spacing: 0.04em;
        line-height: 1;
    }

    /* Desktop links */
    .nav-links {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 2px;
        flex: 1;
    }

    .nav-item {
        position: relative;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,0.88);
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        padding: 0 14px;
        height: 64px;
        position: relative;
        transition: color 0.2s;
        white-space: nowrap;
    }

    .nav-link-btn {
        border: none;
        background: transparent;
        cursor: pointer;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 14px;
        right: 14px;
        height: 3px;
        background: #a8e6f7;
        border-radius: 2px 2px 0 0;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.25s ease;
    }

    .nav-item:hover .nav-link,
    .nav-link:focus-visible {
        color: #fff;
    }

    .nav-item:hover .nav-link::after {
        transform: scaleX(1);
    }

    .nav-link-icon {
        font-size: 1.1rem;
        line-height: 1;
        color: #a8e6f7;
        transition: transform 0.2s;
    }

    .nav-chevron {
        font-size: 1.1rem;
        line-height: 1;
        color: rgba(255,255,255,0.65);
        transition: transform 0.28s ease;
        margin-left: -2px;
    }

    .nav-has-dropdown:hover .nav-chevron {
        transform: rotate(180deg);
    }

    /* Desktop dropdown */
    .nav-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 210px;
        list-style: none;
        margin: 0;
        padding: 6px 0;
        background: #2e518b;
        border-radius: 0 0 10px 10px;
        box-shadow: 0 12px 32px rgba(0,0,0,0.22);
        opacity: 0;
        transform: translateY(-6px);
        pointer-events: none;
        transition: opacity 0.22s ease, transform 0.22s ease;
        z-index: 100;
    }

    /* Invisible bridge — keeps hover alive crossing the seam */
    .nav-dropdown::before {
        content: '';
        position: absolute;
        top: -8px;
        left: 0;
        width: 100%;
        height: 8px;
    }

    .nav-has-dropdown:hover .nav-dropdown,
    .nav-has-dropdown:focus-within .nav-dropdown {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .nav-dropdown-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 18px;
        color: rgba(255,255,255,0.88);
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.875rem;
        font-weight: 400;
        letter-spacing: 0.03em;
        transition: background 0.18s, color 0.18s, padding-left 0.18s;
    }

    .nav-dropdown-link .material-symbols-outlined {
        font-size: 1.1rem;
        line-height: 1;
        color: #a8e6f7;
        flex-shrink: 0;
        transition: color 0.18s;
    }

    .nav-dropdown-link:hover {
        background: #2785c0;
        color: #fff;
        padding-left: 24px;
    }

    .nav-dropdown-link:hover .material-symbols-outlined {
        color: #fff;
    }

    .nav-dropdown-item {
        position: relative;
    }

    .nav-dropdown-toggle {
        width: 100%;
        border: none;
        background: transparent;
        cursor: pointer;
        text-align: left;
    }

    .nav-sub-chevron {
        margin-left: auto;
        font-size: 1rem;
        color: rgba(255,255,255,0.65);
        transition: transform 0.2s ease;
    }

    .nav-dropdown-item-has-submenu:hover .nav-sub-chevron,
    .nav-dropdown-item-has-submenu:focus-within .nav-sub-chevron {
        transform: translateX(2px);
        color: #fff;
    }

    .nav-sub-dropdown {
        position: absolute;
        left: 100%;
        top: -6px;
        min-width: 190px;
        list-style: none;
        margin: 0;
        padding: 6px 0;
        background: #355e9d;
        border-radius: 0 10px 10px 10px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.24);
        opacity: 0;
        transform: translateX(8px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 110;
    }

    .nav-dropdown-item-has-submenu:hover .nav-sub-dropdown,
    .nav-dropdown-item-has-submenu:focus-within .nav-sub-dropdown {
        opacity: 1;
        transform: translateX(0);
        pointer-events: auto;
    }

    .nav-sub-link {
        font-size: 0.84rem;
        background: rgba(255,255,255,0.02);
    }

    /* Right section */
    .nav-right {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-shrink: 0;
        width: clamp(200px, 22vw, 340px);
    }

    /* Search fills the right container */
    .nav-right .group {
        flex: 1;
        width: 100%;
    }

    .nav-user-btn {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 50%;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        transition: background 0.2s, border-color 0.2s;
    }

    .nav-user-btn:hover {
        background: rgba(168,230,247,0.2);
        border-color: #a8e6f7;
    }

    .nav-user-btn .material-symbols-outlined {
        font-size: 1.4rem;
        line-height: 1;
        color: rgba(255,255,255,0.9);
    }

    /* Burger (mobile only) */
    .nav-burger {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 10px;
        cursor: pointer;
        padding: 8px;
        margin-right: 12px;
        flex-shrink: 0;
        transition: background 0.2s;
    }

    .nav-burger:hover { background: rgba(255,255,255,0.16); }

    .nav-burger span {
        display: block;
        width: 100%;
        height: 2px;
        background: #fff;
        border-radius: 2px;
        transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
        transform-origin: center;
    }

    .nav-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
