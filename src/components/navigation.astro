<!-- Overlay -->
<div id="nav-overlay" class="nav-overlay"></div>


<script>
    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ BURGER / DRAWER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    const burger  = document.getElementById("navBurger")   as HTMLButtonElement;
    const drawer  = document.getElementById("nav-drawer")  as HTMLElement;
    const overlay = document.getElementById("nav-overlay") as HTMLElement;
    const closeBtn = document.getElementById("drawerClose") as HTMLButtonElement;

    function openDrawer() {
        drawer.classList.add("open");
        overlay.classList.add("open");
        burger.setAttribute("aria-expanded", "true");
        burger.classList.add("is-open");
        drawer.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
        drawer.classList.remove("open");
        overlay.classList.remove("open");
        burger.setAttribute("aria-expanded", "false");
        burger.classList.remove("is-open");
        drawer.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    burger?.addEventListener("click",  openDrawer);
    closeBtn?.addEventListener("click", closeDrawer);
    overlay?.addEventListener("click",  closeDrawer);

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeDrawer();
    });

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ ACORDEON TOURS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    const toursBtn = document.getElementById("toursSectionBtn") as HTMLButtonElement;
    const toursSub = document.getElementById("toursSub")        as HTMLElement;

    toursBtn?.addEventListener("click", () => {
        const isOpen = toursSub.classList.toggle("open");
        toursBtn.setAttribute("aria-expanded", String(isOpen));
    });

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ HOME BUTTON VISIBILITY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    function checkIfHomePage() {
        const path = window.location.pathname;
        const isHome = path === "/" || path === "" || path === "/index.astro";

        const homeBtn    = document.getElementById("home-button");
        const homeDrawer = document.getElementById("home-drawer-button");

        const toggle = (el: HTMLElement | null, hide: boolean) => {
            if (!el) return;
            el.classList.toggle("home-button-hidden",  hide);
            el.classList.toggle("home-button-visible", !hide);
        };

        toggle(homeBtn,    isHome);
        toggle(homeDrawer, isHome);
    }

    checkIfHomePage();
    window.addEventListener("popstate", checkIfHomePage);

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ NAVBAR SCROLL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    const navBar = document.querySelector(".nav-bar") as HTMLElement;
    const onScroll = () => navBar?.classList.toggle("scrolled", window.scrollY > 40);
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
</script>


<style is:global>
    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ RESET DE ESTILOS ANTIGUOS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    /* Neutraliza las reglas de home.css que ya no se usan */
    .header-container { display: none !important; }
    .drawer           { display: none !important; }
    .drawer-overlay   { display: none !important; }

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ FONTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    @import url('https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200');

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ NAVBAR â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .nav-bar {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        box-sizing: border-box;
        z-index: 1000;
        height: 64px;
        display: flex;
        align-items: center;
        gap: 0;
        padding: 0 24px;
        background: linear-gradient(90deg, #1a5fa0 0%, #2675a5 60%, #2080b5 100%);
        box-shadow: 0 2px 16px rgba(0,0,0,0.18);
        transition: background 0.35s ease, box-shadow 0.35s ease;
    }

    .nav-bar.scrolled {
        background: linear-gradient(90deg, #144e88 0%, #1a5fa0 60%, #1d70a8 100%);
        box-shadow: 0 4px 24px rgba(0,0,0,0.28);
    }

    /* Brand */
    .nav-brand {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        flex-shrink: 0;
        margin-right: 32px;
    }

    .nav-brand-icon {
        font-family: 'Material Symbols Outlined';
        font-size: 28px;
        color: #a8e6f7;
        line-height: 1;
    }

    .nav-brand-text {
        font-family: 'Allura', cursive, Arial, sans-serif;
        font-size: 1.7rem;
        color: #fff;
        letter-spacing: 0.04em;
        line-height: 1;
    }

    /* Desktop links */
    .nav-links {
        display: flex;
        align-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 2px;
        flex: 1;
    }

    .nav-item {
        position: relative;
    }

    .nav-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: rgba(255,255,255,0.88);
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        padding: 0 14px;
        height: 64px;
        position: relative;
        transition: color 0.2s;
        white-space: nowrap;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 14px;
        right: 14px;
        height: 3px;
        background: #a8e6f7;
        border-radius: 2px 2px 0 0;
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.25s ease;
    }

    .nav-item:hover .nav-link,
    .nav-link:focus-visible {
        color: #fff;
    }

    .nav-item:hover .nav-link::after {
        transform: scaleX(1);
    }

    .nav-link-icon {
        font-family: 'Material Symbols Outlined';
        font-size: 1.1rem;
        line-height: 1;
        color: #a8e6f7;
        transition: transform 0.2s;
    }

    .nav-chevron {
        font-family: 'Material Symbols Outlined';
        font-size: 1.1rem;
        line-height: 1;
        color: rgba(255,255,255,0.65);
        transition: transform 0.28s ease;
        margin-left: -2px;
    }

    .nav-has-dropdown:hover .nav-chevron {
        transform: rotate(180deg);
    }

    /* Desktop dropdown */
    .nav-dropdown {
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 220px;
        list-style: none;
        margin: 0;
        padding: 6px 0 8px;
        background: #fff;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 12px 40px rgba(22,50,79,0.18), 0 2px 8px rgba(0,0,0,0.08);
        opacity: 0;
        transform: translateY(-6px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
        z-index: 100;
        border-top: 3px solid #2675a5;
    }

    /* Bridge invisible gap so hover doesn't break between trigger and panel */
    .nav-dropdown::before {
        content: '';
        position: absolute;
        top: -8px;
        left: 0;
        width: 100%;
        height: 8px;
    }

    .nav-has-dropdown:hover .nav-dropdown,
    .nav-has-dropdown:focus-within .nav-dropdown {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
    }

    .nav-dropdown-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        color: #16324f;
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.875rem;
        font-weight: 500;
        transition: background 0.15s, color 0.15s, padding-left 0.15s;
    }

    .nav-dropdown-link .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-size: 1.15rem;
        line-height: 1;
        color: #2675a5;
        flex-shrink: 0;
        transition: color 0.15s;
    }

    .nav-dropdown-link:hover {
        background: rgba(38,117,165,0.07);
        color: #2675a5;
        padding-left: 24px;
    }

    .nav-dropdown-link:hover .material-symbols-outlined {
        color: #217b96;
    }

    /* Right section */
    .nav-right {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: auto;
        flex-shrink: 0;
    }

    .nav-user-btn {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 50%;
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        transition: background 0.2s, border-color 0.2s;
    }

    .nav-user-btn:hover {
        background: rgba(168,230,247,0.2);
        border-color: #a8e6f7;
    }

    .nav-user-btn .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-size: 1.4rem;
        line-height: 1;
        color: rgba(255,255,255,0.9);
    }

    /* Home button visibility */
    #home-button.home-button-hidden  { display: none; }
    #home-button.home-button-visible { display: flex; }

    /* Burger (mobile only) */
    .nav-burger {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        width: 40px;
        height: 40px;
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.22);
        border-radius: 10px;
        cursor: pointer;
        padding: 8px;
        margin-right: 12px;
        flex-shrink: 0;
        transition: background 0.2s;
    }

    .nav-burger:hover { background: rgba(255,255,255,0.16); }

    .nav-burger span {
        display: block;
        width: 100%;
        height: 2px;
        background: #fff;
        border-radius: 2px;
        transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
        transform-origin: center;
    }

    .nav-burger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-burger.is-open span:nth-child(2) { opacity: 0; width: 0; }
    .nav-burger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ DRAWER MÃ“VIL â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ */
    .nav-drawer {
        position: fixed;
        top: 0;
        left: 0;
        width: 300px;
        max-width: 85vw;
        height: 100dvh;
        background: linear-gradient(160deg, #1a5fa0 0%, #0d3b6e 100%);
        z-index: 1100;
        transform: translateX(-105%);
        transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        overflow-y: auto;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: 6px 0 40px rgba(0,0,0,0.35);
    }

    .nav-drawer.open {
        transform: translateX(0);
    }

    /* Drawer header */
    .drawer-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 20px;
        height: 64px;
        background: rgba(255,255,255,0.05);
        border-bottom: 1px solid rgba(255,255,255,0.1);
        flex-shrink: 0;
    }

    .drawer-brand-icon {
        font-family: 'Material Symbols Outlined';
        font-size: 26px;
        color: #a8e6f7;
        line-height: 1;
    }

    .drawer-brand-text {
        font-family: 'Allura', cursive, Arial, sans-serif;
        font-size: 1.5rem;
        color: #fff;
        flex: 1;
    }

    .drawer-close-btn {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.15);
