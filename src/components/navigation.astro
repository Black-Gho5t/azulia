        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: rgba(255,255,255,0.7);
        transition: background 0.2s, color 0.2s;
    }

    .drawer-close-btn:hover { background: rgba(255,255,255,0.16); color: #fff; }

    .drawer-close-btn .material-symbols-outlined {
        font-family: 'Material Symbols Outlined';
        font-size: 1.2rem;
        line-height: 1;
    }

    /* Drawer body */
    .drawer-body {
        display: flex;
        flex-direction: column;
        padding: 12px 0 24px;
        flex: 1;
    }

    /* Regular drawer link */
    .drawer-link {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 24px;
        color: rgba(255,255,255,0.82);
        text-decoration: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.98rem;
        font-weight: 500;
        letter-spacing: 0.03em;
        border-left: 3px solid transparent;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .drawer-link:hover {
        background: rgba(168,230,247,0.12);
        color: #fff;
        border-left-color: #a8e6f7;
    }

    .drawer-link-icon {
        font-family: 'Material Symbols Outlined';
        font-size: 1.35rem;
        line-height: 1;
        color: #a8e6f7;
        flex-shrink: 0;
    }

    /* Home visibility in drawer */
    #home-drawer-button.home-button-hidden  { display: none; }
    #home-drawer-button.home-button-visible { display: flex; }

    /* Drawer section (accordion) */
    .drawer-section {
        display: flex;
        flex-direction: column;
    }

    .drawer-section-btn {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 24px;
        background: none;
        border: none;
        border-left: 3px solid transparent;
        color: rgba(255,255,255,0.82);
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.98rem;
        font-weight: 500;
        letter-spacing: 0.03em;
        cursor: pointer;
        text-align: left;
        width: 100%;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

    .drawer-section-btn:hover {
        background: rgba(168,230,247,0.12);
        color: #fff;
        border-left-color: #a8e6f7;
    }

    .drawer-chevron {
        font-family: 'Material Symbols Outlined';
        font-size: 1.2rem;
        line-height: 1;
        color: rgba(255,255,255,0.5);
        margin-left: auto;
        transition: transform 0.3s ease, color 0.2s;
    }

    .drawer-section-btn[aria-expanded="true"] .drawer-chevron {
        transform: rotate(180deg);
