<div id="drawer-overlay" class="drawer-overlay"></div>
<!-- llamada al sidebar COMPONENTE -->
<!-- script para mover el sidebar NECESARIO -->
<script>
    const burger = document.getElementById("burger") as HTMLInputElement;
    const drawer = document.getElementById("menu-drawer");
    const overlay = document.getElementById("drawer-overlay");

    if (burger && drawer && overlay) {
        burger.addEventListener("change", () => {
            if (burger.checked) {
                drawer.classList.add("open");
                overlay.classList.add("open");
            } else {
                drawer.classList.remove("open");
                overlay.classList.remove("open");
            }
        });

        // Cerrar al hacer click en el overlay
        overlay.addEventListener("click", () => {
            burger.checked = false;
            drawer.classList.remove("open");
            overlay.classList.remove("open");
        });
    }

    // Detectar si estamos en la página de home
    function checkIfHomePage() {
        const currentPath = window.location.pathname;
        const homeButton = document.getElementById("home-button");
        const homeDrawerButton = document.getElementById("home-drawer-button");

        const isHomePage =
            currentPath === "/" ||
            currentPath === "/index.astro" ||
            currentPath === "";

        // Actualizar botón en navegación principal
        if (homeButton) {
            if (isHomePage) {
                homeButton.classList.add("home-button-hidden");
                homeButton.classList.remove("home-button-visible");
            } else {
                homeButton.classList.remove("home-button-hidden");
                homeButton.classList.add("home-button-visible");
            }
        }

        // Actualizar botón en drawer móvil
        if (homeDrawerButton) {
            if (isHomePage) {
                homeDrawerButton.classList.add("home-button-hidden");
                homeDrawerButton.classList.remove("home-button-visible");
            } else {
                homeDrawerButton.classList.remove("home-button-hidden");
                homeDrawerButton.classList.add("home-button-visible");
            }
        }
    }

    // Ejecutar al cargar
    checkIfHomePage();

    // Ejecutar cuando cambia la URL (para navegacion del cliente)
    window.addEventListener("popstate", checkIfHomePage);
</script>

<style>
    #home-button {
        display: none;
    }

    #home-button.home-button-visible {
        display: flex;
        align-items: center;
    }

    #home-button.home-button-hidden {
        display: none;
    }

    #home-button .home-link {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: white;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        transition: background-color 0.3s ease;
    }

    #home-button .home-link:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    #home-button svg {
        width: 16px;
        height: 16px;
    }

    /* Estilos para el botón home en el drawer móvil */
    #home-drawer-button {
        display: none;
    }

    #home-drawer-button.home-button-visible {
        display: block;
    }

    #home-drawer-button.home-button-hidden {
        display: none;
    }

    #home-drawer-button a {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: inherit;
        text-decoration: none;
    }

    #home-drawer-button svg {
        width: 16px;
        height: 16px;
    }
</style>
