                <a href="/#">Transportacion</a>
                <ul class="item">
                    <li class="item"><a href="/#">Nacional</a></li>
                    <li class="item"><a href="/#">Internacional</a></li>
                </ul>
            </li>
        </ul>
        <!-- menu desplegable de hoteles (aun no nos dan la lista) -->
        <!-- menu desplegable de transportacion -->
    </div>
    <div class="right-buttons">
        <!-- Contacto en version anterior -->
        <!-- aqui iba -->
        <div class="search-container">
            <Search />
            <button class="left-menu">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="30"
                    height="30"
                    fill="currentColor"
                    class="bi bi-person-circle"
                    viewBox="0 0 16 16"
                >
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"></path>
                    <path
                        fill-rule="evenodd"
                        d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"
                    ></path>
                </svg>
            </button>
        </div>
    </div>
</nav>

<!-- llamada al sidebar COMPONENTE -->

<MainPage />

