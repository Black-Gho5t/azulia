---
import Search from "./search.astro";
import MainPage from "./mainPage.astro";
import "../assets/styles/home.css";
---

<!-- 
Documento de header y navegacion, los links llevan a 
archivos donde tendremos la informacion restante para
no acumular tantos menus desplegables en el mismo.
-->
<nav class="header-container">
    <div class="left-buttons">
        <button class="left-menu">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="37"
                height="37"
                fill="white"
                class="bi bi-list"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"
                ></path>
            </svg>
        </button>
    </div>
    <div class="pages-nav menu">
        <!-- menus principales -->
        <ul>
            <li>
                <svg
                    id="icon-menu"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="white"
                    class="bi bi-person-walking"
                    viewBox="0 0 16 16"
                >
                    <path
                        d="M9.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M6.44 3.752A.75.75 0 0 1 7 3.5h1.445c.742 0 1.32.643 1.243 1.38l-.43 4.083a1.8 1.8 0 0 1-.088.395l-.318.906.213.242a.8.8 0 0 1 .114.175l2 4.25a.75.75 0 1 1-1.357.638l-1.956-4.154-1.68-1.921A.75.75 0 0 1 6 8.96l.138-2.613-.435.489-.464 2.786a.75.75 0 1 1-1.48-.246l.5-3a.75.75 0 0 1 .18-.375l2-2.25Z"
                    ></path>
                    <path
                        d="M6.25 11.745v-1.418l1.204 1.375.261.524a.8.8 0 0 1-.12.231l-2.5 3.25a.75.75 0 1 1-1.19-.914zm4.22-4.215-.494-.494.205-1.843.006-.067 1.124 1.124h1.44a.75.75 0 0 1 0 1.5H11a.75.75 0 0 1-.531-.22Z"
                    ></path>
                </svg>
                <a href="/#">Tours</a>
                <!-- menu desplegable de tours -->
                <ul class="item">
                    <li class="item"><a href="/#">Nauticos</a></li>
                    <li class="item"><a href="/#">Ruinas</a></li>
                    <li class="item"><a href="/#">Mahahual</a></li>
                    <li class="item"><a href="/#">Guatemala</a></li>
                    <li class="item"><a href="/#">Honduras</a></li>
                    <li class="item"><a href="/#">Belice</a></li>
                </ul>
            </li>
            <li>
                <svg
                    id="icon-menu"
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    fill="white"
                    class="bi bi-buildings"
                    viewBox="0 0 16 16"
                >
                    <path
                        d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022M6 8.694 1 10.36V15h5zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.309l-7 3.5z"
