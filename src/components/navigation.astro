            type="search"
            placeholder="Buscar destinos, tours..."
            autocomplete="off"
        />
<button class="mob-search-close" id="mobSearchClose" aria-label="Cerrar búsqueda">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
