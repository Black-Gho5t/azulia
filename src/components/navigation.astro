                    <span class="material-symbols-outlined" aria-hidden="true">anchor</span>
                    Náuticos
                </a>
                <a href="/tours/ruinas" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">account_balance</span>
                    Ruinas
                </a>
                <a href="/tours/mahahual" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">beach_access</span>
                    Mahahual
                </a>
                <a href="/tours/guatemala" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">forest</span>
                    Guatemala
                </a>
                <a href="/tours/honduras" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">scuba_diving</span>
                    Honduras
                </a>
                <a href="/tours/belice" class="drawer-sub-link">
                    <span class="material-symbols-outlined" aria-hidden="true">water</span>
                    Belice
                </a>
            </div>
        </div>

        <a href="/hotels/hoteles_index" class="drawer-link">
            <span class="drawer-link-icon material-symbols-outlined" aria-hidden="true">hotel</span>
            <span>Hoteles</span>
        </a>

        <div class="drawer-section">
            <button class="drawer-section-btn" id="transportSectionBtn" aria-expanded="false">
                <span class="drawer-link-icon material-symbols-outlined" aria-hidden="true">airport_shuttle</span>
                <span>Transportación</span>
                <span class="drawer-chevron material-symbols-outlined" aria-hidden="true">expand_more</span>
            </button>
            <div class="drawer-sub" id="transportSub">
                <div class="drawer-sub-group">
                    <button class="drawer-sub-toggle" id="transportTypesBtn" aria-expanded="false" type="button">
                        <span class="material-symbols-outlined" aria-hidden="true">alt_route</span>
                        Tipos de transporte
                        <span class="drawer-sub-chevron material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>
                    <div class="drawer-sub-nested" id="transportTypesSub">
                        <a href="/menu" class="drawer-sub-link drawer-sub-link--nested">
                            <span class="material-symbols-outlined" aria-hidden="true">local_taxi</span>
                            Taxi
                        </a>
                        <a href="/menu" class="drawer-sub-link drawer-sub-link--nested">
                            <span class="material-symbols-outlined" aria-hidden="true">directions_car</span>
                            Uber
                        </a>
                        <a href="/menu" class="drawer-sub-link drawer-sub-link--nested">
                            <span class="material-symbols-outlined" aria-hidden="true">verified_user</span>
                            Privado
                        </a>
                        <a href="/menu" class="drawer-sub-link drawer-sub-link--nested">
                            <span class="material-symbols-outlined" aria-hidden="true">directions_bus</span>
