    </div>
</div>

<div id="nav-drawer" class="nav-drawer" aria-hidden="true">

    <!-- Cabecera del drawer -->
    <div class="drawer-header">
        <span class="material-symbols-outlined drawer-brand-icon" aria-hidden="true">sailing</span>
        <span class="drawer-brand-text">Azulia</span>
        <button class="drawer-close-btn" id="drawerClose" aria-label="Cerrar menú">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
    </div>

    <!-- Lista principal -->
    <nav class="drawer-body">

        <!-- Tours — acordeon -->
        <div class="drawer-section">
            <button class="drawer-section-btn" id="toursSectionBtn" aria-expanded="false">
