---
import "../assets/styles/modal.css";
interface Props {
    id: string;
    title: string;
    images: string[];
    text: string;
    schedule: string;
    price: string;
    rating?: string;
    duration?: string;
    capacity?: string;
    ageRange?: string;
    includes?: string[];
    nearby?: string[];
    variant?: string;
}

const { 
    id, 
    title, 
    images, 
    text, 
    schedule, 
    price, 
    rating,
    duration,
    capacity,
    ageRange,
    includes = [],
    nearby = [],
    variant = "" 
} = Astro.props;
---

<div id={`modal-${id}`} class={`dmodal-overlay ${variant}`}>
    <div class="dmodal-content">
        <button class="dmodal-close" aria-label="Cerrar">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <!-- Carrusel de imágenes -->
        <div class="dmodal-images">
            {
                images.map((src, i) => (
                    <img
                        src={src}
                        alt={`${title} ${i + 1}`}
                        class={`dmodal-img ${i === 0 ? "active" : ""}`}
                        data-img-index={i}
                        loading="lazy"
                    />
                ))
            }
            {
                images.length > 1 && (
                    <div class="dmodal-img-nav">
                        <button class="dmodal-img-prev" aria-label="Anterior">
                            &#8592;
                        </button>
                        <span class="dmodal-img-counter">
                            1 / {images.length}
                        </span>
                        <button class="dmodal-img-next" aria-label="Siguiente">
                            &#8594;
                        </button>
                    </div>
                )
            }
        </div>

        <!-- Contenido derecho -->
        <div class="dmodal-info">
            <!-- Encabezado con título y rating -->
            <div class="dmodal-header">
                <h2 class="dmodal-title">{title}</h2>
                {rating && (
                    <div class="dmodal-rating">
                        <span class="stars">★★★★★</span>
                        <span class="rating-text">{rating}</span>
                    </div>
                )}
            </div>

            <!-- Descripción -->
            <p class="dmodal-description">{text}</p>

            <!-- Sección Overview -->
            <div class="dmodal-overview">
                <h3 class="overview-title">Información del Tour</h3>
                <div class="overview-grid">
                    {duration && (
                        <div class="overview-item">
                            <span class="overview-label">Duración</span>
                            <span class="overview-value">{duration}</span>
                        </div>
                    )}
                    {ageRange && (
                        <div class="overview-item">
                            <span class="overview-label">Edad mínima</span>
                            <span class="overview-value">{ageRange}</span>
                        </div>
                    )}
                    {capacity && (
                        <div class="overview-item">
                            <span class="overview-label">Capacidad</span>
                            <span class="overview-value">{capacity}</span>
                        </div>
                    )}
                    <div class="overview-item">
                        <span class="overview-label">Horario</span>
                        <span class="overview-value">{schedule}</span>
                    </div>
                </div>
            </div>

            <!-- Lo que incluye -->
            {includes.length > 0 && (
                <div class="dmodal-includes">
                    <h3 class="includes-title">Qué incluye</h3>
                    <ul class="includes-list">
                        {includes.map((item) => (
                            <li class="include-item">
                                <span class="include-icon">✓</span>
                                {item}
                            </li>
                        ))}
                    </ul>
                </div>
            )}

            <!-- Ubicación y alrededores -->
            {nearby.length > 0 && (
                <div class="dmodal-nearby">
                    <h3 class="nearby-title">Lo que hay cerca</h3>
                    <div class="nearby-list">
                        {nearby.map((place) => (
                            <div class="nearby-item">
                                <span class="location-icon">📍</span>
                                {place}
                            </div>
                        ))}
                    </div>
                </div>
            )}

            <!-- Pie de página con precio y botón -->
            <div class="dmodal-footer">
                <div class="footer-left">
                    <span class="footer-label">Precio</span>
                    <span class="dmodal-price">{price}</span>
                </div>
                <button class="reserve-btn">Reservar ahora</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Inicializar todos los modales presentes en la página
    document.querySelectorAll(".dmodal-overlay").forEach((overlay) => {
        const closeBtn = overlay.querySelector(".dmodal-close");
        const imgs = overlay.querySelectorAll(".dmodal-img");
        const prevBtn = overlay.querySelector(".dmodal-img-prev");
        const nextBtn = overlay.querySelector(".dmodal-img-next");
        const counter = overlay.querySelector(".dmodal-img-counter");
        const reserveBtn = overlay.querySelector(".reserve-btn");

        let current = 0;

        function showImg(index: number) {
            imgs.forEach((img, i) => {
                img.classList.toggle("active", i === index);
            });
            if (counter) counter.textContent = `${index + 1} / ${imgs.length}`;
        }

        // Navegación de imágenes
        prevBtn?.addEventListener("click", () => {
            current = current > 0 ? current - 1 : imgs.length - 1;
            showImg(current);
        });

        nextBtn?.addEventListener("click", () => {
            current = current < imgs.length - 1 ? current + 1 : 0;
            showImg(current);
        });

        // Botón de reserva
        reserveBtn?.addEventListener("click", () => {
            alert("¡Gracias por tu interés! Para completar tu reserva, por favor contáctanos.");
        });

        // Cerrar con botón X
        closeBtn?.addEventListener("click", () => {
            overlay.classList.remove("open");
            current = 0;
            showImg(0);
        });

        // Cerrar al hacer click fuera
        overlay.addEventListener("click", (e) => {
            if (e.target === overlay) {
                overlay.classList.remove("open");
                current = 0;
                showImg(0);
            }
        });
    });
</script>
