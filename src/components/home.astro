---
import Search from "./search.astro";
import MainPage from "./mainPage.astro";
import "../assets/styles/home.css";
---

<div class="header-container">
    <div class="left-buttons">
        <button class="left-menu">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="37"
                height="37"
                fill="white"
                class="bi bi-list"
                viewBox="0 0 16 16"
            >
                <path
                    fill-rule="evenodd"
                    d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"
                ></path>
            </svg>
        </button>
    </div>
    <div class="pages-nav">
        <ul><h3><a href="/#">Tours</a></h3></ul>
        <ul><h3><a href="/#">Hoteles</a></h3></ul>
        <ul><h3><a href="/#">Transportacion</a></h3></ul>
    </div>
    <div class="right-buttons">
        <!-- Contacto en version anterior -->
        <!-- aqui iba -->
        <div class="search-container">
            <Search />
            <button class="left-menu">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="30"
                    height="30"
                    fill="currentColor"
                    class="bi bi-person-circle"
                    viewBox="0 0 16 16"
                >
                    <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"></path>
                    <path
                        fill-rule="evenodd"
                        d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"
                    ></path>
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- llamada al sidebar COMPONENTE -->

<MainPage />

