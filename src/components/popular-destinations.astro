---
import "../assets/styles/destinations.css";
import DestinationModal from "../components/destination_modal.astro";
import type { ImageMetadata } from "astro";
import card1 from "../assets/cards_img/card_1_pontom.webp";
import card2 from "../assets/cards_img/card_2_paddle.jpg";
import card3 from "../assets/cards_img/card_3_transportacion.jpg";

interface Props {
    title?: string;
    destinations?: Array<{
        id: string;
        name: string;
        description: string;
        price: string;
        image: ImageMetadata;
    }>;
}

const {
    title = "Actividades",
    destinations = [
        {
            id: "ponton",
            name: "Pontón",
            description:
                "Descubre la magia del mar Caribe, explora costas vírgenes y vive experiencias inolvidables en el agua.",
            price: "$60 USD",
            image: card1,
        },
        {
            id: "paddle",
            name: "Paddle",
            description:
                "Descubre la magia del mar Caribe, explora costas vírgenes y vive experiencias inolvidables en el agua.",
            price: "$80 USD",
            image: card2,
        },
        {
            id: "transporte",
            name: "Transportación",
            description:
                "Descubre la magia del mar Caribe, explora costas vírgenes y vive experiencias inolvidables en el agua.",
            price: "$75 USD",
            image: card3,
        },
        {
            id: "snorkel",
            name: "Snorkel",
            description:
                "Descubre la magia del mar Caribe, explora costas vírgenes y vive experiencias inolvidables en el agua.",
            price: "$70 USD",
            image: card1,
        },
    ],
} = Astro.props;

const modalData = [
    {
        id: "ponton",
        title: "Pontón",
        images: [card1.src, card2.src],
        schedule: "Lunes a Viernes 9am - 5pm",
        price: "$60 USD",
        text: "Descripción larga del tour de pontón...",
    },
    {
        id: "paddle",
        title: "Paddle",
        images: [card2.src, card1.src],
        schedule: "Lunes a Viernes 9am - 5pm",
        price: "$80 USD",
        text: "Descripción larga del tour de paddle...",
    },
    {
        id: "transporte",
        title: "Transportación",
        images: [card3.src, card1.src],
        schedule: "Lunes a Viernes 9am - 5pm",
        price: "$75 USD",
        text: "Descripción larga del tour de transportación...",
    },
    {
        id: "snorkel",
        title: "Snorkel",
        images: [card1.src, card2.src],
        schedule: "Lunes a Viernes 9am - 5pm",
        price: "$70 USD",
        text: "Descripción larga del tour de snorkel...",
    },
];
---

{
    modalData.map((m) => (
        <DestinationModal
            id={m.id}
            title={m.title}
            images={m.images}
            text={m.text}
            schedule={m.schedule}
            price={m.price}
        />
    ))
}

<section class="destinations-section">
    <div class="destinations-container">
        <h2 class="destinations-title">{title}</h2>
        <div class="carousel-wrapper">
            <button
                class="carousel-nav carousel-nav-prev"
                aria-label="Anterior"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
            </button>

            <div class="carousel-container">
                <div class="carousel-track">
                    {
                        destinations.map((destination, index) => (
                            <div
                                class="carousel-card"
                                data-index={index}
                                data-id={destination.id}
                            >
                                <div class="card-image">
                                    <img
                                        src={destination.image.src}
                                        alt={destination.name}
                                        loading="lazy"
                                    />
                                </div>
                                <div class="card-content">
                                    <h3 class="card-title">
                                        {destination.name}
                                    </h3>
                                    <p class="card-description">
                                        {destination.description}
                                    </p>
                                    <p class="card-price">
                                        {destination.price}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <button
                class="carousel-nav carousel-nav-next"
                aria-label="Siguiente"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"></path>
                </svg>
            </button>
        </div>
    </div>
</section>

<script>
    const prevBtn = document.querySelector(
        ".carousel-nav-prev",
    ) as HTMLButtonElement;
    const nextBtn = document.querySelector(
        ".carousel-nav-next",
    ) as HTMLButtonElement;
    const track = document.querySelector(".carousel-track") as HTMLElement;
    const cards = document.querySelectorAll(".carousel-card");

    let currentIndex = 0;

    function getCardWidthPercent(): number {
        if (!cards.length || !track) return 0;
        const card = cards[0] as HTMLElement;
        const trackWidth = track.parentElement?.offsetWidth || 0;
        const gap = parseInt(window.getComputedStyle(track).gap) || 0;
        return ((card.offsetWidth + gap) / trackWidth) * 100;
    }

    function updateCarousel() {
        if (track)
            track.style.transform = `translateX(${currentIndex * -getCardWidthPercent()}%)`;
        const canPrev = currentIndex > 0;
        const canNext = currentIndex < cards.length - 1;
        if (prevBtn) {
            prevBtn.classList.toggle("disabled", !canPrev);
            prevBtn.disabled = !canPrev;
        }
        if (nextBtn) {
            nextBtn.classList.toggle("disabled", !canNext);
            nextBtn.disabled = !canNext;
        }
    }

    prevBtn?.addEventListener("click", () => {
        if (currentIndex > 0) {
            currentIndex--;
            updateCarousel();
        }
    });
    nextBtn?.addEventListener("click", () => {
        if (currentIndex < cards.length - 1) {
            currentIndex++;
            updateCarousel();
        }
    });

    updateCarousel();
    window.addEventListener("resize", updateCarousel);

    // Abrir modal al hacer click en una card
    cards.forEach((card) => {
        card.addEventListener("click", () => {
            const id = card.getAttribute("data-id");
            document.getElementById(`modal-${id}`)?.classList.add("open");
        });
    });
</script>
