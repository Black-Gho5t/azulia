---

<link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
/>

<div class="feature-cards">
    <div class="header-card">
        <svg
            id="icon-menu"
            xmlns="http://www.w3.org/2000/svg"
            width="45"
            height="45"
            fill="#1c5fa8"
            class="bi bi-person-walking"
            viewBox="0 0 16 16"
        >
            <path
                d="M9.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M6.44 3.752A.75.75 0 0 1 7 3.5h1.445c.742 0 1.32.643 1.243 1.38l-.43 4.083a1.8 1.8 0 0 1-.088.395l-.318.906.213.242a.8.8 0 0 1 .114.175l2 4.25a.75.75 0 1 1-1.357.638l-1.956-4.154-1.68-1.921A.75.75 0 0 1 6 8.96l.138-2.613-.435.489-.464 2.786a.75.75 0 1 1-1.48-.246l.5-3a.75.75 0 0 1 .18-.375l2-2.25Z"
            ></path>
            <path
                d="M6.25 11.745v-1.418l1.204 1.375.261.524a.8.8 0 0 1-.12.231l-2.5 3.25a.75.75 0 1 1-1.19-.914zm4.22-4.215-.494-.494.205-1.843.006-.067 1.124 1.124h1.44a.75.75 0 0 1 0 1.5H11a.75.75 0 0 1-.531-.22Z"
            ></path>
        </svg>
        <h2 class="card-title">Tours</h2>
        <p>Explora nuestra variedad de tours</p>
    </div>
    <div class="card-product">
        <div class="subtitle">
            <span class="material-symbols-outlined icon-nauticos">anchor</span>
            <h3>Nauticos</h3>
        </div>

        <p>
            Diviertete con nuestros multiples tours y experiencias nauticas en
            la laguna de Bacalar y sus alrededores
        </p>
        <div class="card-container">
            <!-- ! seccion de cards horizontales -->
            {
                nauticosTours.map((tour) => (
                    <button class="card-item" data-id={tour.id}>
                        <div class="img-card">
                            <img src={tour.image.src} alt={tour.name} />
                        </div>
                        <div class="title-card">
                            <span class="material-symbols-outlined">
                                {tour.icon}
                            </span>
                            <p>{tour.name}</p>
                        </div>
                        <div class="contend-card">
                            <p>{tour.description}</p>
                        </div>
                    </button>
                ))
            }
        </div>
    </div>
</div>
<!-- Modales de Tours -->
{
    modalData.map((m) => (
        <DestinationModal
            id={m.id}
            title={m.title}
            images={m.images}
            text={m.text}
            schedule={m.schedule}
            price={m.price}
            rating={m.rating}
            duration={m.duration}
            capacity={m.capacity}
            ageRange={m.ageRange}
            includes={m.includes}
            nearby={m.nearby}
        />
    ))
}
<style>
    @import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200");

    .material-symbols-outlined {
        font-family: "Material Symbols Outlined";
        font-weight: normal;
        font-style: normal;
        font-size: 40px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        color: #1c5fa8;
        -webkit-font-smoothing: antialiased;
    }

    .icon-tours,
    .icon-nauticos {
        font-variation-settings:
            "FILL" 0,
            "wght" 400,
            "GRAD" 0,
            "opsz" 48;
    }

    .feature-cards {
        background: white;
        padding: 20px;
        padding-top: 35px;
        border-radius: 30px;
    }

    .header-card {
        display: flex;
        align-items: center;
    }

    .card-title {
        font-size: 35px;
        padding-left: 10px;
    }

    .header-card p {
        position: relative;
        padding-left: 12px;
    }

    .card-product {
        background-color: #c8dcfa;
        padding: 10px;
        padding-top: 20px;
        border-radius: 25px;
    }

    .subtitle {
        padding-left: 20px;
        display: flex;
        align-items: center;
    }

    .subtitle h3 {
        padding-left: 10px;
        font-size: 22px;
    }
    .card-product p {
        padding-left: 40px;
        padding-right: 40px;
    }

    .card-item {
        background-color: white;
        width: 250px;
        border-radius: 20px;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease;
        border: none;
    }

    .card-item img {
        width: 100%;
        min-width: 230px;
        height: 200px;
        aspect-ratio: 16/9;
        object-fit: cover;
        display: block;
        border-radius: 20px 20px 0 0;
    }

    .title-card {
        display: flex;
        align-items: center;
        padding-left: 15px;
        padding-top: 10px;
    }

    .title-card p {
        font-size: 20px;
        font-weight: bold;
        margin-left: -25px;
    }

    .contend-card {
        margin-top: -10px;
        padding-bottom: 10px;
    }

    .contend-card p {
        text-align: justify;
    }

    .card-item:hover {
        transform: scale(1.03);
    }

    .card-container {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        flex-wrap: nowrap;
    }
</style>
<script>
    const tourCards = document.querySelectorAll(".card-item");
    const contactButtons = document.querySelectorAll(".contact-btn");

    // Abrir modal al hacer click en la tarjeta
    tourCards.forEach((card) => {
        const tourId = card.getAttribute("data-id");

        card.addEventListener("click", () => {
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

        // card.addEventListener("keydown", (e) => {
        //     if (e.key === "Enter" || e.key === " ") {
        //         e.preventDefault();
        //         const modal = document.getElementById(`modal-${tourId}`);
        //         if (modal) {
        //             modal.classList.add("open");
        //         }
        //     }
        // });
    });

    // Abrir modal al hacer click en el botón de contacto
    contactButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const tourId = btn.getAttribute("data-id");
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

        // btn.addEventListener("keydown", (e) => {
        //     if (e.key === "Enter" || e.key === " ") {
        //         e.preventDefault();
        //         const tourId = btn.getAttribute("data-id");
        //         const modal = document.getElementById(`modal-${tourId}`);
        //         if (modal) {
        //             modal.classList.add("open");
        //         }
        //     }
        // });
    });

    // Cerrar modales al hacer click fuera
    document.addEventListener("click", (e) => {
        const modals = document.querySelectorAll(".dmodal-overlay");
        modals.forEach((modal) => {
            if (e.target === modal) {
                modal.classList.remove("open");
            }
        });
    });

    // Cerrar modales con botón de cerrar
    const closeButtons = document.querySelectorAll(".dmodal-close");
    closeButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const modal = btn.closest(".dmodal-overlay");
            if (modal) {
                modal.classList.remove("open");
            }
        });
    });
</script>
