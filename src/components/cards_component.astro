---
import DestinationModal from "./destination_modal.astro";
import { nauticosTours, modalData } from "./data/tours/nauticos_data";
import { Image } from "astro:assets";
---

<div class="feature-cards">
    <div class="header-card">
        <svg
            id="icon-menu"
            xmlns="http://www.w3.org/2000/svg"
            width="45"
            height="45"
            fill="#1c5fa8"
            class="bi bi-person-walking"
            viewBox="0 0 16 16"
        >
            <path
                d="M9.5 1.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M6.44 3.752A.75.75 0 0 1 7 3.5h1.445c.742 0 1.32.643 1.243 1.38l-.43 4.083a1.8 1.8 0 0 1-.088.395l-.318.906.213.242a.8.8 0 0 1 .114.175l2 4.25a.75.75 0 1 1-1.357.638l-1.956-4.154-1.68-1.921A.75.75 0 0 1 6 8.96l.138-2.613-.435.489-.464 2.786a.75.75 0 1 1-1.48-.246l.5-3a.75.75 0 0 1 .18-.375l2-2.25Z"
            ></path>
            <path
                d="M6.25 11.745v-1.418l1.204 1.375.261.524a.8.8 0 0 1-.12.231l-2.5 3.25a.75.75 0 1 1-1.19-.914zm4.22-4.215-.494-.494.205-1.843.006-.067 1.124 1.124h1.44a.75.75 0 0 1 0 1.5H11a.75.75 0 0 1-.531-.22Z"
            ></path>
        </svg>
        <h2 class="card-title">Tours</h2>
        <p>Explora nuestra variedad de tours</p>
    </div>
    <br>
    <div class="card-product">
        <div class="subtitle">
            <span class="material-symbols-outlined icon-nauticos" aria-hidden="true">anchor</span>
            <h3>Nauticos</h3>
        </div>

        <p>
            Diviertete con nuestros multiples tours y experiencias nauticas en
            la laguna de Bacalar y sus alrededores
        </p>
        <div class="card-container">
            {
                nauticosTours.map((tour) => (
                    <button class="card-item" data-id={tour.id}>
                        <div class="img-card">
                            <Image
                                src={tour.image}
                                alt={tour.name}
                                width={500}
                                height={400}
                                quality="normal"
                                loading="lazy"
                            />
                        </div>
                        <div class="title-card">
                            <span class="material-symbols-outlined" aria-hidden="true">
                                {tour.icon}
                            </span>
                            <p>{tour.name}</p>
                        </div>
                        <div class="contend-card">
                            <p>{tour.description}</p>
                        </div>
                    </button>
                ))
            }
        </div>
        <div class="button-more">
            <a href="/tours/nauticos">Ver todos los tours náuticos</a>
        </div>
    </div>
</div>
<!-- Modales de Tours -->
{
    modalData.map((m) => (
        <DestinationModal
            id={m.id}
            title={m.title}
            images={m.images}
            text={m.text}
            schedule={m.schedule}
            price={m.price}
            rating={m.rating}
            duration={m.duration}
            capacity={m.capacity}
            ageRange={m.ageRange}
            includes={m.includes}
            nearby={m.nearby}
        />
    ))
}
<style>
    :global(*) {
        box-sizing: border-box;
    }

    /* 1. Utilidades y Agrupaciones Flexbox */

    .header-card,
    .subtitle,
    .title-card {
        display: flex;
        align-items: center;
    }

    /* 2. Configuración de Material Symbols */
    .material-symbols-outlined {
        font-weight: normal;
        font-style: normal;
        font-size: 40px;
        line-height: 1;
        letter-spacing: normal;
        text-transform: none;
        display: inline-block;
        white-space: nowrap;
        word-wrap: normal;
        direction: ltr;
        color: #1c5fa8;
        -webkit-font-smoothing: antialiased;
    }

    .icon-tours,
    .icon-nauticos {
        font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 48;
    }

    /* 3. Contenedores Principales */
    .feature-cards {
        position: relative;
        overflow: hidden;
        background:
            radial-gradient(circle at top left, rgba(28, 95, 168, 0.12), transparent 36%),
            linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
        padding: 32px 20px 22px;
        border-radius: 32px;
        border: 1px solid rgba(28, 95, 168, 0.08);
        box-shadow: 0 20px 60px rgba(24, 61, 111, 0.08);
    }

    .card-product {
        position: relative;
        background:
            linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, rgba(255, 255, 255, 0.15) 100%),
            linear-gradient(135deg, #c8dcfa 0%, #d8e7fb 48%, #c3d8f6 100%);
        padding: 22px 14px 14px;
        border-radius: 26px;
        border: 1px solid rgba(28, 95, 168, 0.12);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(8px);
    }

    .card-product p {
        padding-inline: 18px;
    }

    /* 4. Tipografía y Encabezados */
    .card-title {
        margin: 0;
        font-size: clamp(2rem, 4vw, 2.25rem);
        letter-spacing: -0.03em;
        padding-left: 10px;
    }

    .header-card p {
        position: relative;
        margin: 0;
        padding-left: 12px;
        color: rgba(28, 95, 168, 0.8);
    }

    .subtitle {
        gap: 0.4rem;
        padding-left: 20px;
        margin-bottom: 0.25rem;
    }

    .subtitle h3 {
        margin: 0;
        padding-left: 6px;
        font-size: clamp(1.15rem, 2vw, 1.45rem);
        letter-spacing: -0.02em;
    }

    /* 5. Contenedor de Tarjetas (Scroll) */
    .card-container {
        display: flex;
        gap: 1rem;
        overflow-x: auto;
        overflow-y: hidden;
        flex-wrap: nowrap;
        padding: 18px 4px 16px;
        scroll-snap-type: x proximity;
    }

    .card-container::-webkit-scrollbar {
        display: none;
    }

    /* 6. Estilos Individuales de las Tarjetas */
    .card-item {
        flex: 0 0 250px;
        background: linear-gradient(180deg, #ffffff 0%, #f7fbff 100%);
        border: none;
        border-radius: 22px;
        transition:
            transform 0.25s ease,
            box-shadow 0.25s ease,
            border-color 0.25s ease;
        padding: 0;
        cursor: pointer;
        overflow: hidden;
        text-align: left;
        color: inherit;
        scroll-snap-align: start;
        box-shadow: 0 10px 24px rgba(28, 95, 168, 0.12);
        border: 1px solid rgba(28, 95, 168, 0.08);
        display: flex;
        flex-direction: column;
    }

    .card-item:hover {
        transform: translateY(-4px);
        box-shadow: 0 18px 36px rgba(28, 95, 168, 0.18);
    }

    .card-item:focus-visible {
        outline: 3px solid rgba(28, 95, 168, 0.28);
        outline-offset: 3px;
    }

    .card-item img {
        width: 100%;
        min-width: 100%;
        height: 210px;
        aspect-ratio: 16/9;
        object-fit: cover;
        display: block;
    }

    .title-card {
        gap: 0.55rem;
        padding: 14px 16px 6px;
    }

    .title-card p {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        line-height: 1.2;
    }

    .contend-card {
        margin-top: 0;
        padding: 0 16px 16px;
    }

    .contend-card p {
        margin: 0;
        text-align: justify;
        color: rgba(18, 41, 77, 0.85);
        line-height: 1.55;
        font-size: 0.95rem;
        padding-inline: 0;
    }

    .button-more {
        padding-top: 8px;
    }

    .button-more a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.9rem 1.15rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        color: #ffffff;
        background: linear-gradient(135deg, #1c5fa8 0%, #11427a 100%);
        box-shadow: 0 12px 24px rgba(28, 95, 168, 0.24);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            filter 0.2s ease;
    }

    .button-more a:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 28px rgba(28, 95, 168, 0.3);
        filter: saturate(1.04);
    }

    .button-more a:focus-visible {
        outline: 3px solid rgba(28, 95, 168, 0.24);
        outline-offset: 4px;
    }

    @media (max-width: 768px) {
        .feature-cards {
            padding: 24px 14px 18px;
            border-radius: 26px;
        }

        .card-product {
            padding: 18px 12px 12px;
            border-radius: 22px;
        }

        .card-title {
            font-size: clamp(1.75rem, 8vw, 2rem);
        }

        .card-container {
            gap: 0.85rem;
            padding-inline: 2px;
        }

        .card-item {
            flex-basis: 84vw;
            max-width: 290px;
        }

        .card-item img {
            height: 190px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .card-item,
        .button-more a {
            transition: none;
        }

        .card-item:hover,
        .button-more a:hover {
            transform: none;
        }
    }
</style>
<script>
    const tourCards = document.querySelectorAll(".card-item");
    const contactButtons = document.querySelectorAll(".contact-btn");

    // Abrir modal al hacer click en la tarjeta
    tourCards.forEach((card) => {
        const tourId = card.getAttribute("data-id");

        card.addEventListener("click", () => {
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

        // card.addEventListener("keydown", (e) => {
        //     if (e.key === "Enter" || e.key === " ") {
        //         e.preventDefault();
        //         const modal = document.getElementById(`modal-${tourId}`);
        //         if (modal) {
        //             modal.classList.add("open");
        //         }
        //     }
        // });
    });

    // Abrir modal al hacer click en el botón de contacto
    contactButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            const tourId = btn.getAttribute("data-id");
            const modal = document.getElementById(`modal-${tourId}`);
            if (modal) {
                modal.classList.add("open");
            }
        });

        // btn.addEventListener("keydown", (e) => {
        //     if (e.key === "Enter" || e.key === " ") {
        //         e.preventDefault();
        //         const tourId = btn.getAttribute("data-id");
        //         const modal = document.getElementById(`modal-${tourId}`);
        //         if (modal) {
        //             modal.classList.add("open");
        //         }
        //     }
        // });
    });

    // Cerrar modales al hacer click fuera
    document.addEventListener("click", (e) => {
        const modals = document.querySelectorAll(".dmodal-overlay");
        modals.forEach((modal) => {
            if (e.target === modal) {
                modal.classList.remove("open");
            }
        });
    });

    // Cerrar modales con botón de cerrar
    const closeButtons = document.querySelectorAll(".dmodal-close");
    closeButtons.forEach((btn) => {
        btn.addEventListener("click", (e) => {
            const modal = btn.closest(".dmodal-overlay");
            if (modal) {
                modal.classList.remove("open");
            }
        });
    });
</script>
