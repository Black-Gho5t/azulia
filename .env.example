# ==========================================
# Firebase Client Configuration (Frontend)
# ==========================================
PUBLIC_FIREBASE_API_KEY=AIzaSy...
PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your-project-id
PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
PUBLIC_FIREBASE_APP_ID=1:123456789012:web:...
PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ==========================================
# Firebase Admin Configuration (Backend)
# ==========================================
# JSON string of your Firebase Service Account Private Key
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"..."}'

# ==========================================
# Admin & Site Configuration
# ==========================================
# Main superadmin email — used for initial setup and access gating
PUBLIC_MAIN_ADMIN_EMAIL=azulia.bacalar@gmail.com

# Destination email for admin notifications (optional, defaults to azulia.bacalar@gmail.com)
PUBLIC_ADMIN_EMAIL=azulia.bacalar@gmail.com

# Site URL used to build absolute links for emails and redirects
PUBLIC_SITE_URL=http://localhost:4321

# ==========================================
# EmailJS Configuration (Admin registration)
# ==========================================
# 1. Create free account at https://www.emailjs.com/
# 2. Go to "Email Services" → "Add New Service" → connect your email (Gmail, Outlook, etc.)
# 3. Copy the Service ID (looks like: service_abc123def)
# 4. Go to "Email Templates" → "Create New Template"
#    Variables disponibles: {{logo}}, {{admin_name}}, {{admin_email}}, {{confirm_link}}, {{subject}}, {{from_name}}
# 5. Copy the Template ID (looks like: template_abc123def)
# 6. Go to "Account" → "API Keys" → copy the Public Key
PUBLIC_EMAILJS_SERVICE_ID=service_abc123def
PUBLIC_EMAILJS_TEMPLATE_ID=template_abc123def
PUBLIC_EMAILJS_PUBLIC_KEY=abc_def123_ghi456
